# Copy this file to `.env.test` for local demo and E2E users.
# Never commit real `.env.test` values.

TEST_STUDENT_EMAIL=student@example.com
TEST_STUDENT_PASSWORD=change_me
TEST_TEACHER_EMAIL=teacher@example.com
TEST_TEACHER_PASSWORD=change_me
TEST_ADMIN_EMAIL=admin@example.com
TEST_ADMIN_PASSWORD=change_me

# Keep booking E2E tests from calling Google/Resend locally.
E2E_DISABLE_EXTERNAL_INTEGRATIONS=true

# Optional: `pnpm dev:demo` sets these automatically. Keep them false in normal
# local/E2E runs so demo code cannot leak into launch verification by accident.
DEMO_GUIDE_ENABLED=false
DEMO_GUIDE_LOGIN_ENABLED=false
