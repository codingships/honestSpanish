# Copy this file to `.env` for local development.
# Never commit real `.env*` files. Store real values in KeePassXC and in each
# provider's environment/secrets UI.

PUBLIC_APP_ENV=dev
PUBLIC_SITE_URL=http://localhost:4321

PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
# Required in staging/production; prevents build/runtime project mixing.
SUPABASE_EXPECTED_PROJECT_REF=your-project

# Optional operational-only connection string for applying SQL migrations.
# Do not expose this to client code.
SUPABASE_DB_URL=paste_supabase_pooler_connection_string

STRIPE_SECRET_KEY=paste_stripe_secret_key
PUBLIC_STRIPE_PUBLISHABLE_KEY=paste_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=paste_stripe_webhook_secret
# Required for deployed sync/checkout. The non-secret acct_ identifier must
# match the exact Stripe sandbox/account assigned to this environment.
STRIPE_EXPECTED_ACCOUNT_ID=acct_your_environment_account
# Explicit test/live config: payment method + invoices + cancel at period end;
# subscription plan changes must remain disabled.
STRIPE_PORTAL_CONFIGURATION_ID=bpc_your_environment_configuration
# Optional launch read-only guard. Comma-separated hosts accepted for enabled Stripe webhook endpoints.
# In staging, override with espanolhonesto-staging.alindev95.workers.dev.
STRIPE_EXPECTED_WEBHOOK_HOSTS=espanolhonesto.com
# Fail-closed. Set to true only when Alin explicitly decides to allow Stripe Checkout.
CHECKOUT_ENABLED=false
# Optional final-window runtime override. Keep absent/false until the exact Stripe mode and Worker are verified.
CHECKOUT_ENABLED_OVERRIDE=false

# Google Service Account
GOOGLE_SERVICE_ACCOUNT_EMAIL=service-account@your-project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="paste_google_service_account_private_key_with_escaped_newlines"

# Google Impersonation
GOOGLE_ADMIN_EMAIL=admin@example.com

# Google Drive IDs
GOOGLE_DRIVE_ROOT_FOLDER_ID=your_drive_root_folder_id
GOOGLE_TEMPLATE_DOC_ID=your_template_doc_id

# Resend
RESEND_API_KEY=paste_resend_api_key
EMAIL_FROM="Espanol Honesto <hola@example.com>"
RESEND_FROM_EMAIL="Espanol Honesto <hola@example.com>"
SUPPORT_ALERT_EMAIL=alejandro@espanolhonesto.com
# Fail closed unless explicitly enabled. Staging must use allowlist; live is
# accepted only when PUBLIC_APP_ENV=production.
EMAIL_DELIVERY_MODE=disabled
EMAIL_RECIPIENT_ALLOWLIST=
# Safe staging defaults. Production defaults are 80/day and 2400/month; values
# above the environment ceiling are clamped in code and rejected in SQL.
EMAIL_DAILY_RECIPIENT_LIMIT=10
EMAIL_MONTHLY_RECIPIENT_LIMIT=100

# Cron
CRON_SECRET=your_cron_secret

# Internal Cloudflare fulfillment Worker
FULFILLMENT_WORKER_URL=https://espanol-honesto-fulfillment-staging.your-account.workers.dev
INTERNAL_JOB_SECRET=your_shared_internal_service_secret
# Fail closed for standalone/local config; Wrangler staging/production active
# environments set this to active explicitly.
FULFILLMENT_RUNTIME_MODE=bootstrap

# Sentry
SENTRY_AUTH_TOKEN=your_sentry_auth_token
PUBLIC_SENTRY_DSN=https://public@example.ingest.sentry.io/project
SENTRY_ORG=your_sentry_org_slug
SENTRY_PROJECT=your_sentry_project_slug
# Local/dev runtime capture is off unless this is explicitly true.
SENTRY_CAPTURE_LOCAL=false
# Optional override. Local opt-in capture defaults to local-<NODE_ENV>; deployed environments use PUBLIC_APP_ENV.
SENTRY_ENVIRONMENT=
# Default 0: any unresolved launch-environment issue becomes a QA warning.
SENTRY_MAX_UNRESOLVED_ISSUES=0
# Set to true only for intentional local sourcemap uploads; CI enables uploads via CI=true.
SENTRY_UPLOAD_SOURCEMAPS=false

# Turnstile Widgets
PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key
TURNSTILE_SECRET_KEY=your_turnstile_secret_key

# Staging-only lifecycle smoke. Never point this harness at production.
# Do not commit real values. Map these to the three existing TEST_* accounts;
# they must equal EMAIL_RECIPIENT_ALLOWLIST. The smoke creates zero Auth users,
# resets no passwords and does not need access to the student inbox.
SMOKE_BASE_URL=https://espanolhonesto-staging.alindev95.workers.dev
SMOKE_EXTERNAL_WRITES_CONFIRMATION=writes-ok:espanolhonesto-staging.alindev95.workers.dev
SMOKE_ADMIN_EMAIL=
SMOKE_ADMIN_PASSWORD=change_me
SMOKE_TEACHER_EMAIL=
SMOKE_TEACHER_PASSWORD=change_me
SMOKE_STUDENT_EMAIL=
SMOKE_STUDENT_PASSWORD=change_me
SMOKE_COMPLETED_CHECKOUT_SESSION_ID=
SMOKE_BILLING_LIFECYCLE_MANUAL_CONFIRMATION=
STAGING_CHECKOUT_GATE_CONFIRMATION=
# Optional. Auth user scan limit for large Supabase Auth projects.
SMOKE_AUTH_USER_SCAN_MAX_PAGES=100
