{
  "name": "espanol-honesto",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@10.33.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": "10.33.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "10.33.0",
      "onFail": "error"
    }
  },
  "pnpm": {
    "overrides": {
      "@babel/core@<=7.29.0": ">=7.29.6",
      "@opentelemetry/core": "^2.8.0",
      "brace-expansion@>=2.0.0 <3.0.0": "2.1.4",
      "brace-expansion@>=4.0.0 <6.0.0": "5.0.9",
      "browserslist@>=4.0.0 <4.28.7": "4.28.7",
      "devalue@>=5.6.3 <=5.8.0": ">=5.8.1",
      "esbuild@>=0.27.3 <0.28.1": ">=0.28.1",
      "fast-uri@>=3.0.0 <4.0.0": "3.1.6",
      "fast-xml-builder@<=1.1.6": ">=1.1.7",
      "fast-xml-parser@<5.7.0": ">=5.7.0",
      "fflate@>=0.7.0 <0.8.0": "0.7.5",
      "js-yaml@>=4.0.0 <=4.1.1": "4.3.0",
      "js-yaml@>=5.0.0 <6.0.0": "5.2.2",
      "@keystatic/core>js-yaml": "5.2.2",
      "nanoid@>=3.0.0 <4.0.0": "3.3.18",
      "nanoid@>=5.0.0 <6.0.0": "5.1.16",
      "postcss@>=8.0.0 <9.0.0": "8.5.23",
      "postcss-selector-parser@>=6.0.0 <7.0.0": "6.1.3",
      "qs@<6.16.0": "6.16.0",
      "svgo@>=4.0.0 <5.0.0": "4.0.2",
      "undici@>=7.0.0 <7.18.2": ">=7.18.2",
      "undici@>=7.0.0 <7.24.0": ">=7.24.0",
      "undici@>=7.0.0 <7.28.0": ">=7.28.0",
      "undici@>=8.0.0 <8.9.0": "8.9.0",
      "uuid@<11.1.1": ">=11.1.1",
      "ws@>=8.0.0 <8.21.0": ">=8.21.0",
      "yaml@>=2.0.0 <2.8.3": ">=2.8.3"
    }
  },
  "scripts": {
    "preinstall": "node scripts/enforce-pnpm.cjs",
    "dev": "tsx scripts/dev/staging.ts",
    "env:staging:sync": "tsx scripts/dev/staging.ts --sync-only",
    "env:staging:prepare": "tsx scripts/dev/prepare-staging-secrets.ts",
    "dev:demo": "tsx scripts/demo/dev.ts",
    "build": "tsx scripts/dev/staging.ts --build",
    "build:staging:release": "tsx scripts/dev/build-staging-release.ts --build",
    "validate:staging-package": "tsx scripts/dev/validate-built-worker.ts --environment staging --dry-run",
    "fulfillment:dev": "node scripts/dev/fulfillment-worker.mjs dev",
    "fulfillment:validate": "node scripts/dev/fulfillment-worker.mjs validate",
    "fulfillment:typecheck": "pnpm --filter @espanol-honesto/fulfillment-worker typecheck",
    "db:seed:staging": "tsx scripts/prepare-e2e-data.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:coverage:html": "vitest run --coverage && start coverage/index.html",
    "test:e2e": "playwright test --project=public",
    "test:e2e:ui": "playwright test --project=public --ui",
    "test:e2e:debug": "playwright test --project=public --debug",
    "test:e2e:report": "playwright show-report",
    "test:e2e:firefox": "playwright test --project=public-firefox",
    "test:e2e:safari": "playwright test --project=public-webkit",
    "test:e2e:mobile": "playwright test --project=mobile",
    "test:e2e:all-browsers": "playwright test --project=public --project=public-firefox --project=public-webkit",
    "test:all": "vitest run && playwright test --project=public",
    "preflight:staging:integrations": "tsx scripts/smoke/staging-integrations.ts --preflight",
    "preflight:staging:checkout-v2": "tsx scripts/smoke/staging-checkout-v2.ts --preflight",
    "verify:staging:checkout-v2": "tsx scripts/smoke/staging-checkout-v2.ts --execute",
    "preflight:staging:teacher-ops": "tsx scripts/smoke/staging-teacher-ops.ts --preflight",
    "verify:staging:teacher-ops": "tsx scripts/smoke/staging-teacher-ops.ts --execute",
    "preflight:staging:campus-ops": "tsx scripts/smoke/staging-campus-ops.ts --preflight",
    "verify:staging:campus-ops": "tsx scripts/smoke/staging-campus-ops.ts --execute",
    "preflight:staging:session-expired": "tsx scripts/smoke/staging-session-expired.ts --preflight",
    "verify:staging:session-expired": "tsx scripts/smoke/staging-session-expired.ts --execute",
    "preflight:staging:sentry-synthetic": "tsx scripts/smoke/staging-sentry-synthetic.ts --preflight",
    "verify:staging:sentry-synthetic": "tsx scripts/smoke/staging-sentry-synthetic.ts --execute",
    "diagnose:capacity:local": "tsx scripts/diagnostics/local-capacity-rehearsal.ts",
    "performance:audit": "tsx scripts/ci/run-lighthouse.ts",
    "performance:summarize": "tsx scripts/ci/summarize-lighthouse.ts",
    "style:admin": "tsx scripts/style/check-admin-style-tokens.ts",
    "verify:staging-runtime": "tsx scripts/ci/verify-staging-runtime.ts",
    "secrets:check": "node scripts/check-secrets.cjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/markdoc": "2.0.9",
    "@astrojs/react": "6.0.5",
    "@astrojs/rss": "4.0.19",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/boldonse": "^5.3.0",
    "@fontsource/unbounded": "^5.2.8",
    "@googleapis/calendar": "^14.2.0",
    "@googleapis/docs": "^9.2.0",
    "@googleapis/drive": "^20.0.0",
    "@keystatic/astro": "6.0.0",
    "@keystatic/core": "^0.5.50",
    "@marsidev/react-turnstile": "^1.4.2",
    "@resvg/resvg-js": "^2.6.2",
    "@resvg/resvg-wasm": "^2.6.2",
    "@sentry/astro": "^10.39.0",
    "@sentry/cloudflare": "10.48.0",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.90.0",
    "astro": "7.3.1",
    "google-auth-library": "10.9.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "resend": "^6.7.0",
    "satori": "^0.19.2",
    "satori-html": "^0.3.2",
    "stripe": "^20.1.2",
    "typescript": "^5.9.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@astrojs/cloudflare": "14.3.0",
    "@axe-core/playwright": "^4.11.0",
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.57.0",
    "@tailwindcss/typography": "^0.5.19",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@types/node": "22.19.19",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.0.17",
    "autoprefixer": "^10.4.20",
    "dotenv": "^17.2.3",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "jsdom": "^27.4.0",
    "lighthouse": "13.4.1",
    "msw": "^2.12.7",
    "playwright": "^1.57.0",
    "postcss": "8.5.23",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.21.0",
    "typescript-eslint": "^8.53.0",
    "vite": "8.2.2",
    "vitest": "^4.0.17",
    "wrangler": "4.127.1"
  }
}
