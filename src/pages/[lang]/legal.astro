---
export const prerender = true;
import LegalLayout from '../../layouts/LegalLayout.astro';

export function getStaticPaths() {
    return [
        { params: { lang: 'es' } },
        { params: { lang: 'en' } },
        { params: { lang: 'ru' } },
    ];
}

const { lang } = Astro.params;

const content = {
    es: {
        title: 'Información legal',
        description: 'Documentos legales de Español Honesto',
        lastUpdated: 'Última actualización: 13 de enero de 2026',
        intro: 'Consulta los documentos legales vigentes antes de usar o contratar los servicios.',
        links: [
            {
                href: `/${lang}/legal/aviso-legal`,
                label: 'Aviso Legal',
                description: 'Datos identificativos, propiedad intelectual, condiciones de uso y jurisdicción.',
            },
            {
                href: `/${lang}/legal/privacidad`,
                label: 'Política de Privacidad',
                description: 'Tratamiento de datos personales, destinatarios, conservación y derechos RGPD.',
            },
            {
                href: `/${lang}/legal/cookies`,
                label: 'Política de Cookies',
                description: 'Cookies técnicas, preferencias y gestión desde el navegador.',
            },
        ],
    },
    en: {
        title: 'Legal information',
        description: 'Legal documents for Español Honesto',
        lastUpdated: 'Last updated: January 13, 2026',
        intro: 'Review the current legal documents before using or purchasing the services.',
        links: [
            {
                href: `/${lang}/legal/aviso-legal`,
                label: 'Legal Notice',
                description: 'Identification details, intellectual property, terms of use and jurisdiction.',
            },
            {
                href: `/${lang}/legal/privacidad`,
                label: 'Privacy Policy',
                description: 'Personal data processing, recipients, retention and GDPR rights.',
            },
            {
                href: `/${lang}/legal/cookies`,
                label: 'Cookie Policy',
                description: 'Technical cookies, preferences and browser management.',
            },
        ],
    },
    ru: {
        title: 'Правовая информация',
        description: 'Юридические документы Español Honesto',
        lastUpdated: 'Последнее обновление: 13 января 2026',
        intro: 'Ознакомьтесь с актуальными юридическими документами перед использованием или покупкой услуг.',
        links: [
            {
                href: `/${lang}/legal/aviso-legal`,
                label: 'Правовая информация',
                description: 'Идентификационные данные, интеллектуальная собственность, условия использования и юрисдикция.',
            },
            {
                href: `/${lang}/legal/privacidad`,
                label: 'Политика конфиденциальности',
                description: 'Обработка персональных данных, получатели, сроки хранения и права по GDPR.',
            },
            {
                href: `/${lang}/legal/cookies`,
                label: 'Политика cookies',
                description: 'Технические cookies, предпочтения и управление через браузер.',
            },
        ],
    },
};

const t = content[lang as keyof typeof content] || content.es;
---

<LegalLayout
    title={t.title}
    description={t.description}
    lastUpdated={t.lastUpdated}
    lang={lang!}
>
    <p>{t.intro}</p>

    <ul>
        {t.links.map((link) => (
            <li>
                <a href={link.href}><strong>{link.label}</strong></a>
                <br />
                {link.description}
            </li>
        ))}
    </ul>
</LegalLayout>
