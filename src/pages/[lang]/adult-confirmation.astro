---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { hasVerifiedAdultAccount } from '../../lib/adult-account';
import { LEGAL_POLICY_VERSION } from '../../lib/legal-policy';
import { createSupabaseServerClient } from '../../lib/supabase-server';

export const prerender = false;

const requestedLang = Astro.params.lang;
const lang = requestedLang === 'en' || requestedLang === 'ru' ? requestedLang : 'es';
const supabase = createSupabaseServerClient(Astro);
const { data: { user } } = await supabase.auth.getUser();

if (!user) {
    return Astro.redirect(`/${lang}/login`);
}

const { data: profile } = await supabase
    .from('profiles')
    .select('role, adult_confirmed, adult_confirmed_at, age_policy_version')
    .eq('id', user.id)
    .single();

if (!profile) {
    await supabase.auth.signOut({ scope: 'local' });
    return Astro.redirect(`/${lang}/login?error=adult-attestation-required`);
}

if (profile.role !== 'student' || hasVerifiedAdultAccount(profile)) {
    return Astro.redirect(`/api/auth/post-login?lang=${lang}`);
}

const copy = {
    es: {
        title: 'Confirmación de mayoría de edad',
        description: 'Español Honesto no acepta alumnos menores de edad.',
        explanation: 'Para acceder al campus debes confirmar expresamente que tienes al menos 18 años. Guardaremos la fecha y la versión de esta declaración en tu cuenta.',
        checkbox: 'Confirmo que tengo 18 años o más y que no soy menor de edad.',
        terms: 'Puedes consultar los Términos y la Política de Privacidad antes de continuar.',
        termsLink: 'Términos',
        privacyLink: 'Política de Privacidad',
        submit: 'CONFIRMAR Y ENTRAR',
        sending: 'GUARDANDO...',
        required: 'Debes marcar la confirmación para continuar.',
        error: 'No se pudo guardar la confirmación. Inténtalo de nuevo.',
    },
    en: {
        title: 'Adult age confirmation',
        description: 'Español Honesto does not accept underage students.',
        explanation: 'To access the campus, you must expressly confirm that you are at least 18. We will store the timestamp and policy version with your account.',
        checkbox: 'I confirm that I am 18 or over and am not underage.',
        terms: 'You can review the Terms and Privacy Policy before continuing.',
        termsLink: 'Terms',
        privacyLink: 'Privacy Policy',
        submit: 'CONFIRM AND ENTER',
        sending: 'SAVING...',
        required: 'You must check the confirmation before continuing.',
        error: 'We could not save your confirmation. Please try again.',
    },
    ru: {
        title: 'Подтверждение совершеннолетия',
        description: 'Español Honesto не принимает несовершеннолетних учеников.',
        explanation: 'Для доступа к личному кабинету нужно прямо подтвердить, что вам исполнилось 18 лет. Мы сохраним дату и версию этой декларации в вашей учётной записи.',
        checkbox: 'Подтверждаю, что мне исполнилось 18 лет и я не являюсь несовершеннолетним(ей).',
        terms: 'Перед продолжением можно ознакомиться с Условиями и Политикой конфиденциальности.',
        termsLink: 'Условия',
        privacyLink: 'Политика конфиденциальности',
        submit: 'ПОДТВЕРДИТЬ И ВОЙТИ',
        sending: 'СОХРАНЕНИЕ...',
        required: 'Для продолжения нужно отметить подтверждение.',
        error: 'Не удалось сохранить подтверждение. Повторите попытку.',
    },
}[lang];
---

<BaseLayout title={`${copy.title} | Español Honesto`} description={copy.description} lang={lang} noindex={true}>
    <main class="min-h-screen bg-[#E0F7FA] px-4 py-12 flex items-center justify-center">
        <section class="w-full max-w-xl border-2 border-[#006064] bg-white p-6 md:p-8 shadow-[6px_6px_0px_0px_#006064]">
            <p class="font-mono text-xs uppercase tracking-widest text-[#006064]">18+ · {LEGAL_POLICY_VERSION}</p>
            <h1 class="mt-2 font-display text-3xl uppercase text-[#006064]">{copy.title}</h1>
            <p class="mt-4 text-[#006064]/80 leading-7">{copy.description}</p>
            <p class="mt-3 text-sm text-[#006064] leading-6">{copy.explanation}</p>

            <form
                id="adult-confirmation-form"
                class="mt-6 space-y-5"
                data-adult-confirmation-copy={JSON.stringify({ lang, ...copy })}
            >
                <label class="flex items-start gap-3 border-2 border-[#006064] bg-[#E0F7FA] p-4 text-sm leading-6 text-[#006064]">
                    <input id="adult-confirmed" type="checkbox" class="mt-1 h-5 w-5" aria-required="true" />
                    <span>{copy.checkbox}</span>
                </label>

                <p class="text-xs leading-5 text-[#006064]">
                    {copy.terms}{' '}
                    <a class="font-bold underline" href={`/${lang}/legal/terminos`} target="_blank" rel="noopener noreferrer">{copy.termsLink}</a>
                    {' · '}
                    <a class="font-bold underline" href={`/${lang}/legal/privacidad`} target="_blank" rel="noopener noreferrer">{copy.privacyLink}</a>
                </p>

                <p id="adult-confirmation-status" class="min-h-5 text-sm font-bold text-red-700" role="alert" aria-live="polite"></p>

                <button id="adult-confirmation-submit" type="submit" class="w-full border-2 border-[#006064] bg-[#006064] px-4 py-3 font-bold uppercase text-white hover:bg-[#004d40] disabled:opacity-60">
                    {copy.submit}
                </button>
            </form>
        </section>
    </main>

    <script>
        const form = document.getElementById('adult-confirmation-form');
        const checkbox = document.getElementById('adult-confirmed');
        const submit = document.getElementById('adult-confirmation-submit');
        const status = document.getElementById('adult-confirmation-status');
        const pageCopy = JSON.parse(form?.dataset.adultConfirmationCopy || '{}');

        form?.addEventListener('submit', async (event) => {
            event.preventDefault();
            if (!(checkbox instanceof HTMLInputElement) || !checkbox.checked) {
                if (status) status.textContent = pageCopy.required || '';
                return;
            }

            if (submit instanceof HTMLButtonElement) {
                submit.disabled = true;
                submit.textContent = pageCopy.sending || '';
            }
            if (status) status.textContent = '';

            try {
                const response = await fetch('/api/auth/confirm-adult', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    credentials: 'same-origin',
                    body: JSON.stringify({ adultConfirmed: true }),
                });
                if (!response.ok) throw new Error('adult_confirmation_failed');
                window.location.assign(`/${pageCopy.lang || 'es'}/campus`);
            } catch {
                if (status) status.textContent = pageCopy.error || '';
                if (submit instanceof HTMLButtonElement) {
                    submit.disabled = false;
                    submit.textContent = pageCopy.submit || '';
                }
            }
        });
    </script>
</BaseLayout>
