---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ResetPasswordForm from '../../components/ResetPasswordForm.jsx';
import { getLangFromParam, useTranslations } from '../../i18n/utils';
import { sanitizeAuthReturnTo } from '../../lib/auth-return-to';

export const prerender = false;

const lang = getLangFromParam(Astro.params.lang);
const t = useTranslations(lang);
const returnTo = sanitizeAuthReturnTo(Astro.url.searchParams.get('returnTo'));

import { ui } from '../../i18n/translations';
const currentLangTranslations = ui[lang];
---

<BaseLayout 
    title={`${t('auth.resetPassword')} | Español Honesto`} 
    description={t('meta.description')} 
    lang={lang}
    noindex={true}
>
    <main id="main-content" class="min-h-screen bg-[#E0F7FA] flex items-center justify-center p-4">
        <ResetPasswordForm client:load lang={lang} translations={currentLangTranslations} returnTo={returnTo} />
    </main>
</BaseLayout>
