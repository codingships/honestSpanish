---
import CampusLayout from '../../../layouts/CampusLayout.astro';
import { getLangFromParam, useTranslations } from '../../../i18n/utils';
import { getPrivateProfile } from '../../../lib/profiles-private';
import { createSupabaseServerClient } from "../../../lib/supabase-server";
import NextClassCard from '../../../components/calendar/NextClassCard';

export const prerender = false;

type AssignedTeacher = {
    id: string;
    full_name: string | null;
    email: string | null;
};

type OnboardingItem = {
    label: string;
    done: boolean;
    cta: string;
    href?: string;
    detail?: string | null;
    alwaysShowAction?: boolean;
};

type DashboardSession = {
    id: string;
    scheduled_at: string;
    duration_minutes: number;
    status: string;
    meet_link: string | null;
    drive_doc_url: string | null;
    teacher: { full_name: string | null; email: string } | null;
};

const lang = getLangFromParam(Astro.params.lang);
const t = useTranslations(lang);

const supabase = createSupabaseServerClient(Astro);
const { data: { user } } = await supabase.auth.getUser();

if (!user) {
    return Astro.redirect(`/${lang}/login`);
}

let profile = null;
const { data: profileData } = await supabase
  .from('profiles')
  .select('id, email, full_name, role, preferred_language, phone, timezone')
  .eq('id', user.id)
  .single();

if (profileData) profile = profileData;
const profilePrivate = profile ? await getPrivateProfile(profile.id) : null;
const driveFolderUrl = profilePrivate?.drive_folder_url
    || (profilePrivate?.drive_folder_id ? `https://drive.google.com/drive/folders/${profilePrivate.drive_folder_id}` : null);

// Strictly prevent Teachers & Admins from entering the Student Dashboard
if (profile?.role === 'admin') {
    return Astro.redirect(`/${lang}/campus/admin`);
} else if (profile?.role === 'teacher') {
    return Astro.redirect(`/${lang}/campus/teacher`);
}

// 2. Fetch Active Subscription
let subscription = null;
try {
  const { data: subData } = await supabase
    .from('subscriptions')
    .select(`
      *,
      packages (
        name,
        display_name,
        sessions_per_month
      )
    `)
    .eq('student_id', user.id)
    .eq('status', 'active')
    .gte('ends_at', new Date().toISOString())
    .order('created_at', { ascending: false })
    .limit(1)
    .single();

  if (subData) subscription = subData;
} catch (e) {
  // Fail gracefully
}

// 3. Fetch Next Scheduled Session
let nextSession: DashboardSession | null = null;
try {
    const { data: sessionData } = await supabase
        .from('sessions')
        .select(`
            *,
            teacher:profiles!sessions_teacher_id_fkey(id, full_name, email)
        `)
        .eq('student_id', user.id)
        .eq('status', 'scheduled')
        .gte('scheduled_at', new Date().toISOString())
        .order('scheduled_at', { ascending: true })
        .limit(1)
        .single();

    if (sessionData?.scheduled_at) {
        nextSession = {
            id: sessionData.id,
            scheduled_at: sessionData.scheduled_at,
            duration_minutes: sessionData.duration_minutes ?? 50,
            status: sessionData.status ?? 'scheduled',
            meet_link: sessionData.meet_link,
            drive_doc_url: sessionData.drive_doc_url,
            teacher: sessionData.teacher,
        };
    }
} catch (e) {
    // No upcoming session
}

let assignedTeacher: AssignedTeacher | null = null;
try {
    const { data: assignmentData } = await supabase
        .from('student_teachers')
        .select(`
            teacher:profiles!student_teachers_teacher_id_fkey(id, full_name, email)
        `)
        .eq('student_id', user.id)
        .order('is_primary', { ascending: false })
        .order('assigned_at', { ascending: false })
        .limit(1)
        .maybeSingle();

    const assignment = assignmentData as { teacher?: AssignedTeacher | AssignedTeacher[] | null } | null;
    const teacher = Array.isArray(assignment?.teacher)
        ? assignment.teacher[0]
        : assignment?.teacher;

    if (teacher) {
        assignedTeacher = {
            id: teacher.id,
            full_name: teacher.full_name ?? null,
            email: teacher.email ?? null,
        };
    }
} catch (e) {
    // Teacher assignment is useful for onboarding, but the dashboard must still load.
}

const formatDate = (dateString: string) => {
    if (!dateString) return '';
    return new Date(dateString).toLocaleDateString(lang === 'es' ? 'es-ES' : (lang === 'ru' ? 'ru-RU' : 'en-US'), {
        year: 'numeric',
        month: 'long',
        day: 'numeric'
    });
};

const packageDisplayName = subscription?.packages?.display_name;
const packageName = packageDisplayName && typeof packageDisplayName === 'object' && !Array.isArray(packageDisplayName)
    ? (typeof packageDisplayName[lang] === 'string'
        ? packageDisplayName[lang]
        : typeof packageDisplayName.es === 'string'
            ? packageDisplayName.es
            : subscription?.packages?.name ?? 'Plan')
    : subscription?.packages?.name ?? 'Plan';

const sessionsTotal = subscription?.sessions_total || subscription?.packages?.sessions_per_month || 8;
const sessionsUsed = subscription?.sessions_used || 0;
const sessionsPercentage = Math.min(100, Math.round((sessionsUsed / sessionsTotal) * 100));

// Traducciones para NextClassCard
const nextClassTranslations = {
    nextClass: t('campus.dashboard.nextClass'),
    noClasses: t('campus.dashboard.noClasses'),
    joinClass: t('campus.student.classes.joinClass'),
    with: t('campus.student.classes.with'),
    in: t('campus.student.classes.in'),
    viewAll: t('campus.student.classes.viewAll'),
    unassigned: t('campus.student.classes.unassigned'),
    now: t('campus.student.classes.now'),
    viewDocument: t('campus.student.classes.viewDocument'),
};

const onboardingCopy = {
    es: {
        title: 'Puesta en marcha',
        subtitle: 'Estos son los pasos mínimos para que tu campus esté listo para trabajar.',
        ready: 'Listo',
        pending: 'Pendiente',
        action: 'Acción',
        profile: 'Perfil básico completo',
        plan: 'Plan activo',
        teacher: 'Profesor asignado',
        drive: 'Carpeta Drive preparada',
        firstClass: 'Primera clase programada',
        classAssets: 'Meet y documento de clase',
        support: 'Soporte disponible',
        completeProfile: 'Completar perfil',
        requestPlace: 'Solicitar plaza',
        viewClasses: 'Ver clases',
        openSupport: 'Abrir soporte',
        manualScheduling: 'Coordinamos disponibilidad manualmente',
        assigningTeacher: 'Lo asignamos antes de coordinar la primera clase',
        waiting: 'Se prepara automáticamente',
    },
    en: {
        title: 'Getting started',
        subtitle: 'These are the minimum steps for your campus to be ready for work.',
        ready: 'Ready',
        pending: 'Pending',
        action: 'Action',
        profile: 'Basic profile complete',
        plan: 'Active plan',
        teacher: 'Teacher assigned',
        drive: 'Drive folder prepared',
        firstClass: 'First class scheduled',
        classAssets: 'Meet and class document',
        support: 'Support available',
        completeProfile: 'Complete profile',
        requestPlace: 'Apply for a place',
        viewClasses: 'View classes',
        openSupport: 'Open support',
        manualScheduling: 'We coordinate availability manually',
        assigningTeacher: 'Assigned before we coordinate the first class',
        waiting: 'Prepared automatically',
    },
    ru: {
        title: 'Начало работы',
        subtitle: 'Минимальные шаги, чтобы кампус был готов к работе.',
        ready: 'Готово',
        pending: 'Ожидает',
        action: 'Действие',
        profile: 'Базовый профиль заполнен',
        plan: 'Активный план',
        teacher: 'Преподаватель назначен',
        drive: 'Папка Drive подготовлена',
        firstClass: 'Первое занятие запланировано',
        classAssets: 'Meet и документ занятия',
        support: 'Поддержка доступна',
        completeProfile: 'Заполнить профиль',
        requestPlace: 'Оставить заявку',
        viewClasses: 'Мои занятия',
        openSupport: 'Открыть поддержку',
        manualScheduling: 'Мы согласуем время вручную',
        assigningTeacher: 'Назначаем до согласования первого занятия',
        waiting: 'Готовится автоматически',
    },
}[lang as 'es' | 'en' | 'ru'];

const profileComplete = Boolean(profile?.full_name && profile?.preferred_language && profile?.timezone);
const hasPlan = Boolean(subscription);
const teacherForOnboarding = assignedTeacher ?? nextSession?.teacher ?? null;
const hasTeacher = Boolean(teacherForOnboarding);
const hasDrive = Boolean(driveFolderUrl);
const hasFirstClass = Boolean(nextSession);
const hasClassAssets = Boolean(nextSession?.meet_link && nextSession?.drive_doc_url);
const onboardingItems: OnboardingItem[] = [
    {
        label: onboardingCopy.profile,
        done: profileComplete,
        href: `/${lang}/campus/account`,
        cta: onboardingCopy.completeProfile,
    },
    {
        label: onboardingCopy.plan,
        done: hasPlan,
        href: `/${lang}#contacto`,
        cta: onboardingCopy.requestPlace,
    },
    {
        label: onboardingCopy.teacher,
        done: hasTeacher,
        detail: teacherForOnboarding?.full_name || teacherForOnboarding?.email || null,
        cta: onboardingCopy.assigningTeacher,
    },
    {
        label: onboardingCopy.drive,
        done: hasDrive,
        cta: onboardingCopy.waiting,
    },
    {
        label: onboardingCopy.firstClass,
        done: hasFirstClass,
        href: hasFirstClass ? `/${lang}/campus/classes` : undefined,
        cta: hasFirstClass ? onboardingCopy.viewClasses : onboardingCopy.manualScheduling,
    },
    {
        label: onboardingCopy.classAssets,
        done: hasClassAssets,
        href: `/${lang}/campus/classes`,
        cta: hasFirstClass ? onboardingCopy.waiting : onboardingCopy.viewClasses,
    },
    {
        label: onboardingCopy.support,
        done: true,
        href: `/${lang}/campus/support`,
        cta: onboardingCopy.openSupport,
        alwaysShowAction: true,
    },
];
---

<CampusLayout 
    title={t('campus.dashboard.title')}
    user={{ ...user, ...profile }}
    lang={lang}
>
    <!-- Page Header -->
    <div class="mb-8">
         <h1 class="font-display text-4xl text-[#006064] uppercase">{t('campus.dashboard.title')}</h1>
         <p class="font-mono text-[#006064]/60">{t('campus.dashboard.welcomeBack')}, {profile?.full_name || user.email}</p>
    </div>

    <section class="mb-8 border-2 border-[#006064] bg-white p-5 shadow-[4px_4px_0px_0px_#006064]">
        <div class="mb-4 flex flex-col gap-2 md:flex-row md:items-end md:justify-between">
            <div>
                <h2 class="font-display text-2xl text-[#006064] uppercase">{onboardingCopy.title}</h2>
                <p class="font-mono text-xs text-[#006064]/70">{onboardingCopy.subtitle}</p>
            </div>
            <span class="font-mono text-xs text-[#006064]/70">
                {onboardingItems.filter((item) => item.done).length}/{onboardingItems.length}
            </span>
        </div>
        <div class="grid grid-cols-1 gap-3 md:grid-cols-2 xl:grid-cols-4">
            {onboardingItems.map((item) => (
                <div class={`border-2 p-3 ${item.done ? 'border-green-600 bg-green-50 text-green-800' : 'border-[#006064]/30 bg-[#E0F7FA] text-[#006064]'}`}>
                    <div class="flex items-start justify-between gap-3">
                        <p class="text-sm font-bold leading-5">{item.label}</p>
                        <span class={`shrink-0 px-2 py-1 text-[10px] font-bold uppercase ${item.done ? 'bg-green-100 text-green-800' : 'bg-white text-[#006064]'}`}>
                            {item.done ? onboardingCopy.ready : (item.href ? onboardingCopy.action : onboardingCopy.pending)}
                        </span>
                    </div>
                    {item.detail && (
                        <p class="mt-2 text-xs font-mono opacity-80">{item.detail}</p>
                    )}
                    {(!item.done || item.alwaysShowAction) && (
                        item.href ? (
                            <a href={item.href} class="mt-3 inline-block text-xs font-bold uppercase underline">
                                {item.cta}
                            </a>
                        ) : (
                            <p class="mt-3 text-xs font-mono opacity-80">{item.cta}</p>
                        )
                    )}
                </div>
            ))}
        </div>
    </section>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-2 xl:grid-cols-4 gap-6">
         
         <!-- CARD 1: TU PLAN -->
         <div class="bg-white p-6 border-2 border-[#006064] shadow-[4px_4px_0px_0px_#006064] flex flex-col justify-between h-full">
             <div>
                 <div class="flex items-center justify-between mb-4">
                     <h3 class="font-bold text-lg text-[#006064] uppercase tracking-wide">{t('campus.dashboard.yourPlan')}</h3>
                     <span class="text-2xl">🎟️</span>
                 </div>
                 
                 {subscription ? (
                     <div>
                         <p class="font-display text-2xl text-[#006064] mb-1">{packageName}</p>
                         <div class="flex items-center gap-2 mb-4">
                             <span class="px-2 py-0.5 bg-green-100 text-green-800 text-xs font-bold uppercase rounded border border-green-200">{t('campus.dashboard.active')}</span>
                             <span class="text-xs text-[#006064]/60">{t('campus.dashboard.until')} {formatDate(subscription.ends_at)}</span>
                         </div>
                     </div>
                 ) : (
                     <div class="mb-4">
                         <p class="text-[#006064]/70 italic">{t('campus.dashboard.noPlan')}</p>
                     </div>
                 )}
             </div>

             <div>
                 {subscription ? (
                       <button id="manage-sub-btn" class="w-full py-2 bg-[#E0F7FA] text-[#006064] text-xs font-bold uppercase border border-[#006064] hover:bg-[#006064] hover:text-white transition-colors">
                           {t('campus.dashboard.manageSub')}
                       </button>
                 ) : (
                      <a href={`/${lang}#contacto`} class="block w-full text-center py-2 bg-[#006064] text-white text-xs font-bold uppercase border border-[#006064] hover:bg-[#004d40] transition-colors">
                          {onboardingCopy.requestPlace}
                      </a>
                 )}
             </div>
         </div>

         <!-- CARD 2: SESIONES -->
         <div class="bg-white p-6 border-2 border-[#006064] shadow-[4px_4px_0px_0px_#006064] flex flex-col justify-between h-full">
             <div class="flex items-center justify-between mb-4">
                 <h3 class="font-bold text-lg text-[#006064] uppercase tracking-wide">{t('campus.dashboard.sessions')}</h3>
                 <span class="text-2xl">📊</span>
             </div>

             {subscription ? (
                <div>
                    <div class="flex items-end gap-2 mb-2">
                         <span class="font-display text-4xl text-[#006064]">{sessionsUsed}</span>
                         <span class="text-lg text-[#006064]/50 font-bold mb-1">/ {sessionsTotal}</span>
                    </div>
                    <p class="text-xs text-[#006064]/60 uppercase font-bold mb-4">{t('campus.dashboard.sessionsUsed')}</p>
                    
                    <div class="h-3 w-full bg-[#E0F7FA] border border-[#006064]/20 rounded-full overflow-hidden">
                        <div style={{ width: `${sessionsPercentage}%` }} class="h-full bg-[#006064]"></div>
                    </div>
                </div>
             ) : (
                <div class="flex-1 flex items-center justify-center">
                    <p class="text-4xl text-[#006064]/20 font-display">—</p>
                </div>
             )}
         </div>

         <!-- CARD 3: PROXIMA CLASE (Ahora funcional) -->
         <NextClassCard 
            client:load
            session={nextSession}
            lang={lang}
            translations={nextClassTranslations}
         />

         <!-- CARD 4: DRIVE -->
         <div class="bg-white p-6 border-2 border-[#006064] shadow-[4px_4px_0px_0px_#006064] flex flex-col justify-between h-full">
             <div>
                 <div class="flex items-center justify-between mb-4">
                     <h3 class="font-bold text-lg text-[#006064] uppercase tracking-wide">Drive</h3>
                     <span class="text-2xl">📂</span>
                 </div>
                 <p class="text-sm text-[#006064]/70 mb-4">{t('campus.dashboard.driveFolder')}</p>
             </div>

             <div>
                 {driveFolderUrl ? (
                     <a href={driveFolderUrl} target="_blank" rel="noopener noreferrer" class="flex items-center justify-center w-full py-2 bg-[#E0F7FA] text-[#006064] text-xs font-bold uppercase border border-[#006064] hover:bg-[#006064] hover:text-white transition-colors gap-2">
                         <span>🔗</span> {t('campus.dashboard.openFolder')}
                     </a>
                 ) : (
                     <div class="w-full py-2 bg-[#E0F7FA] text-[#006064] text-xs font-bold uppercase border border-[#006064] text-center cursor-not-allowed">
                         {t('campus.dashboard.folderPending')}
                     </div>
                 )}
             </div>
         </div>

    </div>
</CampusLayout>

<script>
    import { openBillingPortal } from '../../../lib/billing-portal-client';

    // Stripe Customer Portal — manage subscription
    const manageSubBtn = document.getElementById('manage-sub-btn') as HTMLButtonElement | null;
    manageSubBtn?.addEventListener('click', () => {
        void openBillingPortal({ button: manageSubBtn }).catch((error) => {
            console.error('Error opening Stripe portal:', error);
        });
    });
</script>
