---
import CampusLayout from '../../../layouts/CampusLayout.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CampusLoadError from '../../../components/campus/CampusLoadError.astro';
import { getLangFromParam, useTranslations } from '../../../i18n/utils';
import {
    reportCampusReadError,
    resolveOptionalCampusQuery,
    resolveRequiredCampusQuery,
} from '../../../lib/campus-load-state';
import { isCheckoutEnabled } from '../../../lib/checkout-enabled';
import {
    loadCheckoutV2ProgressForSubscription,
    resolveCheckoutV2AcademicProgress,
    type CheckoutV2CycleProgress,
} from '../../../lib/checkout-v2-progress';
import { getPrivateProfile } from '../../../lib/profiles-private';
import { createSupabaseAdminClient } from '../../../lib/supabase-admin';
import { createSupabaseServerClient } from "../../../lib/supabase-server";
import NextClassCard from '../../../components/calendar/NextClassCard';
import ProgressBar from '../../../components/ProgressBar.astro';

export const prerender = false;

type AssignedTeacher = {
    id: string;
    full_name: string | null;
    email: string | null;
};

type OnboardingItem = {
    label: string;
    status: 'ready' | 'pending' | 'unavailable';
    cta: string;
    href?: string;
    detail?: string | null;
    alwaysShowAction?: boolean;
};

type DashboardSession = {
    id: string;
    scheduled_at: string;
    duration_minutes: number;
    status: string;
    meet_link: string | null;
    drive_doc_url: string | null;
    teacher: { full_name: string | null; email: string } | null;
};

const lang = getLangFromParam(Astro.params.lang);
const t = useTranslations(lang);
const purchaseOfferHref = isCheckoutEnabled(Astro) ? `/${lang}/#planes` : `/${lang}/#contacto`;

const supabase = createSupabaseServerClient(Astro);
const { data: { user }, error: authError } = await supabase.auth.getUser();

if (!user && !authError) {
    return Astro.redirect(`/${lang}/login`);
}

if (authError) {
    reportCampusReadError('student_dashboard.auth', authError);
}

const profileResult = user
    ? await supabase
        .from('profiles')
        .select('id, email, full_name, role, preferred_language, phone, timezone')
        .eq('id', user.id)
        .maybeSingle()
    : { data: null, error: authError };
const profileState = resolveRequiredCampusQuery(profileResult);
const profile = profileState.status === 'ready' ? profileState.data : null;
const roleVerified = profile !== null && ['student', 'teacher', 'admin'].includes(profile.role ?? '');
const accessUnavailable = Boolean(authError) || profileState.status !== 'ready' || !roleVerified;

if (profileState.status === 'error') {
    reportCampusReadError('student_dashboard.profile', profileState.error);
} else if (profileState.status === 'empty' && user) {
    reportCampusReadError('student_dashboard.profile', { code: 'PROFILE_MISSING' });
} else if (!roleVerified) {
    reportCampusReadError('student_dashboard.profile', { code: 'PROFILE_ROLE_INVALID' });
}

// Strictly prevent Teachers & Admins from entering the Student Dashboard
if (!accessUnavailable && profile?.role === 'admin') {
    return Astro.redirect(`/${lang}/campus/admin`);
} else if (!accessUnavailable && profile?.role === 'teacher') {
    return Astro.redirect(`/${lang}/campus/teacher`);
}

let subscriptionState = resolveOptionalCampusQuery<any>({ data: null, error: null });
let nextSessionRowState = resolveOptionalCampusQuery<any>({ data: null, error: null });
let assignmentState = resolveOptionalCampusQuery<any>({ data: null, error: null });
type PrivateProfile = NonNullable<Awaited<ReturnType<typeof getPrivateProfile>>>;
let profilePrivateState = resolveOptionalCampusQuery<PrivateProfile>({ data: null, error: null });
let cycleProgressState = resolveOptionalCampusQuery<CheckoutV2CycleProgress>({ data: null, error: null });

if (!accessUnavailable && user) {
    const nowIso = new Date().toISOString();
    const [subscriptionResult, sessionResult, assignmentResult, privateResult] = await Promise.all([
        supabase
            .from('subscriptions')
            .select(`
                *,
                packages (
                    name,
                    display_name,
                    sessions_per_month
                )
            `)
            .eq('student_id', user.id)
            .eq('status', 'active')
            .gte('ends_at', nowIso)
            .order('created_at', { ascending: false })
            .limit(1)
            .maybeSingle(),
        supabase
            .from('sessions')
            .select(`
                *,
                teacher:profiles!sessions_teacher_id_fkey(id, full_name, email)
            `)
            .eq('student_id', user.id)
            .eq('status', 'scheduled')
            .gte('scheduled_at', nowIso)
            .order('scheduled_at', { ascending: true })
            .limit(1)
            .maybeSingle(),
        supabase
            .from('student_teachers')
            .select(`
                teacher:profiles!student_teachers_teacher_id_fkey(id, full_name, email)
            `)
            .eq('student_id', user.id)
            .order('is_primary', { ascending: false })
            .order('assigned_at', { ascending: false })
            .limit(1)
            .maybeSingle(),
        getPrivateProfile(user.id)
            .then((data) => ({ data, error: null }))
            .catch((error: unknown) => ({ data: null, error })),
    ]);

    subscriptionState = resolveOptionalCampusQuery(subscriptionResult);
    nextSessionRowState = resolveOptionalCampusQuery(sessionResult);
    assignmentState = resolveOptionalCampusQuery(assignmentResult);
    profilePrivateState = resolveOptionalCampusQuery(privateResult);
}

const subscriptionForProgress = subscriptionState.status === 'ready'
    ? subscriptionState.data
    : null;
if (subscriptionForProgress?.contract_schema_version === 2) {
    try {
        const progress = await loadCheckoutV2ProgressForSubscription(
            createSupabaseAdminClient(),
            subscriptionForProgress.id,
        );
        cycleProgressState = progress
            ? resolveRequiredCampusQuery<CheckoutV2CycleProgress>({ data: progress, error: null })
            : resolveRequiredCampusQuery<CheckoutV2CycleProgress>({
                data: null,
                error: { code: 'CHECKOUT_V2_PROGRESS_MISSING' },
            });
    } catch (error) {
        cycleProgressState = resolveRequiredCampusQuery<CheckoutV2CycleProgress>({
            data: null,
            error,
        });
    }
}

for (const [surface, state] of [
    ['student_dashboard.subscription', subscriptionState],
    ['student_dashboard.cycle_progress', cycleProgressState],
    ['student_dashboard.next_session', nextSessionRowState],
    ['student_dashboard.assignment', assignmentState],
    ['student_dashboard.drive', profilePrivateState],
] as const) {
    if (state.status === 'error') {
        reportCampusReadError(surface, state.error);
    }
}

if (
    accessUnavailable
    || subscriptionState.status === 'error'
    || cycleProgressState.status === 'error'
    || nextSessionRowState.status === 'error'
    || assignmentState.status === 'error'
    || profilePrivateState.status === 'error'
) {
    Astro.response.status = 503;
}

const subscription = subscriptionState.status === 'ready' ? subscriptionState.data : null;
const cycleProgress = cycleProgressState.status === 'ready' ? cycleProgressState.data : null;
const cycleProgressPresentation = subscription
    ? resolveCheckoutV2AcademicProgress(subscription.contract_schema_version, cycleProgress)
    : null;
const cycleProgressTotals = cycleProgressPresentation?.state === 'ready'
    ? cycleProgressPresentation
    : null;
const cycleProgressInconsistent = cycleProgressState.status !== 'error'
    && (
        cycleProgressPresentation?.state === 'missing'
        || cycleProgressPresentation?.state === 'inconsistent'
    );

if (cycleProgressInconsistent) {
    reportCampusReadError('student_dashboard.cycle_progress', {
        code: 'CHECKOUT_V2_PROGRESS_INCONSISTENT',
    });
    Astro.response.status = 503;
}

const profilePrivate = profilePrivateState.status === 'ready' ? profilePrivateState.data : null;
const driveFolderUrl = profilePrivate?.drive_folder_url
    || (profilePrivate?.drive_folder_id ? `https://drive.google.com/drive/folders/${profilePrivate.drive_folder_id}` : null);

let nextSession: DashboardSession | null = null;
const sessionData = nextSessionRowState.status === 'ready' ? nextSessionRowState.data : null;
if (sessionData?.scheduled_at) {
    nextSession = {
        id: sessionData.id,
        scheduled_at: sessionData.scheduled_at,
        duration_minutes: sessionData.duration_minutes ?? 50,
        status: sessionData.status ?? 'scheduled',
        meet_link: sessionData.meet_link,
        drive_doc_url: sessionData.drive_doc_url,
        teacher: sessionData.teacher,
    };
}

let assignedTeacher: AssignedTeacher | null = null;
const assignmentData = assignmentState.status === 'ready' ? assignmentState.data : null;
const assignment = assignmentData as { teacher?: AssignedTeacher | AssignedTeacher[] | null } | null;
const teacher = Array.isArray(assignment?.teacher)
    ? assignment.teacher[0]
    : assignment?.teacher;

if (teacher) {
    assignedTeacher = {
        id: teacher.id,
        full_name: teacher.full_name ?? null,
        email: teacher.email ?? null,
    };
}

const formatDate = (dateString: string) => {
    if (!dateString) return '';
    return new Date(dateString).toLocaleDateString(lang === 'es' ? 'es-ES' : (lang === 'ru' ? 'ru-RU' : 'en-US'), {
        year: 'numeric',
        month: 'long',
        day: 'numeric'
    });
};

const packageDisplayName = subscription?.packages?.display_name;
const packageName = packageDisplayName && typeof packageDisplayName === 'object' && !Array.isArray(packageDisplayName)
    ? (typeof packageDisplayName[lang] === 'string'
        ? packageDisplayName[lang]
        : typeof packageDisplayName.es === 'string'
            ? packageDisplayName.es
            : subscription?.packages?.name ?? 'Plan')
    : subscription?.packages?.name ?? 'Plan';

// Traducciones para NextClassCard
const nextClassTranslations = {
    nextClass: t('campus.dashboard.nextClass'),
    noClasses: t('campus.dashboard.noClasses'),
    joinClass: t('campus.student.classes.joinClass'),
    with: t('campus.student.classes.with'),
    in: t('campus.student.classes.in'),
    viewAll: t('campus.student.classes.viewAll'),
    unassigned: t('campus.student.classes.unassigned'),
    now: t('campus.student.classes.now'),
    viewDocument: t('campus.student.classes.viewDocument'),
};

const onboardingCopy = {
    es: {
        title: 'Puesta en marcha',
        subtitle: 'Estos son los pasos mínimos para que tu campus esté listo para trabajar.',
        ready: 'Listo',
        pending: 'Pendiente',
        action: 'Acción',
        profile: 'Perfil básico completo',
        plan: 'Plan activo',
        teacher: 'Profesor de tu plaza',
        drive: 'Carpeta Drive preparada',
        firstClass: 'Fechas de tu plaza',
        classAssets: 'Meet y documento de clase',
        support: 'Soporte disponible',
        completeProfile: 'Completar perfil',
        viewPlaces: 'Ver plazas',
        contact: 'Hacer una consulta',
        viewClasses: 'Ver clases',
        openSupport: 'Abrir soporte',
        schedulePending: 'Las fechas se muestran desde la plaza elegida',
        teacherPending: 'El profesor se muestra desde la plaza elegida',
        waiting: 'Se prepara automáticamente',
    },
    en: {
        title: 'Getting started',
        subtitle: 'These are the minimum steps for your campus to be ready for work.',
        ready: 'Ready',
        pending: 'Pending',
        action: 'Action',
        profile: 'Basic profile complete',
        plan: 'Active plan',
        teacher: 'Teacher for your place',
        drive: 'Drive folder prepared',
        firstClass: 'Dates for your place',
        classAssets: 'Meet and class document',
        support: 'Support available',
        completeProfile: 'Complete profile',
        viewPlaces: 'View places',
        contact: 'Ask a question',
        viewClasses: 'View classes',
        openSupport: 'Open support',
        schedulePending: 'Your dates are shown with the place you choose',
        teacherPending: 'Your teacher is shown with the place you choose',
        waiting: 'Prepared automatically',
    },
    ru: {
        title: 'Начало работы',
        subtitle: 'Минимальные шаги, чтобы кампус был готов к работе.',
        ready: 'Готово',
        pending: 'Ожидает',
        action: 'Действие',
        profile: 'Базовый профиль заполнен',
        plan: 'Активный план',
        teacher: 'Преподаватель выбранного места',
        drive: 'Папка Drive подготовлена',
        firstClass: 'Даты выбранного места',
        classAssets: 'Meet и документ занятия',
        support: 'Поддержка доступна',
        completeProfile: 'Заполнить профиль',
        viewPlaces: 'Посмотреть места',
        contact: 'Задать вопрос',
        viewClasses: 'Мои занятия',
        openSupport: 'Открыть поддержку',
        schedulePending: 'Даты указаны в выбранном месте',
        teacherPending: 'Преподаватель указан в выбранном месте',
        waiting: 'Готовится автоматически',
    },
}[lang as 'es' | 'en' | 'ru'];

const profileComplete = Boolean(profile?.full_name && profile?.preferred_language && profile?.timezone);
const hasPlan = Boolean(subscription);
const teacherForOnboarding = assignedTeacher ?? nextSession?.teacher ?? null;
const hasTeacher = Boolean(teacherForOnboarding);
const hasDrive = Boolean(driveFolderUrl);
const hasFirstClass = Boolean(nextSession);
const hasClassAssets = Boolean(nextSession?.meet_link && nextSession?.drive_doc_url);
const retryHref = `${Astro.url.pathname}${Astro.url.search}`;
const planStatus: OnboardingItem['status'] = subscriptionState.status === 'error'
    ? 'unavailable'
    : hasPlan ? 'ready' : 'pending';
const teacherStatus: OnboardingItem['status'] = assignmentState.status === 'error'
    ? 'unavailable'
    : hasTeacher ? 'ready' : 'pending';
const driveStatus: OnboardingItem['status'] = profilePrivateState.status === 'error'
    ? 'unavailable'
    : hasDrive ? 'ready' : 'pending';
const firstClassStatus: OnboardingItem['status'] = nextSessionRowState.status === 'error'
    ? 'unavailable'
    : hasFirstClass ? 'ready' : 'pending';
const classAssetsStatus: OnboardingItem['status'] = nextSessionRowState.status === 'error'
    ? 'unavailable'
    : hasClassAssets ? 'ready' : 'pending';
const onboardingItems: OnboardingItem[] = [
    {
        label: onboardingCopy.profile,
        status: profileComplete ? 'ready' : 'pending',
        href: `/${lang}/campus/account`,
        cta: onboardingCopy.completeProfile,
    },
    {
        label: onboardingCopy.plan,
        status: planStatus,
        href: planStatus === 'unavailable' ? retryHref : purchaseOfferHref,
        cta: planStatus === 'unavailable' ? t('campus.loadError.retry') : onboardingCopy.viewPlaces,
    },
    {
        label: onboardingCopy.teacher,
        status: teacherStatus,
        detail: teacherForOnboarding?.full_name || teacherForOnboarding?.email || null,
        href: teacherStatus === 'unavailable' ? retryHref : undefined,
        cta: teacherStatus === 'unavailable' ? t('campus.loadError.retry') : onboardingCopy.teacherPending,
    },
    {
        label: onboardingCopy.drive,
        status: driveStatus,
        href: driveStatus === 'unavailable' ? retryHref : undefined,
        cta: driveStatus === 'unavailable' ? t('campus.loadError.retry') : onboardingCopy.waiting,
    },
    {
        label: onboardingCopy.firstClass,
        status: firstClassStatus,
        href: firstClassStatus === 'unavailable'
            ? retryHref
            : hasFirstClass ? `/${lang}/campus/classes` : undefined,
        cta: firstClassStatus === 'unavailable'
            ? t('campus.loadError.retry')
            : hasFirstClass ? onboardingCopy.viewClasses : onboardingCopy.schedulePending,
    },
    {
        label: onboardingCopy.classAssets,
        status: classAssetsStatus,
        href: classAssetsStatus === 'unavailable' ? retryHref : `/${lang}/campus/classes`,
        cta: classAssetsStatus === 'unavailable'
            ? t('campus.loadError.retry')
            : hasFirstClass ? onboardingCopy.waiting : onboardingCopy.viewClasses,
    },
    {
        label: onboardingCopy.support,
        status: 'ready',
        href: `/${lang}/campus/support`,
        cta: onboardingCopy.openSupport,
        alwaysShowAction: true,
    },
];
const onboardingHasUnavailable = onboardingItems.some((item) => item.status === 'unavailable');
---

{accessUnavailable || !user || !profile ? (
    <BaseLayout
        title={t('campus.dashboard.title')}
        description={t('campus.loadError.message')}
        lang={lang}
        noindex={true}
    >
        <main class="mx-auto flex min-h-screen max-w-2xl items-center px-4 py-12">
            <h1 class="sr-only">{t('campus.dashboard.title')}</h1>
            <CampusLoadError lang={lang} />
        </main>
    </BaseLayout>
) : (
<CampusLayout
    title={t('campus.dashboard.title')}
    user={{ ...user, ...profile }}
    lang={lang}
>
    <!-- Page Header -->
    <div class="mb-8">
         <h1 class="font-display text-4xl text-[#006064] uppercase">{t('campus.dashboard.title')}</h1>
         <p class="font-mono text-[#006064]/60">{t('campus.dashboard.welcomeBack')}, {profile?.full_name || user.email}</p>
    </div>

    {assignmentState.status === 'error' && (
        <div class="mb-8">
            <CampusLoadError lang={lang} title={onboardingCopy.teacher} />
        </div>
    )}

    <section class="mb-8 border-2 border-[#006064] bg-white p-5 shadow-[4px_4px_0px_0px_#006064]">
        <div class="mb-4 flex flex-col gap-2 md:flex-row md:items-end md:justify-between">
            <div>
                <h2 class="font-display text-2xl text-[#006064] uppercase">{onboardingCopy.title}</h2>
                <p class="font-mono text-xs text-[#006064]/70">{onboardingCopy.subtitle}</p>
            </div>
            {onboardingHasUnavailable ? (
                <span class="font-mono text-xs font-bold text-red-700">
                    {t('campus.loadError.title')}
                </span>
            ) : (
                <span class="font-mono text-xs text-[#006064]/70">
                    {onboardingItems.filter((item) => item.status === 'ready').length}/{onboardingItems.length}
                </span>
            )}
        </div>
        <div class="grid grid-cols-1 gap-3 md:grid-cols-2 xl:grid-cols-4">
            {onboardingItems.map((item) => {
                const isReady = item.status === 'ready';
                const isUnavailable = item.status === 'unavailable';
                return (
                <div class={`border-2 p-3 ${isReady
                    ? 'border-green-600 bg-green-50 text-green-800'
                    : isUnavailable
                        ? 'border-red-500 bg-red-50 text-red-800'
                        : 'border-[#006064]/30 bg-[#E0F7FA] text-[#006064]'}`}>
                    <div class="flex items-start justify-between gap-3">
                        <p class="text-sm font-bold leading-5">{item.label}</p>
                        <span class={`shrink-0 px-2 py-1 text-[10px] font-bold uppercase ${isReady
                            ? 'bg-green-100 text-green-800'
                            : isUnavailable ? 'bg-red-100 text-red-800' : 'bg-white text-[#006064]'}`}>
                            {isReady
                                ? onboardingCopy.ready
                                : isUnavailable ? t('campus.loadError.title') : (item.href ? onboardingCopy.action : onboardingCopy.pending)}
                        </span>
                    </div>
                    {item.detail && (
                        <p class="mt-2 text-xs font-mono opacity-80">{item.detail}</p>
                    )}
                    {(!isReady || item.alwaysShowAction) && (
                        item.href ? (
                            <a href={item.href} class="mt-3 inline-block text-xs font-bold uppercase underline">
                                {item.cta}
                            </a>
                        ) : (
                            <p class="mt-3 text-xs font-mono opacity-80">{item.cta}</p>
                        )
                    )}
                </div>
                );
            })}
        </div>
    </section>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-2 xl:grid-cols-4 gap-6">
        {subscriptionState.status === 'error' ? (
            <div class="md:col-span-2">
                <CampusLoadError lang={lang} title={t('campus.dashboard.yourPlan')} />
            </div>
        ) : (
        <div class="contents">

         <!-- CARD 1: TU PLAN -->
         <div class="bg-white p-6 border-2 border-[#006064] shadow-[4px_4px_0px_0px_#006064] flex flex-col justify-between h-full">
             <div>
                 <div class="flex items-center justify-between mb-4">
                     <h3 class="font-bold text-lg text-[#006064] uppercase tracking-wide">{t('campus.dashboard.yourPlan')}</h3>
                     <span class="text-2xl">🎟️</span>
                 </div>
                 
                 {subscription ? (
                     <div>
                         <p class="font-display text-2xl text-[#006064] mb-1">{packageName}</p>
                         <div class="flex items-center gap-2 mb-4">
                             <span class="px-2 py-0.5 bg-green-100 text-green-800 text-xs font-bold uppercase rounded border border-green-200">{t('campus.dashboard.active')}</span>
                             <span class="text-xs text-[#006064]/60">{t('campus.dashboard.until')} {formatDate(subscription.ends_at)}</span>
                         </div>
                     </div>
                 ) : (
                     <div class="mb-4">
                         <p class="text-[#006064]/70 italic">{t('campus.dashboard.noPlan')}</p>
                     </div>
                 )}
             </div>

             <div>
                 {subscription ? (
                       <button id="manage-sub-btn" class="w-full py-2 bg-[#E0F7FA] text-[#006064] text-xs font-bold uppercase border border-[#006064] hover:bg-[#006064] hover:text-white transition-colors">
                           {t('campus.dashboard.manageSub')}
                       </button>
                 ) : (
                      <a href={purchaseOfferHref} class="block w-full text-center py-2 bg-[#006064] text-white text-xs font-bold uppercase border border-[#006064] hover:bg-[#004d40] transition-colors">
                          {onboardingCopy.viewPlaces}
                      </a>
                      <a href={`/${lang}/#contacto`} class="mt-2 block w-full text-center py-2 text-[#006064] text-xs font-bold uppercase underline underline-offset-4 hover:opacity-70">
                          {onboardingCopy.contact}
                      </a>
                 )}
             </div>
         </div>

         <!-- CARD 2: SESIONES -->
         <div class="bg-white p-6 border-2 border-[#006064] shadow-[4px_4px_0px_0px_#006064] flex flex-col justify-between h-full">
             <div class="flex items-center justify-between mb-4">
                 <h3 class="font-bold text-lg text-[#006064] uppercase tracking-wide">{t('campus.dashboard.sessions')}</h3>
                 <span class="text-2xl">📊</span>
             </div>

             {cycleProgressState.status === 'error' || cycleProgressInconsistent ? (
                <CampusLoadError lang={lang} title={t('campus.dashboard.sessions')} />
             ) : cycleProgressPresentation?.state === 'pending' ? (
                <div class="flex-1 flex items-center" role="status">
                    <p class="text-sm text-[#006064]/70">{t('campus.dashboard.progressPending')}</p>
                </div>
             ) : subscription && cycleProgressTotals ? (
                <div>
                    <div class="flex items-end gap-2 mb-2">
                         <span class="font-display text-4xl text-[#006064]">{cycleProgressTotals.consumed}</span>
                         <span class="text-lg text-[#006064]/50 font-bold mb-1">/ {cycleProgressTotals.total}</span>
                    </div>
                    <p class="text-xs text-[#006064]/60 uppercase font-bold mb-4">{t('campus.dashboard.sessionsUsed')}</p>
                    
                    <ProgressBar
                        value={cycleProgressTotals.consumed}
                        max={cycleProgressTotals.total}
                        label={t('campus.dashboard.sessionsUsed')}
                        rounded={true}
                    />
                </div>
             ) : subscription ? (
                <div class="flex-1 flex items-center" role="status">
                    <p class="text-sm text-[#006064]/70">{t('campus.dashboard.progressUnavailable')}</p>
                </div>
             ) : (
                <div class="flex-1 flex items-center justify-center">
                    <p class="text-4xl text-[#006064]/20 font-display">—</p>
                </div>
             )}
         </div>

        </div>
        )}

         <!-- CARD 3: PROXIMA CLASE (Ahora funcional) -->
         {nextSessionRowState.status === 'error' ? (
            <CampusLoadError lang={lang} title={t('campus.dashboard.nextClass')} />
         ) : (
            <NextClassCard
                client:load
                session={nextSession}
                lang={lang}
                translations={nextClassTranslations}
            />
         )}

         <!-- CARD 4: DRIVE -->
         {profilePrivateState.status === 'error' ? (
            <CampusLoadError lang={lang} title="Drive" />
         ) : (
         <div class="bg-white p-6 border-2 border-[#006064] shadow-[4px_4px_0px_0px_#006064] flex flex-col justify-between h-full">
             <div>
                 <div class="flex items-center justify-between mb-4">
                     <h3 class="font-bold text-lg text-[#006064] uppercase tracking-wide">Drive</h3>
                     <span class="text-2xl">📂</span>
                 </div>
                 <p class="text-sm text-[#006064]/70 mb-4">{t('campus.dashboard.driveFolder')}</p>
             </div>

             <div>
                 {driveFolderUrl ? (
                     <a href={driveFolderUrl} target="_blank" rel="noopener noreferrer" class="flex items-center justify-center w-full py-2 bg-[#E0F7FA] text-[#006064] text-xs font-bold uppercase border border-[#006064] hover:bg-[#006064] hover:text-white transition-colors gap-2">
                         <span>🔗</span> {t('campus.dashboard.openFolder')}
                     </a>
                 ) : (
                     <div class="w-full py-2 bg-[#E0F7FA] text-[#006064] text-xs font-bold uppercase border border-[#006064] text-center cursor-not-allowed">
                         {t('campus.dashboard.folderPending')}
                     </div>
                 )}
             </div>
         </div>
         )}

    </div>
</CampusLayout>
)}

<script>
    import { openBillingPortal } from '../../../lib/billing-portal-client';

    // Stripe Customer Portal — manage subscription
    const manageSubBtn = document.getElementById('manage-sub-btn') as HTMLButtonElement | null;
    manageSubBtn?.addEventListener('click', () => {
        void openBillingPortal({ button: manageSubBtn }).catch((error) => {
            console.error('Error opening Stripe portal:', error);
        });
    });
</script>
