---
import CampusLayout from '../../../../layouts/CampusLayout.astro';
import { getLangFromParam, useTranslations } from '../../../../i18n/utils';
import { createSupabaseServerClient } from '../../../../lib/supabase-server';
import StudentFilters from '../../../../components/admin/StudentFilters';

export const prerender = false;

const lang = getLangFromParam(Astro.params.lang);
const t = useTranslations(lang);

// Get Supabase client and verify user
const supabase = createSupabaseServerClient(Astro);
const { data: { user } } = await supabase.auth.getUser();

if (!user) {
    return Astro.redirect(`/${lang}/login`);
}

// Get profile with role
const { data: profile } = await supabase
    .from('profiles')
    .select('*')
    .eq('id', user.id)
    .single();

// Check if user is admin
if (!profile || profile.role !== 'admin') {
    return Astro.redirect(`/${lang}/campus`);
}

// Get all students with their subscriptions and teachers
const { data: studentsRaw } = await supabase
    .from('profiles')
    .select('id, full_name, email, phone, created_at, preferred_language')
    .eq('role', 'student')
    .order('created_at', { ascending: false });

const studentIds = (studentsRaw || []).map((student) => student.id);

const { data: subscriptionsRaw } = studentIds.length
    ? await supabase
        .from('subscriptions')
        .select(`
            student_id,
            status,
            ends_at,
            created_at,
            packages (
                name,
                display_name
            )
        `)
        .in('student_id', studentIds)
        .eq('status', 'active')
        .order('created_at', { ascending: false })
    : { data: [] };

const { data: assignmentsRaw } = studentIds.length
    ? await supabase
        .from('student_teachers')
        .select(`
            student_id,
            profiles!student_teachers_teacher_id_fkey (
                full_name
            )
        `)
        .in('student_id', studentIds)
        .eq('is_primary', true)
    : { data: [] };

type SubscriptionSummary = NonNullable<typeof subscriptionsRaw>[number];

const localizedStringRecord = (value: unknown): Record<string, string> | null => {
    if (!value || typeof value !== 'object' || Array.isArray(value)) return null;
    const localized: Record<string, string> = {};
    for (const [key, entry] of Object.entries(value)) {
        if (typeof entry === 'string') localized[key] = entry;
    }
    return Object.keys(localized).length > 0 ? localized : null;
};

const subscriptionByStudent = new Map<string, SubscriptionSummary>();
for (const subscription of subscriptionsRaw ?? []) {
    if (!subscriptionByStudent.has(subscription.student_id)) {
        subscriptionByStudent.set(subscription.student_id, subscription);
    }
}

const teacherByStudent = new Map<string, string | null>();
for (const assignment of assignmentsRaw ?? []) {
    const relatedProfile = Array.isArray(assignment.profiles)
        ? assignment.profiles[0]
        : assignment.profiles;
    teacherByStudent.set(assignment.student_id, relatedProfile?.full_name ?? null);
}

const students = (studentsRaw || []).map((student) => {
    const subscription = subscriptionByStudent.get(student.id);

    return {
        ...student,
        subscription_status: subscription?.status || null,
        subscription_ends: subscription?.ends_at || null,
        package_name: subscription?.packages?.name || null,
        package_display_name: localizedStringRecord(subscription?.packages?.display_name),
        teacher_name: teacherByStudent.get(student.id) ?? null,
    };
});

// Get packages for filter dropdown
const { data: packages } = await supabase
    .from('packages')
    .select('name, display_name')
    .eq('is_active', true);

const packagesList = (packages ?? []).map((pkg) => {
    const displayName = localizedStringRecord(pkg.display_name);
    return {
        name: pkg.name,
        displayName: displayName?.[lang] ?? displayName?.es ?? pkg.name,
    };
});

const studentCount = students?.length || 0;

// Translations for the component
const filterTranslations = {
    search: t('campus.teacher.search'),
    filterStatus: t('campus.admin.students.filterStatus'),
    filterPlan: t('campus.admin.students.filterPlan'),
    all: t('campus.admin.students.all'),
    withPlan: t('campus.admin.students.withPlan'),
    noPlan: t('campus.admin.students.noPlan'),
    expired: t('campus.admin.students.expired'),
    assignTeacher: t('campus.admin.students.assignTeacher'),
    registered: t('campus.admin.students.registered'),
    viewDetails: t('campus.teacher.viewDetails'),
    count: t('campus.admin.students.count'),
    name: t('campus.admin.students.name'),
    email: t('campus.admin.students.email'),
    plan: t('campus.admin.students.plan'),
    status: t('campus.admin.students.status'),
    teacher: t('campus.admin.students.teacher'),
    actions: t('campus.admin.students.actions'),
    active: t('campus.admin.students.active'),
    unassigned: t('campus.admin.students.unassigned'),
    noResults: t('campus.admin.students.noResults'),
};
---

<CampusLayout 
    title={t('campus.admin.students.title')}
    user={{ ...user, ...profile }}
    lang={lang}
>
    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-8">
        <div>
            <h1 class="font-display text-3xl text-[#006064] uppercase">{t('campus.admin.students.title')}</h1>
            <p class="text-sm text-[#006064]/60 font-mono mt-1">
                {studentCount} {t('campus.admin.students.count')}
            </p>
        </div>
        
        <button 
            disabled
            class="px-6 py-3 bg-[#006064] text-white font-bold uppercase text-sm border-2 border-[#006064] opacity-50 cursor-not-allowed"
        >
            + {t('campus.admin.students.addStudent')}
        </button>
    </div>

    <!-- Filters and Table -->
    <div class="bg-white p-6 border-2 border-[#006064] shadow-[4px_4px_0px_0px_#006064]">
        <StudentFilters 
            client:load
            students={students}
            lang={lang}
            translations={filterTranslations}
            packages={packagesList}
        />
    </div>
</CampusLayout>
