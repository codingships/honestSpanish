---
import CampusLayout from '../../../../../../layouts/CampusLayout.astro';
import CrmContactActions from '../../../../../../components/admin/CrmContactActions';
import CrmConsentManager from '../../../../../../components/admin/CrmConsentManager';
import CrmOpportunityList from '../../../../../../components/admin/CrmOpportunityList';
import CrmTaskList from '../../../../../../components/admin/CrmTaskList';
import {
    emptyCrmContactDetail,
    getCrmContactDetailByContactId,
} from '../../../../../../lib/crm/contact-detail';
import { createSupabaseAdminClient } from '../../../../../../lib/supabase-admin';
import { createSupabaseServerClient } from '../../../../../../lib/supabase-server';

export const prerender = false;

const { lang, id: contactId } = Astro.params as { lang: 'es' | 'en' | 'ru'; id: string };

const supabase = createSupabaseServerClient(Astro);
const { data: { user } } = await supabase.auth.getUser();

if (!user) {
    return Astro.redirect(`/${lang}/login`);
}

const { data: currentProfile } = await supabase
    .from('profiles')
    .select('id, email, full_name, role')
    .eq('id', user.id)
    .single();

if (!currentProfile || currentProfile.role !== 'admin') {
    return Astro.redirect(`/${lang}/campus`);
}

const supabaseAdmin = createSupabaseAdminClient();
let crmDetail = emptyCrmContactDetail;

try {
    crmDetail = await getCrmContactDetailByContactId(supabaseAdmin, { contactId });
} catch (error) {
    console.error('[AdminCrmContactDetail] Could not load CRM contact detail:', error);
}

const crmLifecycleLabels: Record<string, string> = {
    lead: 'Lead',
    qualified: 'Cualificado',
    customer: 'Cliente',
    alumni: 'Antiguo alumno',
    inactive: 'Inactivo',
    lost: 'Perdido',
};

const formatDateTime = (dateStr: string | null) => {
    if (!dateStr) return '-';
    return new Date(dateStr).toLocaleString(lang === 'es' ? 'es-ES' : lang === 'ru' ? 'ru-RU' : 'en-US', {
        day: 'numeric',
        month: 'short',
        hour: '2-digit',
        minute: '2-digit',
    });
};

const contact = crmDetail.contact;
const contactName = contact?.full_name || contact?.primary_email || 'Contacto CRM';
const openOpportunities = crmDetail.opportunities.filter((opportunity) => !['won', 'lost'].includes(opportunity.stage));
const openTasks = crmDetail.tasks.filter((task) => ['open', 'snoozed'].includes(task.status));
const timelineItems = [
    ...crmDetail.activities.map((activity) => ({
        id: `crm-${activity.id}`,
        kind: 'CRM',
        title: activity.subject || activity.activity_type,
        detail: activity.body || activity.related_entity_type || '',
        date: activity.occurred_at,
    })),
    ...crmDetail.sessions.flatMap((session) => {
        const date = session.scheduled_at || session.created_at;
        if (!date) return [];
        return [{
            id: `session-${session.id}`,
            kind: 'Clase',
            title: session.status || 'Clase',
            detail: session.teacher?.full_name || session.teacher?.email || 'Sin profesor asignado',
            date,
        }];
    }),
    ...crmDetail.supportTickets.flatMap((ticket) => ticket.created_at ? [{
        id: `support-${ticket.id}`,
        kind: 'Soporte',
        title: ticket.issue_title,
        detail: `${ticket.issue_type} - ${ticket.status}`,
        date: ticket.created_at,
    }] : []),
].sort((left, right) => new Date(right.date).getTime() - new Date(left.date).getTime()).slice(0, 15);
---

<CampusLayout
    title={`${contactName} | CRM`}
    user={{ ...user, ...currentProfile }}
    lang={lang}
>
    <div class="mb-8">
        <a
            href={`/${lang}/campus/admin/leads`}
            class="inline-flex items-center gap-2 text-[#006064] hover:opacity-70 transition-opacity mb-4 font-mono text-sm"
        >
            &larr; Volver a CRM Leads
        </a>

        <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
            <div>
                <h1 class="font-display text-4xl text-[#006064] mb-2">{contactName}</h1>
                {contact && (
                    <div class="flex flex-wrap gap-4 text-sm text-[#006064]/70">
                        <span>{contact.primary_email}</span>
                        {contact.phone && <span>{contact.phone}</span>}
                        {contact.preferred_language && <span>{contact.preferred_language}</span>}
                        {contact.timezone && <span>{contact.timezone}</span>}
                    </div>
                )}
            </div>

            <div class="flex flex-wrap gap-2">
                {contact?.profile_id && (
                    <a
                        href={`/${lang}/campus/admin/student/${contact.profile_id}`}
                        class="px-4 py-2 bg-[#E0F7FA] text-[#006064] text-xs font-bold uppercase border border-[#006064] hover:bg-[#006064] hover:text-white transition-colors"
                    >
                        Ver alumno
                    </a>
                )}
                {contact && (
                    <span class="inline-flex border border-[#006064] px-4 py-2 text-xs font-bold uppercase text-[#006064]">
                        {crmLifecycleLabels[contact.lifecycle_stage] || contact.lifecycle_stage}
                    </span>
                )}
            </div>
        </div>
    </div>

    <div class="bg-white p-6 border-2 border-[#006064] shadow-[4px_4px_0px_0px_#006064] mb-6">
        <div class="flex flex-col gap-3 md:flex-row md:items-start md:justify-between mb-5">
            <div>
                <h2 class="font-display text-xl text-[#006064] uppercase">Ficha CRM</h2>
                <p class="text-sm text-[#006064]/70 font-mono mt-1">Contacto, pipeline, tareas y permisos de comunicacion.</p>
            </div>
            {contact?.profile_id ? (
                <span class="inline-flex w-fit border border-[#006064] px-3 py-1 text-xs font-bold uppercase text-[#006064]">Alumno enlazado</span>
            ) : (
                <span class="inline-flex w-fit border border-[#006064] px-3 py-1 text-xs font-bold uppercase text-[#006064]">Contacto sin cuenta</span>
            )}
        </div>

        {!crmDetail.isReady ? (
            <div class="bg-[#E0F7FA] border border-[#006064] p-4">
                <p class="font-bold text-[#006064]">CRM pendiente de migracion</p>
                <p class="text-sm text-[#006064]/70 mt-1">Esta ficha se completara cuando las tablas CRM esten aplicadas.</p>
            </div>
        ) : contact ? (
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                <div>
                    <h3 class="font-display text-lg text-[#006064] uppercase mb-3">Contacto</h3>
                    <div class="space-y-2 text-sm text-[#006064]">
                        <p><span class="font-mono text-xs uppercase text-[#006064]/60">Email</span><br />{contact.primary_email}</p>
                        {contact.phone && <p><span class="font-mono text-xs uppercase text-[#006064]/60">Telefono</span><br />{contact.phone}</p>}
                        <p><span class="font-mono text-xs uppercase text-[#006064]/60">Idioma / zona</span><br />{contact.preferred_language || 'es'} / {contact.timezone || 'Sin zona'}</p>
                        {contact.country && <p><span class="font-mono text-xs uppercase text-[#006064]/60">Pais</span><br />{contact.country}</p>}
                        {contact.source && <p><span class="font-mono text-xs uppercase text-[#006064]/60">Origen</span><br />{contact.source}</p>}
                        {contact.source_path && <p><span class="font-mono text-xs uppercase text-[#006064]/60">Ruta origen</span><br />{contact.source_path}</p>}
                        {contact.last_contacted_at && <p><span class="font-mono text-xs uppercase text-[#006064]/60">Ultimo contacto</span><br />{formatDateTime(contact.last_contacted_at)}</p>}
                        {contact.next_follow_up_at && <p><span class="font-mono text-xs uppercase text-[#006064]/60">Proximo seguimiento</span><br />{formatDateTime(contact.next_follow_up_at)}</p>}
                    </div>
                </div>

                <div>
                    <h3 class="font-display text-lg text-[#006064] uppercase mb-3">Pipeline abierto</h3>
                    <CrmOpportunityList client:load opportunities={openOpportunities} lang={lang} />
                </div>

                <div>
                    <h3 class="font-display text-lg text-[#006064] uppercase mb-3">Tareas abiertas</h3>
                    <CrmTaskList client:load tasks={openTasks} emptyText="Sin tareas activas." />
                </div>

                <div class="border-t border-[#006064]/20 pt-5 lg:col-span-3">
                    <CrmConsentManager
                        client:load
                        contactId={contact.id}
                        consents={crmDetail.consents}
                    />
                </div>

                <div class="border-t border-[#006064]/20 pt-5 lg:col-span-3">
                    <CrmContactActions
                        client:load
                        contactId={contact.id}
                        opportunityId={openOpportunities[0]?.id ?? null}
                    />
                </div>
            </div>
        ) : (
            <div class="bg-[#E0F7FA] border border-[#006064] p-4">
                <p class="font-bold text-[#006064]">Contacto CRM no encontrado</p>
                <p class="text-sm text-[#006064]/70 mt-1">El identificador no corresponde a ningun contacto CRM visible.</p>
            </div>
        )}
    </div>

    <div class="bg-white p-6 border-2 border-[#006064] shadow-[4px_4px_0px_0px_#006064]">
        <div class="flex flex-col gap-2 md:flex-row md:items-center md:justify-between mb-4">
            <h2 class="font-display text-xl text-[#006064] uppercase">Historial CRM unificado</h2>
            <p class="text-xs font-mono uppercase text-[#006064]/60">{timelineItems.length} eventos visibles</p>
        </div>

        {timelineItems.length > 0 ? (
            <div class="divide-y divide-[#006064]/10">
                {timelineItems.map((item) => (
                    <div class="grid grid-cols-1 gap-2 py-3 md:grid-cols-[8rem_1fr_auto] md:items-start">
                        <div>
                            <span class="inline-flex border border-[#006064] px-2 py-1 text-xs font-bold uppercase text-[#006064]">{item.kind}</span>
                        </div>
                        <div>
                            <p class="font-bold text-[#006064]">{item.title}</p>
                            {item.detail && <p class="text-sm text-[#006064]/70 mt-1">{item.detail}</p>}
                        </div>
                        <p class="text-xs font-mono text-[#006064]/70 md:text-right">{formatDateTime(item.date)}</p>
                    </div>
                ))}
            </div>
        ) : (
            <p class="text-[#006064]/60 font-mono text-sm">Sin eventos todavia.</p>
        )}
    </div>
</CampusLayout>
