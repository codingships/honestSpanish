---
import AdminAuditHistory from '../../../../components/admin/AdminAuditHistory';
import CampusLayout from '../../../../layouts/CampusLayout.astro';
import { requireAdminCapability } from '../../../../lib/admin-access';
import { createSupabaseServerClient } from '../../../../lib/supabase-server';

export const prerender = false;

const { lang } = Astro.params as { lang: 'es' | 'en' | 'ru' };
const auth = await requireAdminCapability(Astro, 'access.read');
if (auth.error || !auth.user) return auth.error;

const supabase = createSupabaseServerClient(Astro);
const { data: profile } = await supabase
    .from('profiles')
    .select('email, full_name, role')
    .eq('id', auth.user.id)
    .single();
if (!profile) return new Response('Profile unavailable', { status: 503 });
---

<CampusLayout title="Historial" user={profile} lang={lang}>
    <div class="mx-auto max-w-7xl space-y-6">
        <div>
            <h1 class="font-display text-3xl uppercase text-[#006064]">Historial administrativo</h1>
            <p class="mt-1 max-w-3xl font-mono text-sm text-[#006064]">
                Índice inmutable de acciones. Los detalles sensibles no se exponen en esta vista general.
            </p>
        </div>
        <AdminAuditHistory client:load />
    </div>
</CampusLayout>
