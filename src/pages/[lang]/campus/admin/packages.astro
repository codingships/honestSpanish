---
import CampusLayout from '../../../../layouts/CampusLayout.astro';
import { requireAdminCapability } from '../../../../lib/admin-access';
import { createSupabaseServerClient } from '../../../../lib/supabase-server';
import ProductCatalogManager from '../../../../components/admin/ProductCatalogManager';
import VersionedCatalogManager from '../../../../components/admin/VersionedCatalogManager';

export const prerender = false;

const { lang } = Astro.params as { lang: 'es' | 'en' | 'ru' };

const auth = await requireAdminCapability(Astro, 'catalog.read');
if (auth.error || !auth.user) return auth.error;
const user = auth.user;

const supabase = createSupabaseServerClient(Astro);
const { data: profile } = await supabase
    .from('profiles')
    .select('*')
    .eq('id', user.id)
    .single();

if (!profile || profile.role !== 'admin') {
    return Astro.redirect(`/${lang}/campus`);
}
---

<CampusLayout title="Catálogo" user={{ email: user.email, full_name: profile.full_name, role: profile.role }} lang={lang}>
    <div class="max-w-7xl mx-auto space-y-6">
        <div>
            <h1 class="font-display text-3xl text-[#006064] uppercase">Catálogo</h1>
            <p class="text-sm text-[#006064]/60 font-mono mt-1">Productos, cuotas y precios de checkout</p>
        </div>
        <VersionedCatalogManager client:load />
        <details class="border border-[#006064]/30 bg-white p-5">
            <summary class="cursor-pointer font-mono text-xs font-bold uppercase text-[#006064]">
                Catálogo heredado V1 · mantenimiento transitorio
            </summary>
            <p class="mt-3 max-w-3xl text-sm text-[#006064]/70">
                Estos productos antiguos conservan compatibilidad histórica. Las ofertas nuevas deben crearse arriba mediante borrador y publicación versionada.
            </p>
            <div class="mt-5">
                <ProductCatalogManager client:visible />
            </div>
        </details>
    </div>
</CampusLayout>
