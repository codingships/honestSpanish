---
import CampusLayout from '../../../../../layouts/CampusLayout.astro';
import CampusLoadError from '../../../../../components/campus/CampusLoadError.astro';
import { getLangFromParam, useTranslations } from '../../../../../i18n/utils';
import { reportCampusReadError } from '../../../../../lib/campus-load-state';
import {
    loadCheckoutV2ProgressHistory,
    resolveCheckoutV2AcademicProgress,
    type CheckoutV2AcademicProgress,
    type CheckoutV2CycleProgress,
} from '../../../../../lib/checkout-v2-progress';
import { emptyCrmContactDetail, getCrmContactDetail } from '../../../../../lib/crm/contact-detail';
import { getPrivateProfile } from '../../../../../lib/profiles-private';
import { createSupabaseAdminClient } from '../../../../../lib/supabase-admin';
import { createSupabaseServerClient } from '../../../../../lib/supabase-server';
import TeacherNotes from '../../../../../components/TeacherNotes';
import AssignTeacherButton from '../../../../../components/admin/AssignTeacherButton';
import CrmContactActions from '../../../../../components/admin/CrmContactActions';
import CrmConsentManager from '../../../../../components/admin/CrmConsentManager';
import CrmOpportunityList from '../../../../../components/admin/CrmOpportunityList';
import CrmTaskList from '../../../../../components/admin/CrmTaskList';
import ProgressBar from '../../../../../components/ProgressBar.astro';
import type { Json } from '../../../../../types/database.types';

export const prerender = false;

const lang = getLangFromParam(Astro.params.lang);
const studentId = Astro.params.id;

if (!studentId) {
    return Astro.redirect(`/${lang}/campus/admin/students`);
}

const t = useTranslations(lang);

// Get Supabase client and verify user
const supabase = createSupabaseServerClient(Astro);
const { data: { user } } = await supabase.auth.getUser();

if (!user) {
    return Astro.redirect(`/${lang}/login`);
}

// Get current user's profile with role
const { data: currentProfile } = await supabase
    .from('profiles')
    .select('id, email, full_name, role, preferred_language, phone, timezone')
    .eq('id', user.id)
    .single();

// Check if user is admin
if (!currentProfile || currentProfile.role !== 'admin') {
    return Astro.redirect(`/${lang}/campus`);
}

const supabaseAdmin = createSupabaseAdminClient();

// Get student profile
const { data: student, error: studentError } = await supabase
    .from('profiles')
    .select('id, email, full_name, phone, preferred_language')
    .eq('id', studentId)
    .single();

if (studentError || !student) {
    return Astro.redirect(`/${lang}/campus/admin/students`);
}

const studentPrivate = await getPrivateProfile(studentId);
const driveFolderUrl = studentPrivate?.drive_folder_url
    || (studentPrivate?.drive_folder_id ? `https://drive.google.com/drive/folders/${studentPrivate.drive_folder_id}` : null);

// Get active subscription with package info
const { data: subscription, error: subscriptionError } = await supabase
    .from('subscriptions')
    .select(`
        *,
        packages (
            name,
            display_name
        )
    `)
    .eq('student_id', studentId)
    .eq('status', 'active')
    .order('created_at', { ascending: false })
    .limit(1)
    .maybeSingle();

if (subscriptionError) {
    reportCampusReadError('admin_student.subscription', subscriptionError);
    Astro.response.status = 503;
}

// Get all subscriptions (history)
const { data: subscriptionHistory, error: subscriptionHistoryError } = await supabase
    .from('subscriptions')
    .select(`
        id,
        status,
        starts_at,
        ends_at,
        sessions_total,
        contract_schema_version,
        created_at,
        packages (
            name,
            display_name
        )
    `)
    .eq('student_id', studentId)
    .order('created_at', { ascending: false });

if (subscriptionHistoryError) {
    reportCampusReadError('admin_student.subscription_history', subscriptionHistoryError);
    Astro.response.status = 503;
}

const checkoutV2SubscriptionIds = (subscriptionHistory ?? [])
    .filter((item) => item.contract_schema_version === 2)
    .map((item) => item.id);
let cycleProgressHistory = new Map<string, CheckoutV2CycleProgress[]>();
let cycleProgressLoadError = Boolean(subscriptionHistoryError);

if (!cycleProgressLoadError) {
    try {
        cycleProgressHistory = await loadCheckoutV2ProgressHistory(
            supabaseAdmin,
            checkoutV2SubscriptionIds,
        );
    } catch (error) {
        cycleProgressLoadError = true;
        reportCampusReadError('admin_student.cycle_progress', error);
        Astro.response.status = 503;
    }
}

const cycleProgressContractError = !cycleProgressLoadError && (subscriptionHistory ?? []).some((item) => {
    if (item.contract_schema_version !== 2) return false;
    const cycles = cycleProgressHistory.get(item.id) ?? [];
    if (cycles.length === 0) return true;
    return cycles.some((cycle) => {
        const resolved = resolveCheckoutV2AcademicProgress(2, cycle);
        return resolved.state === 'missing' || resolved.state === 'inconsistent';
    });
});

if (cycleProgressContractError) {
    reportCampusReadError('admin_student.cycle_progress', {
        code: 'CHECKOUT_V2_PROGRESS_INCONSISTENT',
    });
    Astro.response.status = 503;
}

const currentCycleProgress = subscription?.contract_schema_version === 2
    ? (cycleProgressHistory.get(subscription.id) ?? [])[0] ?? null
    : null;
const currentCyclePresentation = subscription
    ? resolveCheckoutV2AcademicProgress(
        subscription.contract_schema_version,
        currentCycleProgress,
    )
    : null;
type SubscriptionHistoryRow = NonNullable<typeof subscriptionHistory>[number];
type SubscriptionCycleHistoryItem = {
    subscription: SubscriptionHistoryRow;
    progress: CheckoutV2CycleProgress | null;
    academicProgress: CheckoutV2AcademicProgress;
};
const subscriptionCycleHistory: SubscriptionCycleHistoryItem[] = [];
for (const item of subscriptionHistory ?? []) {
    if (item.contract_schema_version !== 2) {
        subscriptionCycleHistory.push({
            subscription: item,
            progress: null,
            academicProgress: resolveCheckoutV2AcademicProgress(
                item.contract_schema_version,
                null,
            ),
        });
        continue;
    }
    const cycles = cycleProgressHistory.get(item.id) ?? [];
    if (cycles.length === 0) {
        subscriptionCycleHistory.push({
            subscription: item,
            progress: null,
            academicProgress: resolveCheckoutV2AcademicProgress(2, null),
        });
        continue;
    }
    for (const progress of cycles) {
        subscriptionCycleHistory.push({
            subscription: item,
            progress,
            academicProgress: resolveCheckoutV2AcademicProgress(2, progress),
        });
    }
}

// Get assigned teacher
const { data: teacherAssignment } = await supabase
    .from('student_teachers')
    .select(`
        id,
        is_primary,
        profiles!student_teachers_teacher_id_fkey (
            id,
            full_name,
            email
        )
    `)
    .eq('student_id', studentId)
    .eq('is_primary', true)
    .single();

// Get all teachers for assignment dropdown
const { data: allTeachers } = await supabase
    .from('profiles')
    .select('id, full_name, email')
    .eq('role', 'teacher')
    .order('full_name');

// Get payment history
const { data: payments } = await supabase
    .from('payments')
    .select('id, amount, amount_refunded, currency, status, checkout_v2_cycle_id, created_at')
    .eq('student_id', studentId)
    .order('created_at', { ascending: false })
    .limit(10);

let crmDetail = emptyCrmContactDetail;
try {
    crmDetail = await getCrmContactDetail(supabaseAdmin, {
        profileId: studentId,
        email: student.email,
    });
} catch (error) {
    console.error('[AdminStudentDetail] Could not load CRM detail:', error);
}

// Helper functions
type SubscriptionPackage = {
    packages: {
        name: string;
        display_name: Json;
    } | null;
};

const localizedPackageName = (displayName: Json): string | null => {
    if (!displayName || typeof displayName !== 'object' || Array.isArray(displayName)) return null;
    const localized = displayName[lang];
    if (typeof localized === 'string') return localized;
    const spanish = displayName.es;
    return typeof spanish === 'string' ? spanish : null;
};

const getPackageName = (sub: SubscriptionPackage | null | undefined) => {
    if (!sub?.packages?.display_name) return '—';
    return localizedPackageName(sub.packages.display_name) || sub.packages.name;
};

const formatDate = (dateStr: string | null) => {
    if (!dateStr) return '—';
    return new Date(dateStr).toLocaleDateString(lang === 'es' ? 'es-ES' : lang === 'ru' ? 'ru-RU' : 'en-US', {
        day: 'numeric',
        month: 'short',
        year: 'numeric',
    });
};

const formatCurrency = (cents: number) => `€${(cents / 100).toLocaleString(lang === 'es' ? 'es-ES' : 'en-US')}`;

const languageNames: Record<string, string> = {
    es: 'Español',
    en: 'English',
    ru: 'Русский'
};

const crmLifecycleLabels: Record<string, string> = {
    lead: 'Lead',
    qualified: 'Cualificado',
    customer: 'Cliente',
    alumni: 'Antiguo alumno',
    inactive: 'Inactivo',
    lost: 'Perdido',
};

const formatDateTime = (dateStr: string) => {
    if (!dateStr) return '-';
    return new Date(dateStr).toLocaleString(lang === 'es' ? 'es-ES' : lang === 'ru' ? 'ru-RU' : 'en-US', {
        day: 'numeric',
        month: 'short',
        hour: '2-digit',
        minute: '2-digit',
    });
};

const openOpportunities = crmDetail.opportunities.filter((opportunity) => !['won', 'lost'].includes(opportunity.stage));
const openTasks = crmDetail.tasks.filter((task) => ['open', 'snoozed'].includes(task.status));
const crmActivityKeys = new Set(
    crmDetail.activities
        .filter((activity) => activity.related_entity_type && activity.related_entity_id)
        .map((activity) => `${activity.related_entity_type}:${activity.related_entity_id}`)
);
const hasCrmActivityFor = (entityTypes: string[], entityId: string) =>
    entityTypes.some((entityType) => crmActivityKeys.has(`${entityType}:${entityId}`));
const timelineItems = [
    ...crmDetail.activities.map((activity) => ({
        id: `crm-${activity.id}`,
        kind: 'CRM',
        title: activity.subject || activity.activity_type,
        detail: activity.body || activity.related_entity_type || '',
        date: activity.occurred_at,
    })),
    ...(payments || []).flatMap((payment) => payment.created_at && !hasCrmActivityFor(['payment'], payment.id) ? [{
        id: `payment-${payment.id}`,
        kind: 'Pago',
        title: `${formatCurrency(payment.amount)} - ${payment.status}`,
        detail: 'Movimiento de pago',
        date: payment.created_at,
    }] : []),
    ...crmDetail.sessions.flatMap((session) => {
        const date = session.scheduled_at || session.created_at;
        if (!date || hasCrmActivityFor(['session_scheduled', 'session_cancelled', 'session_completed', 'session_no_show'], session.id)) return [];
        return [{
            id: `session-${session.id}`,
            kind: 'Clase',
            title: session.status || 'Clase',
            detail: session.teacher?.full_name || session.teacher?.email || 'Sin profesor asignado',
            date,
        }];
    }),
    ...crmDetail.supportTickets.flatMap((ticket) => ticket.created_at && !hasCrmActivityFor(['support_ticket_created'], ticket.id) ? [{
        id: `support-${ticket.id}`,
        kind: 'Soporte',
        title: ticket.issue_title,
        detail: `${ticket.issue_type} - ${ticket.status}`,
        date: ticket.created_at,
    }] : []),
].sort((left, right) => new Date(right.date).getTime() - new Date(left.date).getTime()).slice(0, 15);

const teacher = teacherAssignment?.profiles ?? null;

// Modal translations
const assignModalTranslations = {
    title: t('campus.admin.assignTeacher.title'),
    select: t('campus.admin.assignTeacher.select'),
    primary: t('campus.admin.assignTeacher.primary'),
    assign: t('campus.admin.assignTeacher.assign'),
    remove: t('campus.admin.assignTeacher.remove'),
    success: t('campus.admin.assignTeacher.success'),
    current: t('campus.admin.assignTeacher.current'),
    none: t('campus.admin.assignTeacher.none'),
};
---

<CampusLayout 
    title={`${student.full_name || student.email} | Admin`}
    user={{ ...user, ...currentProfile }}
    lang={lang}
>
    <!-- Header -->
    <div class="mb-8">
        <a 
            href={`/${lang}/campus/admin/students`}
            class="inline-flex items-center gap-2 text-[#006064] hover:opacity-70 transition-opacity mb-4 font-mono text-sm"
        >
            ← Volver a estudiantes
        </a>
        
        <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
            <div>
                <h1 class="font-display text-4xl text-[#006064] mb-2">
                    {student.full_name || student.email}
                </h1>
                <div class="flex flex-wrap gap-4 text-sm text-[#006064]/70">
                    <span>{student.email}</span>
                    {student.phone && <span>• {student.phone}</span>}
                    {student.preferred_language && (
                        <span>• {languageNames[student.preferred_language] || student.preferred_language}</span>
                    )}
                </div>
            </div>
            
            <div class="flex gap-2">
                {driveFolderUrl && (
                    <a 
                        href={driveFolderUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="px-4 py-2 bg-[#E0F7FA] text-[#006064] text-xs font-bold uppercase border border-[#006064] hover:bg-[#006064] hover:text-white transition-colors"
                    >
                        📁 Drive
                    </a>
                )}
            </div>
        </div>
    </div>

    <!-- CRM Summary -->
    <div class="bg-white p-6 border-2 border-[#006064] shadow-[4px_4px_0px_0px_#006064] mb-6">
        <div class="flex flex-col gap-3 md:flex-row md:items-start md:justify-between mb-5">
            <div>
                <h2 class="font-display text-xl text-[#006064] uppercase">Ficha CRM</h2>
                <p class="text-sm text-[#006064]/70 font-mono mt-1">Relacion comercial, tareas pendientes y contexto operativo del alumno.</p>
            </div>
            {crmDetail.contact && (
                <span class="inline-flex w-fit border border-[#006064] px-3 py-1 text-xs font-bold uppercase text-[#006064]">
                    {crmLifecycleLabels[crmDetail.contact.lifecycle_stage] || crmDetail.contact.lifecycle_stage}
                </span>
            )}
        </div>

        {!crmDetail.isReady ? (
            <div class="bg-[#E0F7FA] border border-[#006064] p-4">
                <p class="font-bold text-[#006064]">CRM pendiente de migracion</p>
                <p class="text-sm text-[#006064]/70 mt-1">La ficha se completara automaticamente cuando las tablas CRM esten aplicadas.</p>
            </div>
        ) : crmDetail.contact ? (
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                <div>
                    <h3 class="font-display text-lg text-[#006064] uppercase mb-3">Contacto</h3>
                    <div class="space-y-2 text-sm text-[#006064]">
                        <p><span class="font-mono text-xs uppercase text-[#006064]/60">Email</span><br />{crmDetail.contact.primary_email}</p>
                        {crmDetail.contact.phone && <p><span class="font-mono text-xs uppercase text-[#006064]/60">Telefono</span><br />{crmDetail.contact.phone}</p>}
                        <p><span class="font-mono text-xs uppercase text-[#006064]/60">Idioma / zona</span><br />{crmDetail.contact.preferred_language || 'es'} / {crmDetail.contact.timezone || 'Sin zona'}</p>
                        {crmDetail.contact.source && <p><span class="font-mono text-xs uppercase text-[#006064]/60">Origen</span><br />{crmDetail.contact.source}</p>}
                        {crmDetail.contact.last_contacted_at && <p><span class="font-mono text-xs uppercase text-[#006064]/60">Ultimo contacto</span><br />{formatDateTime(crmDetail.contact.last_contacted_at)}</p>}
                        {crmDetail.contact.next_follow_up_at && <p><span class="font-mono text-xs uppercase text-[#006064]/60">Proximo seguimiento</span><br />{formatDateTime(crmDetail.contact.next_follow_up_at)}</p>}
                    </div>
                </div>

                <div>
                    <h3 class="font-display text-lg text-[#006064] uppercase mb-3">Pipeline abierto</h3>
                    <CrmOpportunityList client:load opportunities={openOpportunities} lang={lang} />
                </div>

                <div>
                    <h3 class="font-display text-lg text-[#006064] uppercase mb-3">Tareas abiertas</h3>
                    <CrmTaskList client:load tasks={openTasks} emptyText="Sin tareas activas." />
                </div>

                <div class="border-t border-[#006064]/20 pt-5 lg:col-span-3">
                    <CrmConsentManager
                        client:load
                        contactId={crmDetail.contact.id}
                        consents={crmDetail.consents}
                    />
                </div>

                <div class="border-t border-[#006064]/20 pt-5 lg:col-span-3">
                    <CrmContactActions
                        client:load
                        contactId={crmDetail.contact.id}
                        opportunityId={openOpportunities[0]?.id ?? null}
                    />
                </div>
            </div>
        ) : (
            <div class="bg-[#E0F7FA] border border-[#006064] p-4">
                <p class="font-bold text-[#006064]">Sin contacto CRM enlazado</p>
                <p class="text-sm text-[#006064]/70 mt-1">El alumno existe, pero todavia no tiene registro CRM. El backfill de la migracion lo creara por perfil o email.</p>
            </div>
        )}
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <!-- Current Subscription -->
        <div class="bg-white p-6 border-2 border-[#006064] shadow-[4px_4px_0px_0px_#006064]">
            <h2 class="font-display text-xl text-[#006064] uppercase mb-4">Plan Actual</h2>
            
            {subscriptionError ? (
                <CampusLoadError lang={lang} />
            ) : subscription ? (
                <div class="space-y-4">
                    <div>
                        <p class="text-2xl font-display text-[#006064]">{getPackageName(subscription)}</p>
                        <p class="text-sm text-[#006064]/60">
                            {formatDate(subscription.starts_at)} — {formatDate(subscription.ends_at)}
                        </p>
                    </div>
                    
                    {cycleProgressLoadError || cycleProgressContractError ? (
                        <CampusLoadError lang={lang} />
                    ) : subscription.contract_schema_version !== 2 ? (
                        <p class="text-sm text-[#006064]/70">
                            {t('campus.dashboard.progressUnavailable')}
                        </p>
                    ) : currentCyclePresentation?.state === 'pending' ? (
                        <p class="text-sm text-[#006064]/70">
                            {t('campus.dashboard.progressPending')}
                        </p>
                    ) : currentCyclePresentation?.state === 'ready' ? (
                        <div>
                            <div class="flex justify-between text-sm mb-1">
                                <span class="font-mono">Clases consumidas</span>
                                <span class="font-bold">{currentCyclePresentation.consumed} / {currentCyclePresentation.total}</span>
                            </div>
                            <ProgressBar
                                value={currentCyclePresentation.consumed}
                                max={currentCyclePresentation.total}
                                label="Clases consumidas"
                            />
                        </div>
                    ) : (
                        <p class="text-sm text-[#006064]/70">
                            {t('campus.dashboard.progressUnavailable')}
                        </p>
                    )}
                </div>
            ) : (
                <p class="text-[#006064]/60 font-mono">Sin plan activo</p>
            )}
        </div>

        <!-- Assigned Teacher -->
        <div class="bg-white p-6 border-2 border-[#006064] shadow-[4px_4px_0px_0px_#006064]">
            <h2 class="font-display text-xl text-[#006064] uppercase mb-4">Profesor Asignado</h2>
            
            {teacher ? (
                <div class="flex items-center justify-between">
                    <div>
                        <p class="font-bold text-[#006064]">{teacher.full_name}</p>
                        <p class="text-sm text-[#006064]/60">{teacher.email}</p>
                    </div>
                    <a 
                        href={`/${lang}/campus/teacher/student/${studentId}`}
                        class="px-3 py-1 text-xs font-bold text-[#006064] border border-[#006064] hover:bg-[#006064] hover:text-white transition-colors"
                    >
                        Ver como profesor
                    </a>
                </div>
            ) : (
                <div>
                    <p class="text-[#006064]/60 font-mono mb-4">Sin profesor asignado</p>
                </div>
            )}
            
            <div class="mt-4 pt-4 border-t border-[#006064]/20">
                <AssignTeacherButton
                    client:load
                    studentId={studentId}
                    studentName={student.full_name || student.email}
                    currentTeacherId={teacher?.id}
                    teachers={allTeachers || []}
                    buttonText={teacher ? t('campus.admin.assignTeacher.title') : t('campus.admin.students.assignTeacher')}
                    translations={assignModalTranslations}
                />
            </div>
        </div>

        <!-- Notes -->
        <div class="bg-white p-6 border-2 border-[#006064] shadow-[4px_4px_0px_0px_#006064]">
            <h2 class="font-display text-xl text-[#006064] uppercase mb-4">Notas Internas</h2>
            
            <TeacherNotes 
                client:load
                studentId={studentId}
                initialNotes={studentPrivate?.notes || ''}
                translations={{
                    placeholder: t('campus.teacher.notesPlaceholder'),
                    save: t('campus.teacher.saveNotes'),
                    saved: t('campus.teacher.notesSaved'),
                }}
            />
        </div>

        <!-- Payment History -->
        <div class="bg-white p-6 border-2 border-[#006064] shadow-[4px_4px_0px_0px_#006064]">
            <div class="mb-4 flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
                <h2 class="font-display text-xl text-[#006064] uppercase">Historial de Pagos</h2>
                <a
                    href={`/${lang}/campus/admin/guarantees?studentId=${studentId}`}
                    class="text-xs font-bold uppercase text-[#006064] underline"
                >
                    Ver garantías
                </a>
            </div>
            
            {payments && payments.length > 0 ? (
                <div class="space-y-2">
                    {payments.map(payment => (
                        <div class="flex items-center justify-between py-2 border-b border-[#006064]/10 last:border-0">
                            <div>
                                <p class="text-sm text-[#006064]/60">{formatDate(payment.created_at)}</p>
                            </div>
                            <div class="flex items-center gap-2">
                                <span class={`px-2 py-0.5 text-xs font-bold rounded ${
                                    payment.status === 'succeeded' && payment.amount_refunded === 0
                                        ? 'bg-green-100 text-green-700'
                                        : payment.status === 'refunded'
                                            ? 'bg-yellow-100 text-yellow-800'
                                            : 'bg-gray-100 text-gray-700'
                                }`}>
                                    {payment.status}
                                </span>
                                <div class="text-right font-mono text-xs text-[#006064]">
                                    <p>Bruto: <strong>{formatCurrency(payment.amount)}</strong></p>
                                    <p>Devuelto: <strong>{formatCurrency(payment.amount_refunded || 0)}</strong></p>
                                    <p>Neto: <strong>{formatCurrency(Math.max(0, payment.amount - (payment.amount_refunded || 0)))}</strong></p>
                                </div>
                            </div>
                        </div>
                    ))}
                </div>
            ) : (
                <p class="text-[#006064]/60 font-mono text-sm">Sin pagos registrados</p>
            )}
        </div>

        <!-- Subscription History -->
        <div class="bg-white p-6 border-2 border-[#006064] shadow-[4px_4px_0px_0px_#006064] lg:col-span-2">
            <h2 class="font-display text-xl text-[#006064] uppercase mb-4">Historial de Suscripciones</h2>
            
            {cycleProgressLoadError || cycleProgressContractError ? (
                <CampusLoadError lang={lang} />
            ) : subscriptionCycleHistory.length > 0 ? (
                <div class="overflow-x-auto">
                    <table class="w-full text-sm">
                        <thead>
                            <tr class="border-b-2 border-[#006064]">
                                <th class="text-left py-2 font-mono text-xs uppercase text-[#006064]/60">Plan</th>
                                <th class="text-left py-2 font-mono text-xs uppercase text-[#006064]/60">Ciclo</th>
                                <th class="text-left py-2 font-mono text-xs uppercase text-[#006064]/60">Periodo</th>
                                <th class="text-left py-2 font-mono text-xs uppercase text-[#006064]/60">Clases consumidas</th>
                                <th class="text-left py-2 font-mono text-xs uppercase text-[#006064]/60">Estado</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-[#006064]/10">
                            {subscriptionCycleHistory.map(({ subscription: sub, progress, academicProgress }) => (
                                <tr>
                                    <td class="py-2 font-bold text-[#006064]">{getPackageName(sub)}</td>
                                    <td class="py-2 text-[#006064]/70">
                                        {progress?.cycle_number ? `#${progress.cycle_number}` : '—'}
                                    </td>
                                    <td class="py-2 text-[#006064]/70">
                                        {formatDate(progress?.starts_at ?? sub.starts_at)} — {formatDate(progress?.ends_at ?? sub.ends_at)}
                                    </td>
                                    <td class="py-2 text-[#006064]/70">
                                        {academicProgress.state === 'ready'
                                            ? `${academicProgress.consumed} / ${academicProgress.total}`
                                            : academicProgress.state === 'pending'
                                                ? t('campus.dashboard.progressPending')
                                                : t('campus.dashboard.progressUnavailable')}
                                    </td>
                                    <td class="py-2">
                                        <span class={`px-2 py-0.5 text-xs font-bold rounded ${
                                            sub.status === 'active' ? 'bg-green-100 text-green-700' :
                                            sub.status === 'expired' ? 'bg-gray-100 text-gray-700' :
                                            'bg-yellow-100 text-yellow-700'
                                        }`}>
                                            {sub.status}
                                        </span>
                                    </td>
                                </tr>
                            ))}
                        </tbody>
                    </table>
                </div>
            ) : (
                <p class="text-[#006064]/60 font-mono text-sm">Sin historial de suscripciones</p>
            )}
        </div>

        <!-- Unified Timeline -->
        <div class="bg-white p-6 border-2 border-[#006064] shadow-[4px_4px_0px_0px_#006064] lg:col-span-2">
            <div class="flex flex-col gap-2 md:flex-row md:items-center md:justify-between mb-4">
                <h2 class="font-display text-xl text-[#006064] uppercase">Historial CRM unificado</h2>
                <p class="text-xs font-mono uppercase text-[#006064]/60">{timelineItems.length} eventos visibles</p>
            </div>

            {timelineItems.length > 0 ? (
                <div class="divide-y divide-[#006064]/10">
                    {timelineItems.map((item) => (
                        <div class="grid grid-cols-1 gap-2 py-3 md:grid-cols-[8rem_1fr_auto] md:items-start">
                            <div>
                                <span class="inline-flex border border-[#006064] px-2 py-1 text-xs font-bold uppercase text-[#006064]">{item.kind}</span>
                            </div>
                            <div>
                                <p class="font-bold text-[#006064]">{item.title}</p>
                                {item.detail && <p class="text-sm text-[#006064]/70 mt-1">{item.detail}</p>}
                            </div>
                            <p class="text-xs font-mono text-[#006064]/70 md:text-right">{formatDateTime(item.date)}</p>
                        </div>
                    ))}
                </div>
            ) : (
                <p class="text-[#006064]/60 font-mono text-sm">Sin eventos todavia.</p>
            )}
        </div>
    </div>
</CampusLayout>
