---
import CampusLayout from '../../../../layouts/CampusLayout.astro';
import CampusLoadError from '../../../../components/campus/CampusLoadError.astro';
import { useTranslations } from '../../../../i18n/utils';
import { reportCampusReadError } from '../../../../lib/campus-load-state';
import {
    loadLatestCheckoutV2Progress,
    resolveCheckoutV2AcademicProgress,
    type CheckoutV2CycleProgress,
} from '../../../../lib/checkout-v2-progress';
import { getPrivateProfiles } from '../../../../lib/profiles-private';
import { createSupabaseAdminClient } from '../../../../lib/supabase-admin';
import { createSupabaseServerClient } from '../../../../lib/supabase-server';
import type { Json } from '../../../../types/database.types';

export const prerender = false;

const { lang } = Astro.params as { lang: 'es' | 'en' | 'ru' };
const t = useTranslations(lang);

// Get Supabase client and user
const supabase = createSupabaseServerClient(Astro);
const { data: { user } } = await supabase.auth.getUser();

if (!user) {
    return Astro.redirect(`/${lang}/login`);
}

// Get profile with role
const { data: profile } = await supabase
    .from('profiles')
    .select('id, email, full_name, role, preferred_language, phone, timezone')
    .eq('id', user.id)
    .single();

// Check if user is teacher or admin
if (!profile || (profile.role !== 'teacher' && profile.role !== 'admin')) {
    return Astro.redirect(`/${lang}/campus`);
}

const supabaseAdmin = createSupabaseAdminClient();

// Get assigned students with subscriptions
const { data: students, error: studentsError } = await supabase
    .from('student_teachers')
    .select(`
        student_id,
        is_primary,
        profiles!student_teachers_student_id_fkey (
            id,
            full_name,
            email,
            phone,
            preferred_language
        )
    `)
    .eq('teacher_id', user.id);

if (studentsError) {
    reportCampusReadError('teacher_dashboard.students', studentsError);
    Astro.response.status = 503;
}

const assignedStudents = (students ?? []).filter((assignment: any) => assignment.profiles);
const assignedStudentIds = assignedStudents.map((assignment: any) => assignment.profiles.id);
const assignedStudentIdBatches = Array.from(
    { length: Math.ceil(assignedStudentIds.length / 100) },
    (_, index) => assignedStudentIds.slice(index * 100, (index + 1) * 100),
);
let privateProfiles: Awaited<ReturnType<typeof getPrivateProfiles>> = new Map();
let privateProfilesFailed = false;

try {
    const privateProfileBatches = await Promise.all(
        assignedStudentIdBatches.map((studentIds) => getPrivateProfiles(studentIds, supabaseAdmin)),
    );
    for (const batch of privateProfileBatches) {
        for (const [profileId, profilePrivate] of batch) {
            privateProfiles.set(profileId, profilePrivate);
        }
    }
} catch (error) {
    privateProfilesFailed = true;
    reportCampusReadError('teacher_dashboard.private_profiles', error);
    Astro.response.status = 503;
}

type TeacherProgress =
    | { status: 'ready'; consumed: number; total: number }
    | { status: 'pending' | 'legacy' | 'error' | 'none' };

type ActiveSubscription = {
    id: string;
    student_id: string;
    status: string | null;
    contract_schema_version: number | null;
    ends_at: string | null;
    packages: { name: string; display_name: Json } | null;
};

let activeSubscriptionRows: ActiveSubscription[] = [];
let subscriptionBatchFailed = false;

if (assignedStudentIdBatches.length > 0) {
    const subscriptionResults = await Promise.all(assignedStudentIdBatches.map((studentIds) => (
        supabase
            .from('subscriptions')
            .select(`
                id,
                student_id,
                status,
                contract_schema_version,
                ends_at,
                packages (
                    name,
                    display_name
                )
            `)
            .in('student_id', studentIds)
            .eq('status', 'active')
            .order('created_at', { ascending: false })
    )));
    const subscriptionsError = subscriptionResults.find((result) => result.error)?.error;

    if (subscriptionsError) {
        subscriptionBatchFailed = true;
        reportCampusReadError('teacher_dashboard.subscriptions', subscriptionsError);
        Astro.response.status = 503;
    } else {
        activeSubscriptionRows = subscriptionResults.flatMap((result) => (
            (result.data ?? []) as ActiveSubscription[]
        ));
    }
}

const activeSubscriptionByStudent = new Map<string, ActiveSubscription>();
for (const subscription of activeSubscriptionRows) {
    if (!activeSubscriptionByStudent.has(subscription.student_id)) {
        activeSubscriptionByStudent.set(subscription.student_id, subscription);
    }
}

const studentsWithSubs = assignedStudents.map((assignment: any) => {
    const studentProfile = assignment.profiles;
    return {
        ...studentProfile,
        ...privateProfiles.get(studentProfile.id),
        subscription: activeSubscriptionByStudent.get(studentProfile.id) ?? null,
        isPrimary: assignment.is_primary,
    };
});

const checkoutV2SubscriptionIds = studentsWithSubs
    .map((student) => student.subscription)
    .filter((subscription): subscription is NonNullable<typeof subscription> => (
        subscription?.contract_schema_version === 2
    ))
    .map((subscription) => subscription.id);

let progressBySubscription = new Map<string, CheckoutV2CycleProgress>();
let progressBatchFailed = false;

if (checkoutV2SubscriptionIds.length > 0) {
    try {
        progressBySubscription = await loadLatestCheckoutV2Progress(
            supabaseAdmin,
            checkoutV2SubscriptionIds,
        );
    } catch (error) {
        progressBatchFailed = true;
        reportCampusReadError('teacher_dashboard.cycle_progress', error);
        Astro.response.status = 503;
    }
}

const studentsWithProgress = studentsWithSubs.map((student) => {
    const subscription = student.subscription;
    let progress: TeacherProgress = { status: 'none' };

    if (subscriptionBatchFailed) {
        progress = { status: 'error' };
    } else if (subscription?.contract_schema_version !== 2) {
        progress = subscription ? { status: 'legacy' } : { status: 'none' };
    } else if (progressBatchFailed) {
        progress = { status: 'error' };
    } else {
        const cycleProgress = progressBySubscription.get(subscription.id);
        const resolvedProgress = resolveCheckoutV2AcademicProgress(
            subscription.contract_schema_version,
            cycleProgress,
        );

        if (resolvedProgress.state === 'ready') {
            progress = {
                status: 'ready',
                consumed: resolvedProgress.consumed,
                total: resolvedProgress.total,
            };
        } else if (resolvedProgress.state === 'pending') {
            progress = { status: 'pending' };
        } else {
            const code = resolvedProgress.state === 'missing'
                ? 'CHECKOUT_V2_PROGRESS_MISSING'
                : 'CHECKOUT_V2_PROGRESS_INCONSISTENT';
            reportCampusReadError('teacher_dashboard.cycle_progress', { code });
            Astro.response.status = 503;
            progress = { status: 'error' };
        }
    }

    return { ...student, progress };
});

// Calculate stats
const totalStudents = studentsWithProgress.length;
const activeStudents = studentsWithProgress.filter(s => s.subscription?.status === 'active').length;
const teacherRosterLoadError = Boolean(
    studentsError || privateProfilesFailed || subscriptionBatchFailed,
);

// Get historical completed sessions by this teacher
const { count: completedSessionsCount, error: completedSessionsError } = await supabase
    .from('sessions')
    .select('*', { count: 'exact', head: true })
    .eq('teacher_id', user.id)
    .eq('status', 'completed');

if (completedSessionsError) {
    reportCampusReadError('teacher_dashboard.completed_sessions', completedSessionsError);
    Astro.response.status = 503;
}

// Helper functions
const getPackageName = (sub: any) => {
    if (!sub?.packages?.display_name) return t('campus.teacher.noPlan');
    const displayName = sub.packages.display_name;
    return displayName[lang] || displayName['es'] || sub.packages.name;
};

const getStatusBadge = (sub: any) => {
    if (!sub) return { text: t('campus.teacher.noPlan'), color: 'bg-gray-200 text-gray-700' };
    
    const endsAt = new Date(sub.ends_at);
    const now = new Date();
    const daysUntilExpiry = Math.ceil((endsAt.getTime() - now.getTime()) / (1000 * 60 * 60 * 24));
    
    if (daysUntilExpiry <= 7) {
        return { text: `${t('campus.teacher.expiresOn')} ${daysUntilExpiry}d`, color: 'bg-yellow-100 text-yellow-800 border-yellow-300' };
    }
    return { text: 'Activo', color: 'bg-green-100 text-green-800 border-green-300' };
};
---

<CampusLayout 
    title={`${t('campus.teacher.title')} | Español Honesto`} 
    user={{ ...user, ...profile }}
    lang={lang}
>
    <!-- Header with Stats -->
    <div class="mb-8">
        <h1 class="font-display text-4xl text-[#006064] uppercase mb-4">{t('campus.teacher.title')}</h1>
        
        <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
            <div class="bg-white p-4 border-2 border-[#006064] shadow-[4px_4px_0px_0px_#006064]">
                <p class="text-3xl font-display text-[#006064]">{teacherRosterLoadError ? '—' : totalStudents}</p>
                <p class="text-xs font-mono uppercase text-[#006064]/60">{t('campus.teacher.totalStudents')}</p>
            </div>
            <div class="bg-white p-4 border-2 border-[#006064] shadow-[4px_4px_0px_0px_#006064]">
                <p class="text-3xl font-display text-[#006064]">{teacherRosterLoadError ? '—' : activeStudents}</p>
                <p class="text-xs font-mono uppercase text-[#006064]/60">{t('campus.teacher.activeStudents')}</p>
            </div>
            <div class="bg-white p-4 border-2 border-[#006064] shadow-[4px_4px_0px_0px_#006064]">
                <p class="text-3xl font-display text-[#006064]">{completedSessionsError ? '—' : completedSessionsCount ?? 0}</p>
                <p class="text-xs font-mono uppercase text-[#006064]/60">{t('campus.teacher.sessions')}</p>
            </div>
        </div>
        {completedSessionsError && (
            <div class="mt-5">
                <CampusLoadError lang={lang} title={t('campus.teacher.sessions')} />
            </div>
        )}
    </div>

    <!-- Search Bar -->
    <div class="mb-6">
        <input 
            type="text" 
            id="student-search"
            placeholder={t('campus.teacher.search')}
            class="w-full md:w-96 p-3 border-2 border-[#006064] focus:outline-none focus:ring-2 focus:ring-[#006064]/20 font-sans text-[#006064] placeholder-[#006064]/40"
        />
    </div>

    {progressBatchFailed && (
        <div class="mb-6">
            <CampusLoadError lang={lang} title={t('campus.dashboard.sessions')} />
        </div>
    )}

    <!-- Students List -->
    {teacherRosterLoadError ? (
        <CampusLoadError lang={lang} title={t('campus.teacher.title')} />
    ) : studentsWithProgress.length === 0 ? (
        <div class="bg-white p-12 border-2 border-[#006064] shadow-[4px_4px_0px_0px_#006064] text-center">
            <p class="text-[#006064]/60 font-mono">{t('campus.teacher.noStudents')}</p>
        </div>
    ) : (
        <div class="space-y-4" id="students-container">
            {studentsWithProgress.map((student) => {
                const status = getStatusBadge(student.subscription);
                const packageName = getPackageName(student.subscription);
                const driveFolderUrl = student.drive_folder_url || (student.drive_folder_id ? `https://drive.google.com/drive/folders/${student.drive_folder_id}` : null);
                
                return (
                    <div 
                        class="bg-white p-6 border-2 border-[#006064] shadow-[4px_4px_0px_0px_#006064] student-card"
                        data-name={student.full_name?.toLowerCase() || ''}
                        data-email={student.email?.toLowerCase() || ''}
                    >
                        <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
                            <!-- Student Info -->
                            <div class="flex-1">
                                <div class="flex items-center gap-3 mb-2">
                                    <h3 class="font-display text-xl text-[#006064]">
                                        {student.full_name || student.email}
                                    </h3>
                                    <span class={`px-2 py-0.5 text-xs font-bold uppercase border ${status.color}`}>
                                        {status.text}
                                    </span>
                                </div>
                                <p class="text-sm text-[#006064]/60 font-mono">{student.email}</p>
                                {student.phone && (
                                    <p class="text-sm text-[#006064]/60">{student.phone}</p>
                                )}
                            </div>
                            
                            <!-- Subscription Info -->
                            <div class="flex-shrink-0 text-left md:text-right">
                                <p class="font-bold text-[#006064]">{packageName}</p>
                                {student.progress.status === 'ready' && (
                                    <p class="text-sm text-[#006064]/60">
                                        {t('campus.dashboard.sessions')}: {student.progress.consumed}/{student.progress.total} {t('campus.dashboard.sessionsUsed')}
                                    </p>
                                )}
                                {student.progress.status === 'pending' && (
                                    <p class="text-sm text-[#006064]/70" role="status">
                                        {t('campus.dashboard.progressPending')}
                                    </p>
                                )}
                                {student.progress.status === 'legacy' && (
                                    <p class="text-sm text-[#006064]/70" role="status">
                                        {t('campus.dashboard.progressUnavailable')}
                                    </p>
                                )}
                                {student.progress.status === 'error' && !progressBatchFailed && (
                                    <p class="mt-2 text-sm text-red-700" role="alert">
                                        {t('campus.dashboard.progressUnavailable')}
                                    </p>
                                )}
                            </div>
                            
                            <!-- Actions -->
                            <div class="flex gap-2 flex-shrink-0">
                                <a 
                                    href={`/${lang}/campus/teacher/student/${student.id}`}
                                    class="px-4 py-2 bg-[#006064] text-white text-xs font-bold uppercase border border-[#006064] hover:bg-[#004d40] transition-colors"
                                >
                                    {t('campus.teacher.viewDetails')}
                                </a>
                                {driveFolderUrl && (
                                    <a 
                                        href={driveFolderUrl}
                                        target="_blank"
                                        rel="noopener noreferrer"
                                        class="px-4 py-2 bg-[#E0F7FA] text-[#006064] text-xs font-bold uppercase border border-[#006064] hover:bg-[#006064] hover:text-white transition-colors"
                                    >
                                        {t('campus.teacher.openDrive')}
                                    </a>
                                )}
                            </div>
                        </div>
                    </div>
                );
            })}
        </div>
    )}
</CampusLayout>

<script>
    // Client-side search filtering
    const searchInput = document.getElementById('student-search') as HTMLInputElement;
    const studentCards = document.querySelectorAll('.student-card');

    if (searchInput) {
        searchInput.addEventListener('input', (e) => {
            const query = (e.target as HTMLInputElement).value.toLowerCase();
            
            studentCards.forEach((card) => {
                const name = card.getAttribute('data-name') || '';
                const email = card.getAttribute('data-email') || '';
                
                (card as HTMLElement).hidden = !(name.includes(query) || email.includes(query));
            });
        });
    }
</script>
