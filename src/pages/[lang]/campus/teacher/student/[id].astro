---
import CampusLayout from '../../../../../layouts/CampusLayout.astro';
import CampusLoadError from '../../../../../components/campus/CampusLoadError.astro';
import { getLangFromParam, useTranslations } from '../../../../../i18n/utils';
import { reportCampusReadError } from '../../../../../lib/campus-load-state';
import {
    loadCheckoutV2ProgressForSubscription,
    resolveCheckoutV2AcademicProgress,
} from '../../../../../lib/checkout-v2-progress';
import { getPrivateProfile } from '../../../../../lib/profiles-private';
import { createSupabaseAdminClient } from '../../../../../lib/supabase-admin';
import { createSupabaseServerClient } from '../../../../../lib/supabase-server';
import TeacherNotes from '../../../../../components/TeacherNotes';
import ProgressBar from '../../../../../components/ProgressBar.astro';
import type { Json } from '../../../../../types/database.types';

export const prerender = false;

const lang = getLangFromParam(Astro.params.lang);
const studentId = Astro.params.id;

if (!studentId) {
    return Astro.redirect(`/${lang}/campus/teacher`);
}

const t = useTranslations(lang);

// Get Supabase client and user
const supabase = createSupabaseServerClient(Astro);
const { data: { user } } = await supabase.auth.getUser();

if (!user) {
    return Astro.redirect(`/${lang}/login`);
}

// Get current user's profile with role
const { data: currentProfile } = await supabase
    .from('profiles')
    .select('role')
    .eq('id', user.id)
    .single();

// Check if user is teacher or admin
if (!currentProfile || (currentProfile.role !== 'teacher' && currentProfile.role !== 'admin')) {
    return Astro.redirect(`/${lang}/campus`);
}

// If not admin, verify student is assigned to this teacher
if (currentProfile.role !== 'admin') {
    const { data: assignment } = await supabase
        .from('student_teachers')
        .select('id')
        .eq('teacher_id', user.id)
        .eq('student_id', studentId)
        .single();

    if (!assignment) {
        return Astro.redirect(`/${lang}/campus/teacher`);
    }
}

// Get student profile
const { data: student, error: studentError } = await supabase
    .from('profiles')
    .select('id, email, full_name, phone, preferred_language')
    .eq('id', studentId)
    .single();

if (studentError || !student) {
    return Astro.redirect(`/${lang}/campus/teacher`);
}

const studentPrivate = await getPrivateProfile(studentId);
const driveFolderUrl = studentPrivate?.drive_folder_url
    || (studentPrivate?.drive_folder_id ? `https://drive.google.com/drive/folders/${studentPrivate.drive_folder_id}` : null);

// Get active subscription with package info
const { data: subscription, error: subscriptionError } = await supabase
    .from('subscriptions')
    .select(`
        id,
        status,
        starts_at,
        ends_at,
        contract_schema_version,
        packages (
            name,
            display_name
        )
    `)
    .eq('student_id', studentId)
    .eq('status', 'active')
    .order('created_at', { ascending: false })
    .limit(1)
    .maybeSingle();

if (subscriptionError) {
    reportCampusReadError('teacher_student.subscription', subscriptionError);
    Astro.response.status = 503;
}

type TeacherProgress =
    | { status: 'ready'; consumed: number; total: number; cycleId: string }
    | { status: 'pending' | 'legacy' | 'error' | 'none' };

type UpcomingCycleSession = {
    id: string;
    scheduled_at: string;
    duration_minutes: number;
    meet_link: string | null;
};

let progress: TeacherProgress = subscription ? { status: 'legacy' } : { status: 'none' };
let upcomingSessions: UpcomingCycleSession[] = [];
let upcomingSessionsError = false;

if (subscription?.contract_schema_version === 2) {
    try {
        const cycleProgress = await loadCheckoutV2ProgressForSubscription(
            createSupabaseAdminClient(),
            subscription.id,
        );
        const resolvedProgress = resolveCheckoutV2AcademicProgress(
            subscription.contract_schema_version,
            cycleProgress,
        );

        if (resolvedProgress.state === 'ready' && cycleProgress?.cycle_id) {
            progress = {
                status: 'ready',
                consumed: resolvedProgress.consumed,
                total: resolvedProgress.total,
                cycleId: cycleProgress.cycle_id,
            };
        } else if (resolvedProgress.state === 'pending') {
            progress = { status: 'pending' };
        } else {
            const code = resolvedProgress.state === 'missing'
                ? 'CHECKOUT_V2_PROGRESS_MISSING'
                : 'CHECKOUT_V2_PROGRESS_INCONSISTENT';
            reportCampusReadError('teacher_student.cycle_progress', { code });
            Astro.response.status = 503;
            progress = { status: 'error' };
        }
    } catch (error) {
        reportCampusReadError('teacher_student.cycle_progress', error);
        Astro.response.status = 503;
        progress = { status: 'error' };
    }
}

if (progress.status === 'ready') {
    let upcomingQuery = supabase
        .from('sessions')
        .select('id, scheduled_at, duration_minutes, meet_link')
        .eq('student_id', studentId)
        .eq('checkout_v2_cycle_id', progress.cycleId)
        .eq('status', 'scheduled')
        .gte('scheduled_at', new Date().toISOString())
        .order('scheduled_at', { ascending: true });

    if (currentProfile.role === 'teacher') {
        upcomingQuery = upcomingQuery.eq('teacher_id', user.id);
    }

    const upcomingResult = await upcomingQuery;
    if (upcomingResult.error) {
        reportCampusReadError('teacher_student.upcoming_sessions', upcomingResult.error);
        upcomingSessionsError = true;
    } else {
        upcomingSessions = upcomingResult.data ?? [];
    }
}

// Helper function for package name
type SubscriptionPackage = {
    packages: {
        name: string;
        display_name: Json;
    } | null;
};

const localizedPackageName = (displayName: Json): string | null => {
    if (!displayName || typeof displayName !== 'object' || Array.isArray(displayName)) return null;
    const localized = displayName[lang];
    if (typeof localized === 'string') return localized;
    const spanish = displayName.es;
    return typeof spanish === 'string' ? spanish : null;
};

const getPackageName = (sub: SubscriptionPackage | null | undefined) => {
    if (!sub?.packages?.display_name) return t('campus.teacher.noPlan');
    return localizedPackageName(sub.packages.display_name) || sub.packages.name;
};

// Format dates
const formatDate = (dateStr: string) => {
    if (!dateStr) return '—';
    return new Date(dateStr).toLocaleDateString(lang === 'es' ? 'es-ES' : lang === 'ru' ? 'ru-RU' : 'en-US');
};

const formatSessionWhen = (dateStr: string) => {
    return new Date(dateStr).toLocaleString(
        lang === 'es' ? 'es-ES' : lang === 'ru' ? 'ru-RU' : 'en-US',
        {
            timeZone: 'Europe/Madrid',
            weekday: 'short',
            day: 'numeric',
            month: 'short',
            hour: '2-digit',
            minute: '2-digit',
        },
    );
};

// Language display
const languageNames: Record<string, string> = {
    es: 'Español',
    en: 'English',
    ru: 'Русский'
};
---

<CampusLayout 
    title={`${student.full_name || student.email} | Español Honesto`}
    user={{ ...user, ...currentProfile }}
    lang={lang}
>
    <!-- Header -->
    <div class="mb-8">
        <a 
            href={`/${lang}/campus/teacher`}
            class="inline-flex items-center gap-2 text-[#006064] hover:opacity-70 transition-opacity mb-4 font-mono text-sm"
        >
            ← {t('campus.teacher.back')}
        </a>
        
        <h1 class="font-display text-4xl text-[#006064] mb-2">
            {student.full_name || student.email}
        </h1>
        
        <div class="flex flex-wrap gap-4 text-sm text-[#006064]/70">
            <span>{student.email}</span>
            {student.phone && <span>• {student.phone}</span>}
            {student.preferred_language && (
                <span>• {languageNames[student.preferred_language] || student.preferred_language}</span>
            )}
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <!-- Current Plan Card -->
        <div class="bg-white p-6 border-2 border-[#006064] shadow-[4px_4px_0px_0px_#006064]">
            <h2 class="font-display text-xl text-[#006064] uppercase mb-4">
                {t('campus.teacher.currentPlan')}
            </h2>
            
            {subscriptionError ? (
                <CampusLoadError lang={lang} title={t('campus.teacher.currentPlan')} />
            ) : subscription ? (
                <div class="space-y-4">
                    <div>
                        <p class="text-2xl font-display text-[#006064]">{getPackageName(subscription)}</p>
                        <p class="text-sm text-[#006064]/60">
                            {formatDate(subscription.starts_at)} — {formatDate(subscription.ends_at)}
                        </p>
                    </div>
                    
                    {progress.status === 'ready' && (
                    <div>
                        <div class="flex justify-between text-sm mb-1">
                            <span class="font-mono">{t('campus.dashboard.sessions')}</span>
                            <span class="font-bold">{progress.consumed} / {progress.total} {t('campus.dashboard.sessionsUsed')}</span>
                        </div>
                        <ProgressBar
                            value={progress.consumed}
                            max={progress.total}
                            label={t('campus.dashboard.sessions')}
                        />
                    </div>
                    )}
                    {progress.status === 'pending' && (
                        <p class="text-sm text-[#006064]/70" role="status">
                            {t('campus.dashboard.progressPending')}
                        </p>
                    )}
                    {progress.status === 'legacy' && (
                        <p class="text-sm text-[#006064]/70" role="status">
                            {t('campus.dashboard.progressUnavailable')}
                        </p>
                    )}
                    {progress.status === 'error' && (
                        <CampusLoadError lang={lang} title={t('campus.dashboard.sessions')} />
                    )}
                </div>
            ) : (
                <p class="text-[#006064]/60 font-mono">{t('campus.teacher.noPlan')}</p>
            )}
        </div>

        <!-- Materials Folder Card -->
        <div class="bg-white p-6 border-2 border-[#006064] shadow-[4px_4px_0px_0px_#006064]">
            <h2 class="font-display text-xl text-[#006064] uppercase mb-4">
                {t('campus.teacher.materials')}
            </h2>
            
            {driveFolderUrl ? (
                <a 
                    href={driveFolderUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-2 px-6 py-3 bg-[#006064] text-white font-bold uppercase text-sm border-2 border-[#006064] shadow-[4px_4px_0px_0px_#004d40] hover:shadow-none hover:translate-x-[2px] hover:translate-y-[2px] transition-all"
                >
                    📁 {t('campus.teacher.openDrive')}
                </a>
            ) : (
                <p class="text-[#006064]/60 font-mono">{t('campus.dashboard.folderPending')}</p>
            )}
        </div>

        <!-- Upcoming classes -->
        <div class="bg-white p-6 border-2 border-[#006064] shadow-[4px_4px_0px_0px_#006064] lg:col-span-2">
            <h2 class="font-display text-xl text-[#006064] uppercase mb-4">
                {t('campus.teacher.upcomingClasses')}
            </h2>

            {upcomingSessionsError ? (
                <CampusLoadError lang={lang} title={t('campus.teacher.upcomingClasses')} />
            ) : progress.status !== 'ready' ? (
                <p class="text-[#006064]/60 font-mono" role="status">
                    {t('campus.student.classes.noUpcoming')}
                </p>
            ) : upcomingSessions.length === 0 ? (
                <p class="text-[#006064]/60 font-mono" role="status">
                    {t('campus.student.classes.noUpcoming')}
                </p>
            ) : (
                <ul class="space-y-3">
                    {upcomingSessions.map((session) => (
                        <li class="flex flex-wrap items-center justify-between gap-3 border border-[#006064]/20 px-4 py-3">
                            <div>
                                <p class="font-mono text-sm text-[#006064]">
                                    {formatSessionWhen(session.scheduled_at)}
                                </p>
                                <p class="text-xs text-[#006064]/60">
                                    {session.duration_minutes} min
                                </p>
                            </div>
                            {session.meet_link ? (
                                <a
                                    href={session.meet_link}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    class="inline-flex items-center px-4 py-2 bg-[#006064] text-white font-bold uppercase text-xs border-2 border-[#006064] shadow-[3px_3px_0px_0px_#004d40] hover:shadow-none hover:translate-x-[1px] hover:translate-y-[1px] transition-all"
                                >
                                    {t('campus.teacher.calendar.meetLink')}
                                </a>
                            ) : (
                                <span class="text-xs font-mono text-[#006064]/60">
                                    {t('campus.dashboard.folderPending')}
                                </span>
                            )}
                        </li>
                    ))}
                </ul>
            )}
        </div>

        <!-- Notes Card -->
        <div class="bg-white p-6 border-2 border-[#006064] shadow-[4px_4px_0px_0px_#006064] lg:col-span-2">
            <h2 class="font-display text-xl text-[#006064] uppercase mb-4">
                {t('campus.teacher.notes')}
            </h2>
            
            <TeacherNotes 
                client:load
                studentId={studentId}
                initialNotes={studentPrivate?.notes || ''}
                translations={{
                    placeholder: t('campus.teacher.notesPlaceholder'),
                    save: t('campus.teacher.saveNotes'),
                    saved: t('campus.teacher.notesSaved'),
                }}
            />
        </div>

    </div>
</CampusLayout>
