---
import CampusLayout from '../../../../layouts/CampusLayout.astro';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { getLangFromParam, useTranslations, type SupportedLang } from '../../../../i18n/utils';
import { createSupabaseServerClient } from '../../../../lib/supabase-server';
import TeacherCalendar from '../../../../components/calendar/TeacherCalendar';
import AvailabilityManager from '../../../../components/calendar/AvailabilityManager';
import CampusLoadError from '../../../../components/campus/CampusLoadError.astro';
import {
    reportCampusReadError,
    resolveCampusCollectionQuery,
    resolveRequiredCampusQuery,
} from '../../../../lib/campus-load-state';
import {
    madridWeekStartDateKey,
    madridWeekUtcRange,
} from '../../../../lib/calendar/madrid-time';
import { resolveTeacherCalendarAccess } from '../../../../lib/calendar/teacher-calendar-access';

export const prerender = false;

const lang = getLangFromParam(Astro.params.lang);
const t = useTranslations(lang);

interface CalendarStudent {
    id: string;
    full_name: string | null;
    email: string;
}

interface CalendarSession {
    id: string;
    scheduled_at: string;
    duration_minutes: number;
    status: string;
    meet_link: string | null;
    teacher_notes: string | null;
    drive_doc_url: string | null;
    student: CalendarStudent;
}

const supabase = createSupabaseServerClient(Astro);
const { data: { user }, error: authError } = await supabase.auth.getUser();

if (authError) {
    reportCampusReadError('teacher_calendar.auth', authError);
}

const profileResult = user && !authError
    ? await supabase
        .from('profiles')
        .select('*')
        .eq('id', user.id)
        .maybeSingle()
    : null;
const profileState = profileResult ? resolveRequiredCampusQuery(profileResult) : null;
const profile = profileState?.status === 'ready' ? profileState.data : null;
const access = resolveTeacherCalendarAccess({
    hasUser: Boolean(user),
    authFailed: Boolean(authError),
    profileStatus: profileState?.status || null,
    profileRole: profile?.role,
});
const accessUnavailable = access === 'unavailable';
const authenticatedUserId = user?.id || '';

if (profileState?.status === 'error') {
    reportCampusReadError('teacher_calendar.profile', profileState.error);
} else if (profileState?.status === 'empty' && user) {
    reportCampusReadError('teacher_calendar.profile', { code: 'PROFILE_MISSING' });
}

if (access === 'login') {
    return Astro.redirect(`/${lang}/login`);
}

if (access === 'admin-calendar') {
    return Astro.redirect(`/${lang}/campus/admin/calendar`);
}

if (access === 'campus') {
    return Astro.redirect(`/${lang}/campus`);
}

const initialWeekStartKey = madridWeekStartDateKey(new Date());
const initialWeekRange = madridWeekUtcRange(initialWeekStartKey);
if (!initialWeekRange) throw new Error('Could not derive the current Madrid week');

const canLoadCalendar = access === 'teacher-calendar';
const availabilityResult = canLoadCalendar
    ? await supabase
        .from('teacher_availability')
        .select('*')
        .eq('teacher_id', authenticatedUserId)
        .eq('is_active', true)
        .order('day_of_week')
        .order('start_time')
    : { data: [], error: null };

const sessionsResult = canLoadCalendar
    ? await supabase
        .from('sessions')
        .select(`
            id,
            student_id,
            scheduled_at,
            duration_minutes,
            status,
            meet_link,
            teacher_notes,
            drive_doc_url,
            student:profiles!sessions_student_id_fkey(id, full_name, email)
        `)
        .eq('teacher_id', authenticatedUserId)
        .gte('scheduled_at', initialWeekRange.fromUtc)
        .lt('scheduled_at', initialWeekRange.toUtcExclusive)
        .order('scheduled_at')
    : { data: [], error: null };

const assignedStudentsResult = canLoadCalendar
    ? await supabase
        .from('student_teachers')
        .select(`
            profiles!student_teachers_student_id_fkey (
                id,
                full_name,
                email
            )
        `)
        .eq('teacher_id', authenticatedUserId)
    : { data: [], error: null };

const availabilityState = resolveCampusCollectionQuery(availabilityResult);
const sessionsState = resolveCampusCollectionQuery(sessionsResult);
const assignedStudentsState = resolveCampusCollectionQuery(assignedStudentsResult);

if (availabilityState.status === 'error') {
    reportCampusReadError('teacher_calendar.availability', availabilityState.error);
}
if (sessionsState.status === 'error') {
    reportCampusReadError('teacher_calendar.sessions', sessionsState.error);
}
if (assignedStudentsState.status === 'error') {
    reportCampusReadError('teacher_calendar.students', assignedStudentsState.error);
}

const availability = availabilityState.status === 'ready' ? availabilityState.data : [];
const sessionRows = sessionsState.status === 'ready' ? sessionsState.data : [];
const assignedStudentRows = assignedStudentsState.status === 'ready' ? assignedStudentsState.data : [];

const students = assignedStudentRows.flatMap(({ profiles }): CalendarStudent[] => (
    profiles ? [profiles] : []
));

const calendarSessions = sessionRows.flatMap((session): CalendarSession[] => {
    if (!session.scheduled_at || !session.student_id) return [];
    return [{
        id: session.id,
        scheduled_at: session.scheduled_at,
        duration_minutes: session.duration_minutes ?? 50,
        status: session.status ?? 'scheduled',
        meet_link: session.meet_link,
        teacher_notes: session.teacher_notes,
        drive_doc_url: session.drive_doc_url,
        student: session.student || {
            id: session.student_id,
            full_name: null,
            email: '',
        },
    }];
});

const calendarProjectionInvalid = students.length !== assignedStudentRows.length
    || calendarSessions.length !== sessionRows.length;
const hiddenHistoricalStudentIdentity = sessionRows.some((session) => !session.student);
if (calendarProjectionInvalid) {
    reportCampusReadError('teacher_calendar.projection', { code: 'CALENDAR_PROJECTION_INVALID' });
}
if (hiddenHistoricalStudentIdentity) {
    reportCampusReadError('teacher_calendar.projection', { code: 'STUDENT_IDENTITY_UNAVAILABLE' });
}

const calendarLoadFailed = availabilityState.status === 'error'
    || sessionsState.status === 'error'
    || assignedStudentsState.status === 'error'
    || calendarProjectionInvalid;
if (accessUnavailable || calendarLoadFailed) Astro.response.status = 503;

// Nombres de días en el idioma actual
const dayNames: Record<SupportedLang, string[]> = {
    es: ['Domingo', 'Lunes', 'Martes', 'Miércoles', 'Jueves', 'Viernes', 'Sábado'],
    en: ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'],
    ru: ['Воскресенье', 'Понедельник', 'Вторник', 'Среда', 'Четверг', 'Пятница', 'Суббота']
};

// Traducciones para componentes
const calendarTranslations = {
    title: t('campus.teacher.calendar.title'),
    availability: t('campus.teacher.calendar.availability'),
    schedule: t('campus.teacher.calendar.schedule'),
    noSessions: t('campus.teacher.calendar.noSessions'),
    today: t('campus.teacher.calendar.today'),
    week: t('campus.teacher.calendar.week'),
    addSlot: t('campus.teacher.calendar.addSlot'),
    removeSlot: t('campus.teacher.calendar.removeSlot'),
    from: t('campus.teacher.calendar.from'),
    to: t('campus.teacher.calendar.to'),
    save: t('campus.teacher.calendar.save'),
    cancel: t('common.cancel'),
    scheduleClass: t('campus.teacher.calendar.scheduleClass'),
    selectStudent: t('campus.teacher.calendar.selectStudent'),
    selectDate: t('campus.teacher.calendar.selectDate'),
    selectTime: t('campus.teacher.calendar.selectTime'),
    duration: t('campus.teacher.calendar.duration'),
    minutes: t('campus.teacher.calendar.minutes'),
    confirm: t('campus.teacher.calendar.confirm'),
    completed: t('campus.teacher.calendar.completed'),
    scheduled: t('campus.teacher.calendar.scheduled'),
    cancelled: t('campus.teacher.calendar.cancelled'),
    noShow: t('campus.teacher.calendar.noShow'),
    markComplete: t('campus.teacher.calendar.markComplete'),
    markNoShow: t('campus.teacher.calendar.markNoShow'),
    cancelSession: t('campus.teacher.calendar.cancelSession'),
    addNotes: t('campus.teacher.calendar.addNotes'),
    noSlots: t('campus.teacher.calendar.noSlots'),
    day: t('campus.teacher.calendar.day'),
    slotAdded: t('campus.teacher.calendar.slotAdded'),
    slotRemoved: t('campus.teacher.calendar.slotRemoved'),
    errorAdding: t('campus.teacher.calendar.errorAdding'),
    errorRemoving: t('campus.teacher.calendar.errorRemoving'),
    invalidTimeRange: t('campus.teacher.calendar.invalidTimeRange'),
    timezoneNotice: t('campus.teacher.calendar.timezoneNotice'),
    status: t('campus.teacher.calendar.status'),
    dateTime: t('campus.teacher.calendar.dateTime'),
    meetLink: t('campus.teacher.calendar.meetLink'),
    saveNotes: t('campus.teacher.calendar.saveNotes'),
    updated: t('campus.teacher.calendar.updated'),
    sessionNotesPlaceholder: t('campus.teacher.calendar.sessionNotesPlaceholder'),
    dayNames: dayNames[lang],
    continue: t('campus.teacher.calendar.continue'),
    back: t('campus.teacher.calendar.back'),
    loading: t('campus.teacher.calendar.loading'),
    noSlotsDate: t('campus.teacher.calendar.noSlotsDate'),
    setupAvailability: t('campus.teacher.calendar.setupAvailability'),
    summary: t('campus.teacher.calendar.summary'),
    studentLabel: t('campus.teacher.calendar.studentLabel'),
    studentUnavailable: t('campus.teacher.calendar.studentUnavailable'),
    dateLabel: t('campus.teacher.calendar.dateLabel'),
    timeLabel: t('campus.teacher.calendar.timeLabel'),
    meetLinkOptional: t('campus.teacher.calendar.meetLinkOptional'),
    errorLoadingSlots: t('campus.teacher.calendar.errorLoadingSlots'),
    errorScheduling: t('campus.teacher.calendar.errorScheduling'),
    loadError: t('campus.loadError.message'),
    retry: t('campus.loadError.retry'),
};
---

{accessUnavailable || !user || !profile ? (
    <BaseLayout
        title={t('campus.teacher.calendar.title')}
        description={t('campus.loadError.message')}
        lang={lang}
        noindex={true}
    >
        <main class="mx-auto flex min-h-screen max-w-2xl items-center px-4 py-12">
            <h1 class="sr-only">{t('campus.teacher.calendar.title')}</h1>
            <CampusLoadError lang={lang} />
        </main>
    </BaseLayout>
) : (
<CampusLayout
    title={t('campus.teacher.calendar.title')}
    user={{ ...user, ...profile }}
    lang={lang}
>
    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-8">
        <div>
            <h1 class="font-display text-3xl text-[#006064] uppercase">{t('campus.teacher.calendar.title')}</h1>
            <p class="text-sm text-[#006064]/60 font-mono mt-1">
                {t('campus.teacher.calendar.subtitle')}
            </p>
        </div>
    </div>

    {calendarLoadFailed ? (
        <CampusLoadError lang={lang} />
    ) : (
    <>
    <!-- Tabs -->
    <div class="flex border-b-2 border-[#006064] mb-6" role="tablist" aria-label={t('campus.teacher.calendar.title')}>
        <button 
            id="tab-calendar"
            type="button"
            role="tab"
            aria-selected="true"
            aria-controls="view-calendar"
            class="px-6 py-3 font-bold text-sm uppercase border-b-4 border-[#006064] text-[#006064] bg-white -mb-[2px]"
        >
            <span aria-hidden="true">📅</span> {t('campus.teacher.calendar.schedule')}
        </button>
        <button 
            id="tab-availability"
            type="button"
            role="tab"
            aria-selected="false"
            aria-controls="view-availability"
            class="px-6 py-3 font-bold text-sm uppercase text-[#006064]/60 hover:text-[#006064] transition-colors"
        >
            <span aria-hidden="true">⏰</span> {t('campus.teacher.calendar.availability')}
        </button>
    </div>

    <!-- Calendar View -->
    <div id="view-calendar" role="tabpanel" aria-labelledby="tab-calendar">
        <TeacherCalendar 
            client:load
            sessions={calendarSessions}
            initialWeekStartKey={initialWeekStartKey}
            students={students}
            teacherId={authenticatedUserId}
            lang={lang}
            translations={calendarTranslations}
        />
    </div>

    <!-- Availability View -->
    <div id="view-availability" class="hidden" role="tabpanel" aria-labelledby="tab-availability" hidden>
        <AvailabilityManager 
            client:load
            initialAvailability={availability || []}
            teacherId={authenticatedUserId}
            lang={lang}
            translations={calendarTranslations}
        />
    </div>
    </>
    )}
</CampusLayout>
)}

<script>
    const tabCalendar = document.getElementById('tab-calendar');
    const tabAvailability = document.getElementById('tab-availability');
    const viewCalendar = document.getElementById('view-calendar');
    const viewAvailability = document.getElementById('view-availability');

    function setActiveTab(tab: 'calendar' | 'availability') {
        if (tab === 'calendar') {
            tabCalendar?.classList.add('border-b-4', 'border-[#006064]', 'bg-white', '-mb-[2px]');
            tabCalendar?.classList.remove('text-[#006064]/60');
            tabAvailability?.classList.remove('border-b-4', 'border-[#006064]', 'bg-white', '-mb-[2px]');
            tabAvailability?.classList.add('text-[#006064]/60');
            tabCalendar?.setAttribute('aria-selected', 'true');
            tabAvailability?.setAttribute('aria-selected', 'false');
            viewCalendar?.classList.remove('hidden');
            viewAvailability?.classList.add('hidden');
            viewCalendar?.removeAttribute('hidden');
            viewAvailability?.setAttribute('hidden', '');
        } else {
            tabAvailability?.classList.add('border-b-4', 'border-[#006064]', 'bg-white', '-mb-[2px]');
            tabAvailability?.classList.remove('text-[#006064]/60');
            tabCalendar?.classList.remove('border-b-4', 'border-[#006064]', 'bg-white', '-mb-[2px]');
            tabCalendar?.classList.add('text-[#006064]/60');
            tabAvailability?.setAttribute('aria-selected', 'true');
            tabCalendar?.setAttribute('aria-selected', 'false');
            viewAvailability?.classList.remove('hidden');
            viewCalendar?.classList.add('hidden');
            viewAvailability?.removeAttribute('hidden');
            viewCalendar?.setAttribute('hidden', '');
        }
    }

    tabCalendar?.addEventListener('click', () => setActiveTab('calendar'));
    tabAvailability?.addEventListener('click', () => setActiveTab('availability'));
</script>
