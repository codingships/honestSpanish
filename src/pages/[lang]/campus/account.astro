---
import CampusLayout from '../../../layouts/CampusLayout.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { useTranslations } from '../../../i18n/utils';
import CampusLoadError from '../../../components/campus/CampusLoadError.astro';
import {
    reportCampusReadError,
    resolveOptionalCampusQuery,
    resolveRequiredCampusQuery,
} from '../../../lib/campus-load-state';
import { getPrivateProfile } from '../../../lib/profiles-private';
import { createSupabaseServerClient } from '../../../lib/supabase-server';
import ProfileForm from '../../../components/account/ProfileForm';
import GuaranteeCard from '../../../components/account/GuaranteeCard';

export const prerender = false;

const { lang } = Astro.params as { lang: 'es' | 'en' | 'ru' };
const t = useTranslations(lang);

// Get Supabase client and verify user
const supabase = createSupabaseServerClient(Astro);
const { data: { user }, error: authError } = await supabase.auth.getUser();

if (!user && !authError) {
    return Astro.redirect(`/${lang}/login`);
}

if (authError) {
    reportCampusReadError('campus_account.auth', authError);
}

// Get profile
const profileResult = user
    ? await supabase
        .from('profiles')
        .select('id, email, full_name, role, preferred_language, phone, timezone')
        .eq('id', user.id)
        .maybeSingle()
    : { data: null, error: authError };
const profileState = resolveRequiredCampusQuery(profileResult);
const profile = profileState.status === 'ready' ? profileState.data : null;
const roleVerified = profile !== null && ['student', 'teacher', 'admin'].includes(profile.role ?? '');
const accessUnavailable = Boolean(authError) || profileState.status !== 'ready' || !roleVerified;

if (profileState.status === 'error') {
    reportCampusReadError('campus_account.profile', profileState.error);
} else if (profileState.status === 'empty' && user) {
    reportCampusReadError('campus_account.profile', { code: 'PROFILE_MISSING' });
} else if (!roleVerified) {
    reportCampusReadError('campus_account.profile', { code: 'PROFILE_ROLE_INVALID' });
}

// Keep the latest subscription visible even after cancellation so the student
// can still see the durable outcome of a guarantee request or refund.
let subscriptionState = resolveOptionalCampusQuery<any>({ data: null, error: null });
type PrivateProfile = NonNullable<Awaited<ReturnType<typeof getPrivateProfile>>>;
let profilePrivateState = resolveOptionalCampusQuery<PrivateProfile>({ data: null, error: null });

if (!accessUnavailable && user && profile?.role === 'student') {
    const subscriptionResult = await supabase
        .from('subscriptions')
        .select(`
            *,
            packages (
                name,
                display_name
            )
        `)
        .eq('student_id', user.id)
        .order('created_at', { ascending: false })
        .limit(1)
        .maybeSingle();
    subscriptionState = resolveOptionalCampusQuery(subscriptionResult);

    try {
        profilePrivateState = resolveOptionalCampusQuery({
            data: await getPrivateProfile(user.id),
            error: null,
        });
    } catch (error) {
        profilePrivateState = resolveOptionalCampusQuery({ data: null, error });
    }
}

if (subscriptionState.status === 'error') {
    reportCampusReadError('campus_account.subscription', subscriptionState.error);
}
if (profilePrivateState.status === 'error') {
    reportCampusReadError('campus_account.drive', profilePrivateState.error);
}
if (
    accessUnavailable
    || subscriptionState.status === 'error'
    || profilePrivateState.status === 'error'
) {
    Astro.response.status = 503;
}

const subscription = subscriptionState.status === 'ready' ? subscriptionState.data : null;
const profilePrivate = profilePrivateState.status === 'ready' ? profilePrivateState.data : null;

const driveFolderUrl = profilePrivate?.drive_folder_url
    || (profilePrivate?.drive_folder_id ? `https://drive.google.com/drive/folders/${profilePrivate.drive_folder_id}` : null);

// Helpers
const getPackageName = (sub: any) => {
    if (!sub?.packages?.display_name) return '—';
    const displayName = sub.packages.display_name;
    return displayName[lang] || displayName['es'] || sub.packages.name;
};

const formatDate = (dateStr: string) => {
    if (!dateStr) return '—';
    return new Date(dateStr).toLocaleDateString(lang === 'es' ? 'es-ES' : lang === 'ru' ? 'ru-RU' : 'en-US', {
        day: 'numeric',
        month: 'long',
        year: 'numeric',
    });
};

// Form translations
const formTranslations = {
    fullName: t('campus.account.fullName'),
    email: t('campus.account.email'),
    phone: t('campus.account.phone'),
    language: t('campus.account.language'),
    timezone: t('campus.account.timezone'),
    save: t('campus.account.save'),
    saved: t('campus.account.saved'),
};

const driveUi: Record<'es' | 'en' | 'ru', {
    title: string;
    subtitle: string;
    folderReady: string;
    folderPending: string;
    folderLink: string;
    emailLabel: string;
    emailPlaceholder: string;
    submit: string;
    success: string;
    error: string;
    linked: string;
    publicAccess: string;
    sharedLink: string;
}> = {
    es: {
        title: 'Acceso a Google Drive',
        subtitle: 'Tu carpeta se entrega actualmente por enlace. Puedes añadir una cuenta de Google como lectora; el acceso por enlace continuará hasta que la academia complete y verifique la migración a invitaciones nominales.',
        folderReady: 'La carpeta ya está lista.',
        folderPending: 'La carpeta todavía no está creada. Vuelve a intentarlo cuando tu alta y tu plan estén activos.',
        folderLink: 'Abrir carpeta',
        emailLabel: 'Cuenta de Google',
        emailPlaceholder: 'tu-correo@example.com',
        submit: 'Vincular cuenta Google',
        success: 'Permiso de lectura añadido a la cuenta de Google.',
        error: 'No se pudo vincular la cuenta Google.',
        linked: 'Cuenta vinculada',
        publicAccess: 'Acceso actual',
        sharedLink: 'Enlace compartido',
    },
    en: {
        title: 'Google Drive Access',
        subtitle: 'Your folder is currently delivered through a shared link. You can add a Google account as a reader; link access will remain until the academy completes and verifies the move to named invitations.',
        folderReady: 'Your folder is ready.',
        folderPending: 'Your folder has not been created yet. Try again once your enrollment and plan are active.',
        folderLink: 'Open folder',
        emailLabel: 'Google account',
        emailPlaceholder: 'your-email@example.com',
        submit: 'Link Google account',
        success: 'Reader access was added for the Google account.',
        error: 'Could not link the Google account.',
        linked: 'Linked account',
        publicAccess: 'Current access',
        sharedLink: 'Shared link',
    },
    ru: {
        title: 'Доступ к Google Drive',
        subtitle: 'Сейчас папка доступна по ссылке. Можно добавить аккаунт Google с правами чтения; доступ по ссылке сохранится, пока академия не завершит и не проверит переход на именные приглашения.',
        folderReady: 'Папка уже готова.',
        folderPending: 'Папка еще не создана. Повторите позже, когда активация и план будут активны.',
        folderLink: 'Открыть папку',
        emailLabel: 'Аккаунт Google',
        emailPlaceholder: 'your-account@gmail.com',
        submit: 'Привязать аккаунт Google',
        success: 'Аккаунту Google предоставлен доступ для чтения.',
        error: 'Не удалось привязать аккаунт Google.',
        linked: 'Привязанный аккаунт',
        publicAccess: 'Текущий доступ',
        sharedLink: 'Общая ссылка',
    },
};
---

{accessUnavailable || !user || !profile ? (
    <BaseLayout
        title={t('campus.account.title')}
        description={t('campus.loadError.message')}
        lang={lang}
        noindex={true}
    >
        <main class="mx-auto flex min-h-screen max-w-2xl items-center px-4 py-12">
            <h1 class="sr-only">{t('campus.account.title')}</h1>
            <CampusLoadError lang={lang} />
        </main>
    </BaseLayout>
) : (
<CampusLayout
    title={t('campus.account.title')}
    user={{ ...user, ...profile }}
    lang={lang}
>
    <div class="max-w-2xl mx-auto space-y-6">
        <!-- Personal Information -->
        <div class="bg-white p-6 border-2 border-[#006064] shadow-[4px_4px_0px_0px_#006064]">
            <h2 class="font-display text-xl text-[#006064] uppercase mb-6">
                {t('campus.account.personalInfo')}
            </h2>
            
            <ProfileForm 
                client:load
                profile={{
                    full_name: profile.full_name,
                    email: profile.email,
                    phone: profile.phone,
                    preferred_language: profile.preferred_language || 'es',
                    timezone: profile.timezone || 'Europe/Madrid',
                }}
                translations={formTranslations}
            />
        </div>

        <!-- Security -->
        <div class="bg-white p-6 border-2 border-[#006064] shadow-[4px_4px_0px_0px_#006064]">
            <h2 class="font-display text-xl text-[#006064] uppercase mb-4">
                {t('campus.account.security')}
            </h2>
            
            <button
                id="change-password-btn"
                class="px-4 py-2 bg-[#E0F7FA] text-[#006064] font-bold uppercase text-sm border-2 border-[#006064] hover:bg-[#006064] hover:text-white transition-colors"
            >
                {t('campus.account.changePassword')}
            </button>
            
            <!-- Inline change password form (hidden by default) -->
            <div id="change-password-form" class="hidden mt-4 space-y-4">
                <div>
                    <label class="block font-mono text-xs uppercase tracking-wide text-[#006064] mb-2 font-bold">
                        {t('auth.newPassword')}
                    </label>
                    <input
                        type="password"
                        id="new-password"
                        minlength="6"
                        required
                        class="w-full p-3 border-2 border-[#006064] focus:outline-none focus:ring-2 focus:ring-[#006064]/20 font-sans text-lg text-[#006064]"
                        placeholder="••••••••"
                    />
                </div>
                <div>
                    <label class="block font-mono text-xs uppercase tracking-wide text-[#006064] mb-2 font-bold">
                        {t('auth.confirmNewPassword')}
                    </label>
                    <input
                        type="password"
                        id="confirm-password"
                        minlength="6"
                        required
                        class="w-full p-3 border-2 border-[#006064] focus:outline-none focus:ring-2 focus:ring-[#006064]/20 font-sans text-lg text-[#006064]"
                        placeholder="••••••••"
                    />
                </div>
                <div id="password-error" class="hidden p-3 bg-red-100 border-2 border-red-500 text-red-700 font-bold text-sm"></div>
                <div id="password-success" class="hidden p-3 bg-green-100 border-2 border-green-500 text-green-700 font-bold text-sm"></div>
                <button
                    id="save-password-btn"
                    data-default-label={t('campus.account.changePassword')}
                    class="px-4 py-2 bg-[#006064] text-white font-bold uppercase text-sm border-2 border-[#006064] hover:bg-[#004d40] transition-colors"
                >
                    {t('campus.account.changePassword')}
                </button>
            </div>
        </div>

        <!-- Subscription (only for students) -->
        {profile.role === 'student' && (
            <div class="bg-white p-6 border-2 border-[#006064] shadow-[4px_4px_0px_0px_#006064]">
                <h2 class="font-display text-xl text-[#006064] uppercase mb-4">
                    {t('campus.account.subscription')}
                </h2>
                
                {subscriptionState.status === 'error' ? (
                    <CampusLoadError lang={lang} />
                ) : subscription ? (
                    <div class="space-y-4">
                        <div class="flex justify-between items-center">
                            <div>
                                <p class="font-bold text-[#006064] text-lg">{getPackageName(subscription)}</p>
                                <p class="text-sm text-[#006064]/60">
                                    {subscription.status === 'active' ? (
                                        <span class="text-green-600">● {t('campus.account.active')}</span>
                                    ) : (
                                        <span class="text-gray-500">● {subscription.status}</span>
                                    )}
                                </p>
                            </div>
                            <div class="text-right">
                                <p class="text-xs text-[#006064]/60 uppercase">{t('campus.account.expires')}</p>
                                <p class="font-mono text-[#006064]">{formatDate(subscription.ends_at)}</p>
                            </div>
                        </div>
                        
                        {subscription && (
                            <button
                                id="manage-stripe-btn"
                                class="w-full px-4 py-3 bg-[#006064] text-white font-bold uppercase text-sm border-2 border-[#006064] hover:bg-[#004d40] transition-colors"
                            >
                                {t('campus.account.manageStripe')}
                            </button>
                        )}
                    </div>
                ) : (
                    <div>
                        <p class="text-[#006064]/60 font-mono mb-4">{t('campus.dashboard.noPlan')}</p>
                        <a 
                            href={`/${lang}/#planes`}
                            class="inline-block px-4 py-2 bg-[#006064] text-white font-bold uppercase text-sm border-2 border-[#006064] hover:bg-[#004d40] transition-colors"
                        >
                            {t('campus.dashboard.viewPlans')}
                        </a>
                    </div>
                )}
            </div>
        )}

        {profile.role === 'student' && subscriptionState.status === 'ready' && subscription && (
            <GuaranteeCard
                client:load
                subscriptionId={subscription.id}
                lang={lang}
            />
        )}

        {profile.role === 'student' && (
            <div class="bg-white p-6 border-2 border-[#006064] shadow-[4px_4px_0px_0px_#006064]">
                <h2 class="font-display text-xl text-[#006064] uppercase mb-4">
                    {driveUi[lang].title}
                </h2>
                <p class="text-sm text-[#006064]/70 mb-4">
                    {driveUi[lang].subtitle}
                </p>

                {profilePrivateState.status === 'error' ? (
                    <CampusLoadError lang={lang} />
                ) : (
                <div class="space-y-4">
                    <div class="flex flex-col gap-2 text-sm text-[#006064]">
                        <p class="font-bold">
                            {driveFolderUrl ? driveUi[lang].folderReady : driveUi[lang].folderPending}
                        </p>
                        <p>
                            <span class="font-bold">{driveUi[lang].publicAccess}:</span>{' '}
                            {profilePrivate?.google_account_email || driveUi[lang].sharedLink}
                        </p>
                        {profilePrivate?.google_account_email && (
                            <p>
                                <span class="font-bold">{driveUi[lang].linked}:</span>{' '}
                                {profilePrivate.google_account_email}
                            </p>
                        )}
                        {driveFolderUrl && (
                            <a
                                href={driveFolderUrl}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="inline-flex w-fit items-center gap-2 px-4 py-2 bg-[#E0F7FA] text-[#006064] text-xs font-bold uppercase border border-[#006064] hover:bg-[#006064] hover:text-white transition-colors"
                            >
                                🔗 {driveUi[lang].folderLink}
                            </a>
                        )}
                    </div>

                    <form
                        id="link-drive-form"
                        class="space-y-3"
                        data-drive-ui={JSON.stringify(driveUi[lang])}
                    >
                        <div>
                            <label for="google-account-email" class="block font-mono text-xs uppercase tracking-wide text-[#006064] mb-2 font-bold">
                                {driveUi[lang].emailLabel}
                            </label>
                            <input
                                id="google-account-email"
                                type="email"
                                value={profilePrivate?.google_account_email || profile.email}
                                placeholder={driveUi[lang].emailPlaceholder}
                                class="w-full p-3 border-2 border-[#006064] focus:outline-none focus:ring-2 focus:ring-[#006064]/20 font-sans text-lg text-[#006064]"
                                disabled={!driveFolderUrl}
                                required
                            />
                        </div>
                        <div id="drive-link-error" class="hidden p-3 bg-red-100 border-2 border-red-500 text-red-700 font-bold text-sm"></div>
                        <div id="drive-link-success" class="hidden p-3 bg-green-100 border-2 border-green-500 text-green-700 font-bold text-sm"></div>
                        <button
                            id="link-drive-btn"
                            type="submit"
                            class="px-4 py-2 bg-[#006064] text-white font-bold uppercase text-sm border-2 border-[#006064] hover:bg-[#004d40] transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
                            disabled={!driveFolderUrl}
                        >
                            {driveUi[lang].submit}
                        </button>
                    </form>
                </div>
                )}
            </div>
        )}

        <!-- Danger Zone -->
        <div class="bg-white p-6 border-2 border-red-500 shadow-[4px_4px_0px_0px_#ef4444]">
            <h2 class="font-display text-xl text-red-600 uppercase mb-4">
                {t('campus.account.danger')}
            </h2>
            
            <div class="space-y-3">
                <a 
                    href={`/${lang}/logout`}
                    class="block w-full px-4 py-2 bg-white text-red-600 font-bold uppercase text-sm border-2 border-red-500 hover:bg-red-500 hover:text-white transition-colors text-center"
                >
                    {t('campus.account.logoutAll')}
                </a>
                
                <button
                    id="delete-account-btn"
                    disabled
                    class="w-full px-4 py-2 bg-red-100 text-red-400 font-bold uppercase text-sm border-2 border-red-300 cursor-not-allowed opacity-50"
                >
                    {t('campus.account.deleteAccount')}
                </button>
                <p class="text-xs text-red-400">Contacta con soporte para eliminar tu cuenta</p>
            </div>
        </div>
    </div>
</CampusLayout>
)}

<script>
    import { openBillingPortal } from '../../../lib/billing-portal-client';

    const stripeBtn = document.getElementById('manage-stripe-btn') as HTMLButtonElement | null;
    stripeBtn?.addEventListener('click', () => {
        void openBillingPortal({ button: stripeBtn }).catch((error) => {
            console.error('Error opening Stripe portal:', error);
        });
    });
</script>

<script>
    // Change Password
    const changePwdBtn = document.getElementById('change-password-btn');
    const changePwdForm = document.getElementById('change-password-form');
    const savePwdBtn = document.getElementById('save-password-btn');
    const newPwdInput = document.getElementById('new-password');
    const confirmPwdInput = document.getElementById('confirm-password');
    const pwdError = document.getElementById('password-error');
    const pwdSuccess = document.getElementById('password-success');
    const linkDriveForm = document.getElementById('link-drive-form');
    const linkDriveBtn = document.getElementById('link-drive-btn');
    const googleAccountEmailInput = document.getElementById('google-account-email');
    const driveLinkError = document.getElementById('drive-link-error');
    const driveLinkSuccess = document.getElementById('drive-link-success');
    const driveUi = JSON.parse(linkDriveForm?.getAttribute('data-drive-ui') || '{}');
    const changePasswordLabel = savePwdBtn?.getAttribute('data-default-label') || '';

    changePwdBtn?.addEventListener('click', () => {
        changePwdForm?.classList.toggle('hidden');
    });

    savePwdBtn?.addEventListener('click', async () => {
        pwdError?.classList.add('hidden');
        pwdSuccess?.classList.add('hidden');

        const newPwd = newPwdInput?.value || '';
        const confirmPwd = confirmPwdInput?.value || '';

        if (newPwd.length < 6) {
            pwdError.textContent = newPwd.length === 0 ? 'Required' : 'Min 6 characters';
            pwdError?.classList.remove('hidden');
            return;
        }

        if (newPwd !== confirmPwd) {
            pwdError.textContent = 'Passwords do not match';
            pwdError?.classList.remove('hidden');
            return;
        }

        try {
            savePwdBtn.textContent = '...';
            savePwdBtn.disabled = true;

            // Import supabase client dynamically
            const { supabase } = await import('../../../lib/supabase');
            const { error } = await supabase.auth.updateUser({ password: newPwd });

            if (error) throw error;

            pwdSuccess.textContent = '✅ Password updated';
            pwdSuccess?.classList.remove('hidden');
            newPwdInput.value = '';
            confirmPwdInput.value = '';
            
            // Hide form after 2 seconds
            setTimeout(() => {
                changePwdForm?.classList.add('hidden');
                pwdSuccess?.classList.add('hidden');
            }, 2000);
        } catch (err) {
            console.error('Error changing password:', err);
            pwdError.textContent = err.message || 'Error';
            pwdError?.classList.remove('hidden');
        } finally {
            savePwdBtn.textContent = changePasswordLabel;
            savePwdBtn.disabled = false;
        }
    });

    linkDriveForm?.addEventListener('submit', async (event) => {
        event.preventDefault();
        driveLinkError?.classList.add('hidden');
        driveLinkSuccess?.classList.add('hidden');

        const googleAccountEmail = googleAccountEmailInput?.value?.trim() || '';
        if (!googleAccountEmail) {
            driveLinkError.textContent = driveUi.error;
            driveLinkError?.classList.remove('hidden');
            return;
        }

        try {
            linkDriveBtn.textContent = '...';
            linkDriveBtn.disabled = true;

            const response = await fetch('/api/account/link-google-drive', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ googleAccountEmail }),
            });

            const data = await response.json().catch(() => ({ error: driveUi.error }));
            if (!response.ok) {
                throw new Error(data.error || driveUi.error);
            }

            driveLinkSuccess.textContent = driveUi.success;
            driveLinkSuccess?.classList.remove('hidden');
            window.setTimeout(() => window.location.reload(), 1000);
        } catch (err) {
            console.error('Error linking Google account:', err);
            driveLinkError.textContent = err instanceof Error ? err.message : driveUi.error;
            driveLinkError?.classList.remove('hidden');
        } finally {
            linkDriveBtn.textContent = driveUi.submit;
            linkDriveBtn.disabled = false;
        }
    });
</script>
