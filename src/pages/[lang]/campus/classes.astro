---
import CampusLayout from '../../../layouts/CampusLayout.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getLangFromParam, useTranslations } from '../../../i18n/utils';
import CampusLoadError from '../../../components/campus/CampusLoadError.astro';
import { createSupabaseServerClient } from '../../../lib/supabase-server';
import {
    reportCampusReadError,
    resolveCampusCollectionQuery,
    resolveRequiredCampusQuery,
} from '../../../lib/campus-load-state';
import StudentClassList from '../../../components/calendar/StudentClassList';

export const prerender = false;

const lang = getLangFromParam(Astro.params.lang);
const t = useTranslations(lang);

const supabase = createSupabaseServerClient(Astro);
const { data: { user }, error: authError } = await supabase.auth.getUser();

if (!user && !authError) {
    return Astro.redirect(`/${lang}/login`);
}

if (authError) {
    reportCampusReadError('student_classes.auth', authError);
}

const profileResult = user
    ? await supabase
        .from('profiles')
        .select('*')
        .eq('id', user.id)
        .maybeSingle()
    : { data: null, error: authError };
const profileState = resolveRequiredCampusQuery(profileResult);
const profile = profileState.status === 'ready' ? profileState.data : null;
const roleVerified = profile !== null && ['student', 'teacher', 'admin'].includes(profile.role ?? '');
const accessUnavailable = Boolean(authError) || profileState.status !== 'ready' || !roleVerified;

if (profileState.status === 'error') {
    reportCampusReadError('student_classes.profile', profileState.error);
} else if (profileState.status === 'empty' && user) {
    reportCampusReadError('student_classes.profile', { code: 'PROFILE_MISSING' });
} else if (!roleVerified) {
    reportCampusReadError('student_classes.profile', { code: 'PROFILE_ROLE_INVALID' });
}

// Strictly prevent Teachers & Admins from entering the Student Dashboard
if (!accessUnavailable && profile?.role === 'admin') {
    return Astro.redirect(`/${lang}/campus/admin`);
} else if (!accessUnavailable && profile?.role === 'teacher') {
    return Astro.redirect(`/${lang}/campus/teacher`);
}

// Obtener todas las sesiones del estudiante
const sessionsResult = !accessUnavailable && user
    ? await supabase
        .from('sessions')
        .select(`
            *,
            teacher:profiles!sessions_teacher_id_fkey(id, full_name, email)
        `)
        .eq('student_id', user.id)
        .order('scheduled_at', { ascending: false })
    : { data: [], error: null };
const sessionsState = resolveCampusCollectionQuery(sessionsResult);

if (sessionsState.status === 'error') {
    reportCampusReadError('student_classes.sessions', sessionsState.error);
}

if (accessUnavailable || sessionsState.status === 'error') {
    Astro.response.status = 503;
}

type ClassSession = {
    id: string;
    scheduled_at: string;
    duration_minutes: number;
    status: string;
    meet_link: string | null;
    drive_doc_url: string | null;
    teacher_notes: string | null;
    checkout_v2_cycle_id: string | null;
    teacher: { id: string; full_name: string | null; email: string } | null;
};

const sessionRows = sessionsState.status === 'ready' ? sessionsState.data : [];
const classSessions: ClassSession[] = sessionRows.flatMap((session) => {
    if (!session.scheduled_at) return [];
    return [{
        id: session.id,
        scheduled_at: session.scheduled_at,
        duration_minutes: session.duration_minutes ?? 50,
        status: session.status ?? 'scheduled',
        meet_link: session.meet_link,
        drive_doc_url: session.drive_doc_url,
        teacher_notes: session.teacher_notes,
        checkout_v2_cycle_id: session.checkout_v2_cycle_id ?? null,
        teacher: session.teacher,
    }];
});

// Separar en futuras y pasadas
const now = new Date();
const upcomingSessions = classSessions
    .filter(s => new Date(s.scheduled_at) >= now && s.status === 'scheduled')
    .sort((a, b) => new Date(a.scheduled_at).getTime() - new Date(b.scheduled_at).getTime());

const pastSessions = classSessions
    .filter(s => new Date(s.scheduled_at) < now || s.status !== 'scheduled')
    .sort((a, b) => new Date(b.scheduled_at).getTime() - new Date(a.scheduled_at).getTime());

// Traducciones para el componente
const classTranslations = {
    upcoming: t('campus.student.classes.upcoming'),
    past: t('campus.student.classes.past'),
    noUpcoming: t('campus.student.classes.noUpcoming'),
    noPast: t('campus.student.classes.noPast'),
    joinClass: t('campus.student.classes.joinClass'),
    cancelClass: t('campus.student.classes.cancelClass'),
    cancelConfirm: t('campus.student.classes.cancelConfirm'),
    cancelWarning: t('campus.student.classes.cancelWarning'),
    cancelLateWarning: t('campus.student.classes.cancelLateWarning'),
    cancelLateNotice: t('campus.student.classes.cancelLateNotice'),
    with: t('campus.student.classes.with'),
    duration: t('campus.student.classes.duration'),
    minutes: t('campus.teacher.calendar.minutes'),
    status: {
        scheduled: t('campus.teacher.calendar.scheduled'),
        completed: t('campus.teacher.calendar.completed'),
        cancelled: t('campus.teacher.calendar.cancelled'),
        noShow: t('campus.teacher.calendar.noShow'),
    },
    teacherNotes: t('campus.student.classes.teacherNotes'),
    cancel: t('common.cancel'),
    confirm: t('campus.teacher.calendar.confirm'),
    startingSoon: t('campus.student.classes.startingSoon'),
    linkAvailableSoon: t('campus.student.classes.linkAvailableSoon'),
    cancelUnavailable: t('campus.student.classes.cancelUnavailable'),
    unassigned: t('campus.student.classes.unassigned'),
    viewDocument: t('campus.student.classes.viewDocument'),
    cancelReason: t('campus.student.classes.cancelReason'),
    cancelReasonPlaceholder: t('campus.student.classes.cancelReasonPlaceholder'),
    cancelError: t('campus.student.classes.cancelError'),
    rescheduleClass: t('campus.student.classes.rescheduleClass'),
    rescheduleTitle: t('campus.student.classes.rescheduleTitle'),
    rescheduleIntro: t('campus.student.classes.rescheduleIntro'),
    rescheduleDateLabel: t('campus.student.classes.rescheduleDateLabel'),
    rescheduleTargetsLabel: t('campus.student.classes.rescheduleTargetsLabel'),
    rescheduleChooseTarget: t('campus.student.classes.rescheduleChooseTarget'),
    rescheduleLoadingTargets: t('campus.student.classes.rescheduleLoadingTargets'),
    rescheduleNoTargets: t('campus.student.classes.rescheduleNoTargets'),
    rescheduleAffectedDates: t('campus.student.classes.rescheduleAffectedDates'),
    rescheduleProvisionalWarning: t('campus.student.classes.rescheduleProvisionalWarning'),
    reschedulePendingNotice: t('campus.student.classes.reschedulePendingNotice'),
    rescheduleConfirm: t('campus.student.classes.rescheduleConfirm'),
    rescheduleRetry: t('campus.student.classes.rescheduleRetry'),
    rescheduleSubmitting: t('campus.student.classes.rescheduleSubmitting'),
    rescheduleClose: t('campus.student.classes.rescheduleClose'),
    rescheduleTargetsError: t('campus.student.classes.rescheduleTargetsError'),
    rescheduleNetworkError: t('campus.student.classes.rescheduleNetworkError'),
    rescheduleConflict: t('campus.student.classes.rescheduleConflict'),
    rescheduleReview: t('campus.student.classes.rescheduleReview'),
    rescheduleRetryable: t('campus.student.classes.rescheduleRetryable'),
    rescheduleForbidden: t('campus.student.classes.rescheduleForbidden'),
    rescheduleNotFound: t('campus.student.classes.rescheduleNotFound'),
    rescheduleSessionExpired: t('campus.student.classes.rescheduleSessionExpired'),
    rescheduleInvalid: t('campus.student.classes.rescheduleInvalid'),
    rescheduleStorageError: t('campus.student.classes.rescheduleStorageError'),
};
---

{accessUnavailable || !user || !profile ? (
    <BaseLayout
        title={t('campus.student.classes.title')}
        description={t('campus.loadError.message')}
        lang={lang}
        noindex={true}
    >
        <main class="mx-auto flex min-h-screen max-w-2xl items-center px-4 py-12">
            <h1 class="sr-only">{t('campus.student.classes.title')}</h1>
            <CampusLoadError lang={lang} />
        </main>
    </BaseLayout>
) : (
    <CampusLayout
        title={t('campus.student.classes.title')}
        user={{ ...user, ...profile }}
        lang={lang}
    >
        <!-- Header -->
        <div class="mb-8">
            <h1 class="font-display text-3xl text-[#006064] uppercase">{t('campus.student.classes.title')}</h1>
            <p class="text-sm text-[#006064]/60 font-mono mt-1">
                {t('campus.student.classes.subtitle')}
            </p>
        </div>

        {sessionsState.status === 'error' ? (
            <CampusLoadError lang={lang} />
        ) : (
            <StudentClassList
                client:load
                upcomingSessions={upcomingSessions}
                pastSessions={pastSessions}
                lang={lang}
                translations={classTranslations}
            />
        )}
    </CampusLayout>
)}
