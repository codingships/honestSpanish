---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BlogAttributionContinuity from '../../../components/blog/BlogAttributionContinuity.astro';
import { useTranslations, getLocalizedPath } from '../../../i18n/utils';
import { getCollection } from 'astro:content';
import { getBlogImagePresentation } from '../../../lib/blog-images';
import { getBlogCategoryLabel, getBlogEntrySlug, isPublishedBlogPost } from '../../../lib/blog-routes';
import { isPublicLang } from '../../../lib/public-seo';

export const prerender = true;

export async function getStaticPaths() {
  return [
    { params: { lang: 'es' } },
    { params: { lang: 'en' } },
    { params: { lang: 'ru' } },
  ];
}

const { lang } = Astro.params;
if (!isPublicLang(lang)) throw new Error('Unsupported blog language: ' + lang);
const t = useTranslations(lang);

const posts = await getCollection('blog', ({ data }) => {
    return data.lang === lang;
}).then((entries) => entries.filter(isPublishedBlogPost));

const sortedPosts = posts.sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
const postCards = sortedPosts.map((post) => ({
    post,
    image: getBlogImagePresentation(post),
}));

const blogIndexCta = {
    es: {
        heading: '¿Quieres hablar de estos temas en español?',
        body: 'Si estos artículos encajan con lo que necesitas, consulta las plazas reales con profesor, horario y fechas antes de reservar.',
        button: 'Ver plazas',
        contact: 'Hacer una consulta',
    },
    en: {
        heading: 'Want to discuss these topics in Spanish?',
        body: 'If these articles match what you need, view real places with their teacher, weekly time and dates before booking.',
        button: 'View places',
        contact: 'Ask a question',
    },
    ru: {
        heading: 'Хотите говорить об этом по-испански?',
        body: 'Если эти статьи похожи на то, что вам нужно, посмотрите реальные места с преподавателем, временем и датами до бронирования.',
        button: 'Посмотреть места',
        contact: 'Задать вопрос',
    },
}[lang as 'es' | 'en' | 'ru'];

const accessibilityCopy = {
    es: { skip: 'Saltar al contenido principal', breadcrumb: 'Ruta de navegación' },
    en: { skip: 'Skip to main content', breadcrumb: 'Breadcrumb' },
    ru: { skip: 'Перейти к основному содержанию', breadcrumb: 'Навигационная цепочка' },
}[lang as 'es' | 'en' | 'ru'];

---

<BaseLayout 
    title={`${t('common.blog')} | Español Honesto`} 
    description={t('meta.description')} 
    lang={lang}
    canonicalPath="/blog"
    ogImage={`/og/${lang}-blog.png`}
    rssPath={'/' + lang + '/blog/rss.xml'}
>
    <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:bg-white focus:px-4 focus:py-3 focus:font-bold focus:text-[#006064] focus:outline focus:outline-4 focus:outline-[#006064]">
        {accessibilityCopy.skip}
    </a>
    <div class="bg-white min-h-screen font-sans text-[#006064]">
        <main id="main-content" tabindex="-1">
        
        {/* Header */}
        <header class="bg-[#E0F7FA] py-24 px-6 border-b-2 border-[#006064]">
            <div class="max-w-6xl mx-auto text-center">
                <nav aria-label={accessibilityCopy.breadcrumb} class="flex justify-center text-sm font-mono uppercase tracking-wide text-[#006064] mb-8">
                     <a href={getLocalizedPath('/', lang)} data-preserve-acquisition-attribution class="hover:underline">{t('common.home')}</a>
                     <span aria-hidden="true" class="mx-2">/</span>
                     <span aria-current="page">{t('common.blog')}</span>
                </nav>
                <h1 class="font-display text-5xl md:text-7xl mb-4 text-[#006064] tracking-tighter">{t('common.blog')}</h1>
                <p class="text-xl max-w-2xl mx-auto text-[#006064]">
                    {lang === 'es' ? 'Artículos sobre aprendizaje, cultura y vida en España.' : 
                     lang === 'en' ? 'Articles about learning, culture, and life in Spain.' : 
                     'Статьи об обучении, культуре и жизни в Испании.'}
                </p>
            </div>
        </header>

        {/* Blog Grid */}
        <div class="max-w-7xl mx-auto px-6 py-24">
            {sortedPosts.length > 0 ? (
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-12">
                    {postCards.map(({ post, image }, index) => (
                        <article class="flex flex-col group">
                            <a href={getLocalizedPath(`/blog/${getBlogEntrySlug(post)}`, lang)} data-preserve-acquisition-attribution aria-label={post.data.title} class="mb-6 block aspect-[1200/630] overflow-hidden rounded-lg border-2 border-[#006064]">
                                <img
                                    src={image.src}
                                    srcset={image.srcSet}
                                    sizes="(min-width: 1024px) 30vw, (min-width: 768px) 45vw, calc(100vw - 3rem)"
                                    alt={image.alt}
                                    class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
                                    width={image.width}
                                    height={image.height}
                                    loading={index === 0 ? 'eager' : 'lazy'}
                                    decoding="async"
                                    fetchpriority={index === 0 ? 'high' : undefined}
                                />
                            </a>
                            
                            <div class="mb-2 flex items-center gap-2 text-xs font-mono uppercase tracking-wide text-[#006064]">
                                <span class="bg-[#006064]/10 px-2 py-1 rounded">
                                    {getBlogCategoryLabel(lang, post.data.category)}
                                </span>
                                <span>•</span>
                                <span>{new Date(post.data.publishedAt).toLocaleDateString(lang, { year: 'numeric', month: 'long', day: 'numeric' })}</span>
                            </div>

                            <a href={getLocalizedPath(`/blog/${getBlogEntrySlug(post)}`, lang)} data-preserve-acquisition-attribution class="group-hover:opacity-70 transition-opacity">
                                <h2 class="font-display text-2xl mb-3 leading-snug text-[#006064]">
                                    {post.data.title}
                                </h2>
                            </a>
                            
                            <p class="text-[#006064] mb-6 line-clamp-3">
                                {post.data.description}
                            </p>

                            <a href={getLocalizedPath(`/blog/${getBlogEntrySlug(post)}`, lang)} data-preserve-acquisition-attribution class="mt-auto inline-flex items-center text-sm font-bold uppercase tracking-wider hover:underline">
                                {t('common.readMore')} →
                            </a>
                        </article>
                    ))}
                </div>
            ) : (
                <div class="text-center py-24">
                    <p class="text-xl opacity-60">
                         {lang === 'es' ? 'No hay artículos todavía.' : 
                          lang === 'en' ? 'No articles yet.' : 
                          'Статей пока нет.'}
                    </p>
                </div>
            )}
        </div>

        <section class="bg-[#006064] text-white py-20 px-6 border-t-2 border-[#006064]">
            <div class="max-w-4xl mx-auto text-center">
                <h2 class="font-display text-4xl md:text-5xl leading-tight">{blogIndexCta.heading}</h2>
                <p class="mt-4 text-lg font-bold text-white/85">{blogIndexCta.body}</p>
                <a
                    href={`/${lang}/#planes`}
                    data-preserve-acquisition-attribution
                    class="mt-8 inline-block bg-white text-[#006064] px-8 py-4 text-sm font-bold uppercase tracking-widest border-2 border-white hover:bg-[#E0F7FA] transition-all"
                >
                    {blogIndexCta.button}
                </a>
                <a
                    href={`/${lang}/#contacto`}
                    data-preserve-acquisition-attribution
                    class="ml-0 mt-4 inline-block px-6 py-3 text-sm font-bold uppercase tracking-widest underline underline-offset-4 hover:text-[#E0F7FA] sm:ml-4 sm:mt-8"
                >
                    {blogIndexCta.contact}
                </a>
            </div>
        </section>

        </main>

    </div>
    <BlogAttributionContinuity />
</BaseLayout>
