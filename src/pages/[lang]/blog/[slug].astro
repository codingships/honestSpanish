---
import { getCollection, render } from 'astro:content';
import BlogLayout from '../../../layouts/BlogLayout.astro';
import { getBlogEntryParts, isPublishedBlogPost } from '../../../lib/blog-routes';

export const prerender = true;

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  
  return posts.filter(isPublishedBlogPost).map(post => {
      const { lang, slug } = getBlogEntryParts(post);

      return {
        params: { 
            lang: lang, 
            slug: slug 
        },
        props: { post },
      };
  });
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
---

<BlogLayout post={post} lang={Astro.params.lang as any} headings={headings}>
  <Content />
</BlogLayout>
