---
export const prerender = false;

const supportedLanguages = new Set(['es', 'en', 'ru']);
const lang = supportedLanguages.has(Astro.params.lang || '') ? Astro.params.lang! : 'es';
const demoGuideEnabled = import.meta.env.DEMO_GUIDE_ENABLED === 'true';

if (demoGuideEnabled) {
    return Astro.redirect(`/${lang}?demo=launcher&demoStart=1`, 302);
}

Astro.response.status = 404;
Astro.response.headers.set('cache-control', 'no-store');
Astro.response.headers.set('x-robots-tag', 'noindex, nofollow');
---
<!doctype html>
<html lang={lang}>
    <head>
        <meta charset="utf-8" />
        <meta name="robots" content="noindex, nofollow" />
        <title>Not found</title>
    </head>
    <body></body>
</html>
