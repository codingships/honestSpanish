---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LandingPage from '../../components/LandingPage.astro';
import { useTranslations } from '../../i18n/utils';
import { getStaticLandingPackages } from '../../lib/landing-data';
import { buildLandingSchema } from '../../lib/landing-schema';
import { serializeJsonForHtml, sha256CspHash } from '../../lib/csp';

const lang = 'en';
export const prerender = true;
const t = useTranslations(lang);
const packages = getStaticLandingPackages();
const schema = buildLandingSchema(lang, t, packages);
const schemaJson = serializeJsonForHtml(schema);
Astro.csp?.insertScriptHash(await sha256CspHash(schemaJson));
---

<BaseLayout 
  title={t('meta.title')} 
  description={t('meta.description')} 
  lang={lang}
  canonicalPath="/"
>
    <script is:inline type="application/ld+json" set:html={schemaJson} />
    <LandingPage lang={lang} packages={packages} />
</BaseLayout>
