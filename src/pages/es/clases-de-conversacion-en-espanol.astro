---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SegmentLandingPage from '../../components/landing/SegmentLandingPage.astro';
import { getStaticLandingPackages } from '../../lib/landing-data';
import { serializeJsonForHtml, sha256CspHash } from '../../lib/csp';
import { ui } from '../../i18n/translations';

const lang = 'es';
export const prerender = true;
const packages = getStaticLandingPackages();

const schema = {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: 'Clases de conversación en español online | Español Honesto',
    description: 'Clases de conversación en español para adultos que quieren ganar soltura, corrección y recursos para participar en conversaciones reales.',
    inLanguage: 'es-ES',
};

const answers = {
    title: 'Respuestas rápidas',
    intro: 'Lo esencial si entiendes español, pero te bloqueas al hablar.',
    items: [
        {
            question: '¿Qué son las clases de conversación en español de Español Honesto?',
            answer: 'Son clases online para adultos que quieren participar mejor en conversaciones reales. Trabajamos soltura, corrección, vocabulario activo, escucha y criterio cultural adaptando el punto de partida y el grado de exigencia a cada alumno.',
        },
        {
            question: '¿Para qué nivel encajan?',
            answer: 'Se adaptan al punto de partida de cada adulto. Si ya entiendes más de lo que puedes decir, el trabajo se centra en activar ese español; si estás empezando, el profesor ajusta la conversación y los apoyos. No necesitas conocer tu nivel exacto antes de comprar.',
        },
        {
            question: '¿Se corrigen errores o sólo se habla?',
            answer: 'Se habla con intención y se corrige con criterio. No cortamos cada frase para perseguir perfección, pero sí registramos errores frecuentes, alternativas naturales, vocabulario útil y tareas para que la conversación deje aprendizaje visible.',
        },
        {
            question: '¿Las clases son individuales?',
            answer: 'Sí. La oferta inicial contiene cuatro clases individuales online de 50 minutos por ciclo de 28 días.',
        },
        {
            question: '¿Cómo se compra?',
            answer: 'Antes de pagar eliges una plaza real con profesor y franja semanal identificados. El precio es 259 EUR y la suscripción se renueva cada 28 días.',
        },
    ],
};

const faqSchema = {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: answers.items.map((item) => ({
        '@type': 'Question',
        name: item.question,
        acceptedAnswer: {
            '@type': 'Answer',
            text: item.answer,
        },
    })),
};
const schemaJson = serializeJsonForHtml(schema);
const faqSchemaJson = serializeJsonForHtml(faqSchema);
Astro.csp?.insertScriptHash(await sha256CspHash(schemaJson));
Astro.csp?.insertScriptHash(await sha256CspHash(faqSchemaJson));

const pricingTranslations = ui.es.pricing;
---

<BaseLayout
    title="Clases de conversación en español online | Español Honesto"
    description="Clases de conversación en español online para adultos que quieren hablar con más soltura, corrección y criterio cultural."
    lang={lang}
    canonicalPath="/clases-de-conversacion-en-espanol"
    alternateLangs={['es']}
>
    <script is:inline type="application/ld+json" set:html={schemaJson} />
    <script is:inline type="application/ld+json" set:html={faqSchemaJson} />

    <SegmentLandingPage
        lang={lang}
        navLabel="/ Conversación"
        packages={packages}
        pricingTranslations={pricingTranslations}
        hero={{
            headline1: 'HABLAR',
            headline2: 'SIN',
            headline3: 'CONGELARTE',
            manifesto: 'Conversación, corrección y criterio',
            subtitle: 'Clases de conversación en español para adultos que entienden bastante, pero necesitan participar con más soltura en conversaciones reales.',
            ready: '¿Quieres dejar de quedarte fuera de la conversación?',
            ctaText: 'VER OFERTA',
        }}
        problems={{
            headline: 'ENTENDER NO ES LO MISMO QUE PARTICIPAR',
            subtext: 'El bloqueo aparece justo cuando la conversación se vuelve real.',
            statements: [
                'Lees y escuchas bastante, pero al hablar vuelves siempre a las mismas frases.',
                'En conversaciones rápidas entiendes la idea, pero llegas tarde para responder.',
                'Te falta vocabulario activo, recursos para ganar tiempo y seguridad para equivocarte sin desaparecer.',
                'No necesitas charla suelta: necesitas conversación guiada, corrección útil y continuidad.',
            ],
        }}
        method={{
            headline: 'Conversar con estructura',
            manifesto: 'SOLTURA • ERRORES • RECURSOS • MATICES',
            closing: 'No prometemos fluidez mágica. Convertimos cada conversación en material de trabajo.',
            subtitle: 'Cada clase combina tema real, corrección seleccionada y seguimiento para que hablar deje de ser improvisar a ciegas.',
            columns: [
                { number: '01', title: 'Tema real', description: 'Hablamos de vida diaria, ciudad, trabajo, cultura, relaciones, trámites o intereses propios.' },
                { number: '02', title: 'Corrección útil', description: 'Detectamos patrones, frases comodín, errores repetidos y alternativas más naturales.' },
                { number: '03', title: 'Transferencia', description: 'Sales con vocabulario activo, mini tareas y estrategias para usar el español fuera de clase.' },
            ],
        }}
        fit={{
            title: 'Para quién encaja',
            intro: 'Esta ruta está pensada para adultos que quieren hablar mejor con una conversación guiada, útil y adaptada a su punto de partida.',
            items: [
                'Adultos que quieren participar con más soltura, sea cual sea su punto de partida actual.',
                'Adultos que quieren conversación real, cultura y criterio.',
                'Personas que quieren corregir errores frecuentes sin perder naturalidad.',
                'Estudiantes que necesitan una rutina para pasar de español pasivo a español usable.',
            ],
        }}
        community={{
            title: 'Conversación individual con continuidad',
            body: 'Cada plaza tiene profesor y franja semanal identificados antes del pago.',
            notes: [
                'La oferta inicial son cuatro clases individuales de 50 minutos.',
                'El ciclo se renueva automáticamente cada 28 días.',
                'En cada ciclo puedes activar la garantía proporcional sobre todas las clases todavía no consumidas.',
            ],
        }}
        contexts={{
            title: 'Lo que se practica en conversación',
            intro: 'La conversación no se reduce a hablar por hablar. Usamos situaciones que obligan a elegir registro, explicar, matizar y reaccionar.',
            items: [
                {
                    label: 'Small talk',
                    title: 'Entrar y salir de conversaciones cotidianas',
                    body: 'Practicamos cómo empezar, sostener y cerrar conversaciones sobre planes, clima, ciudad, familia, trabajo o fin de semana sin quedarte en respuestas mínimas.',
                },
                {
                    label: 'Opinión',
                    title: 'Decir algo propio sin sonar brusco',
                    body: 'Trabajamos acuerdo, desacuerdo, matices, dudas y ejemplos para que puedas participar sin traducir literalmente desde tu idioma.',
                },
                {
                    label: 'Reparación',
                    title: 'Seguir hablando cuando falta una palabra',
                    body: 'Entrenas circunloquios, reformulaciones, preguntas de aclaración y estrategias para no abandonar la conversación cuando aparece un hueco.',
                },
                {
                    label: 'Cultura',
                    title: 'Entender referencias y ritmo social',
                    body: 'Usamos temas de España, ciudad, trabajo, humor y vida diaria para que la conversación tenga contexto y no sea sólo gramática disfrazada.',
                },
            ],
        }}
        answers={answers}
        lead={{
            title: 'HAZ UNA CONSULTA',
            subtitle: 'Si la oferta todavía no está abierta, cuéntanos tu nivel y tu disponibilidad.',
            interest: 'Conversación en español',
        }}
    />
</BaseLayout>
