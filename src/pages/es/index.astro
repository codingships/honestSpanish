---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LandingPage from '../../components/LandingPage.astro';
import { useTranslations } from '../../i18n/utils';
import { getLandingPageData } from '../../lib/landing-data';
import { buildLandingSchema } from '../../lib/landing-schema';

const lang = 'es';
const t = useTranslations(lang);
const { packages, isLoggedIn } = await getLandingPageData(Astro);
const schema = buildLandingSchema(lang, t, packages);
---

<BaseLayout 
  title={t('meta.title')} 
  description={t('meta.description')} 
  lang={lang}
  canonicalPath="/"
>
    <!-- Schema JSON-LD -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
    
    <LandingPage lang={lang} packages={packages} isLoggedIn={isLoggedIn} />
</BaseLayout>
