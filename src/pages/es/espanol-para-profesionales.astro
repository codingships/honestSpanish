---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SegmentLandingPage from '../../components/landing/SegmentLandingPage.astro';
import { getStaticLandingPackages } from '../../lib/landing-data';
import { serializeJsonForHtml, sha256CspHash } from '../../lib/csp';
import { ui } from '../../i18n/translations';

const lang = 'es';
export const prerender = true;
const packages = getStaticLandingPackages();

const schema = {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: 'Español para profesionales en España | Español Honesto',
    description: 'Clases de español para profesionales adultos que necesitan hablar con confianza en trabajo, reuniones, ciudad y vida real en España.',
    inLanguage: 'es-ES',
};

const answers = {
    title: 'Respuestas rápidas',
    intro: 'Lo esencial antes de comprar si necesitas español para trabajo y vida profesional.',
    items: [
        {
            question: '¿Qué es español para profesionales?',
            answer: 'Es una ruta de Español Honesto para adultos que necesitan usar el español en reuniones, entrevistas, clientes, equipo y vida diaria en España. No separa el trabajo de la cultura, porque una conversación profesional también depende del contexto.',
        },
        {
            question: '¿Qué se trabaja en las clases?',
            answer: 'Se trabaja conversación guiada, registro, claridad al intervenir, vocabulario de tu contexto y revisión de errores. También usamos ciudad, burocracia, humor y referencias culturales como material para sonar menos rígido y participar mejor.',
        },
        {
            question: '¿Qué incluye el curso?',
            answer: 'Incluye cuatro clases individuales online de 50 minutos por ciclo de 28 días, documento de clase con errores y vocabulario, tareas, calendario, Meet, recordatorios y soporte desde el campus.',
        },
        {
            question: '¿Para quién encaja?',
            answer: 'Encaja con profesionales adultos que quieren hablar con más precisión y presencia en su contexto real. Las clases se adaptan a lo que cada alumno ya puede entender y expresar; no necesitas acreditar ni conocer un nivel concreto antes de empezar.',
        },
        {
            question: '¿Cómo funciona la compra?',
            answer: 'La única oferta inicial son cuatro clases individuales de 50 minutos por 259 EUR, con renovación cada 28 días. Antes de pagar eliges una plaza real con profesor y franja semanal identificados.',
        },
    ],
};

const faqSchema = {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: answers.items.map((item) => ({
        '@type': 'Question',
        name: item.question,
        acceptedAnswer: {
            '@type': 'Answer',
            text: item.answer,
        },
    })),
};
const schemaJson = serializeJsonForHtml(schema);
const faqSchemaJson = serializeJsonForHtml(faqSchema);
Astro.csp?.insertScriptHash(await sha256CspHash(schemaJson));
Astro.csp?.insertScriptHash(await sha256CspHash(faqSchemaJson));

const pricingTranslations = ui.es.pricing;
---

<BaseLayout
    title="Español para profesionales en España | Español Honesto"
    description="Español online para profesionales adultos que necesitan hablar con confianza en reuniones, trabajo, vida diaria y conversaciones culturales en España."
    lang={lang}
    canonicalPath="/espanol-para-profesionales"
    alternateLangs={['es']}
>
    <script is:inline type="application/ld+json" set:html={schemaJson} />
    <script is:inline type="application/ld+json" set:html={faqSchemaJson} />

    <SegmentLandingPage
        lang={lang}
        navLabel="/ Profesionales"
        packages={packages}
        pricingTranslations={pricingTranslations}
        hero={{
            headline1: 'ESPAÑOL',
            headline2: 'PARA',
            headline3: 'PROFESIONALES',
            manifesto: 'Trabajo, cultura y conversación adulta',
            subtitle: 'Para profesionales que viven o quieren vivir en España y necesitan hablar con criterio, no sólo sobrevivir en reuniones.',
            ready: '¿Quieres trabajar mejor en español?',
            ctaText: 'VER OFERTA',
        }}
        problems={{
            headline: 'EL ESPAÑOL GENERAL SE QUEDA CORTO',
            subtext: 'Tu vida profesional no cabe en ejercicios genéricos.',
            statements: [
                'Puedes entender una reunión, pero te cuesta intervenir sin preparar cada frase.',
                'Sabes vocabulario, pero te falta registro para sonar claro, educado y natural.',
                'El trabajo no termina en la sala de reuniones: también está la comida, el café, la broma y el contexto.',
                'Quieres participar en España, no estar siempre traduciendo desde fuera.',
            ],
        }}
        method={{
            headline: 'Español para trabajar y estar presente',
            manifesto: 'REUNIONES • CIUDAD • CULTURA • CRITERIO',
            closing: 'No prometemos fluidez sin esfuerzo. Practicamos el español que usas con personas reales.',
            subtitle: 'Combinamos conversación guiada, corrección precisa y materiales conectados con tu vida profesional y cultural en España.',
            columns: [
                { number: '01', title: 'Tu contexto', description: 'Trabajamos con tus temas: reuniones, clientes, emails, entrevistas, equipo, ciudad o mudanza.' },
                { number: '02', title: 'Registro y presencia', description: 'Practicamos cómo pedir, discrepar, explicar, negociar o participar sin sonar rígido.' },
                { number: '03', title: 'España real', description: 'Madrid, Oviedo, Toledo, Barcelona, burocracia, humor y vida diaria como material de conversación.' },
            ],
        }}
        fit={{
            title: 'Para quién encaja',
            intro: 'No es un método milagro. Es para profesionales con objetivos concretos, curiosidad y ganas de trabajar desde su punto de partida.',
            items: [
                'Profesionales adultos que necesitan usar el español en su trabajo y su vida en España.',
                'Personas que valoran la profundidad, el seguimiento y una práctica sostenida.',
                'Alumnos que quieren hablar de trabajo, ciudad, cultura y vida real.',
                'Personas que aceptan que mejorar exige esfuerzo, constancia y conversación exigente.',
            ],
        }}
        community={{
            title: 'Una plaza concreta antes de pagar',
            body: 'La compra parte de una relación docente real, no de una promesa abstracta.',
            notes: [
                'Antes de pagar ves qué profesor impartirá tus clases.',
                'También ves la franja semanal y la primera fecha disponibles.',
                'En cada ciclo puedes activar la garantía proporcional sobre todas las clases todavía no consumidas.',
            ],
        }}
        contexts={{
            title: 'Situaciones profesionales que sí practicamos',
            intro: 'Practicamos escenas concretas de trabajo y vida profesional en España: reuniones, clientes, entrevistas, trámites y conversación social.',
            items: [
                {
                    label: 'Reuniones',
                    title: 'Intervenir sin preparar cada frase',
                    body: 'Practicamos cómo resumir, pedir aclaraciones, discrepar con educación, cerrar acuerdos y recuperar la palabra cuando la conversación va rápido.',
                },
                {
                    label: 'Clientes y equipo',
                    title: 'Registro profesional sin sonar rígido',
                    body: 'Trabajamos emails, llamadas, seguimiento, explicaciones de problemas y formas naturales de pedir, proponer o negociar en español.',
                },
                {
                    label: 'Entrevistas y presentaciones',
                    title: 'Contar tu experiencia con precisión',
                    body: 'Preparas respuestas, ejemplos, logros, dudas y cambios de tema para entrevistas, presentaciones internas o conversaciones con dirección.',
                },
                {
                    label: 'Vida profesional en España',
                    title: 'La parte que ocurre fuera de la reunión',
                    body: 'También practicamos café, comida, burocracia, ciudad, humor y referencias culturales, porque eso decide muchas conversaciones reales.',
                },
            ],
        }}
        answers={answers}
        lead={{
            title: 'HAZ UNA CONSULTA',
            subtitle: 'Si la oferta todavía no está abierta, cuéntanos tu nivel y tu disponibilidad.',
            interest: 'Español profesional',
        }}
    />
</BaseLayout>
