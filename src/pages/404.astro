---
import '../styles/fonts.css';

// 404 page - detects language or defaults to Spanish
Astro.response.status = 404;
Astro.response.headers.set('x-robots-tag', 'noindex, nofollow');
---

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="robots" content="noindex, nofollow">
    <title>Página no encontrada | Español Honesto</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        
        body {
            font-family: var(--font-eh-body);
            background-color: #E0F7FA;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }
        
        .container {
            text-align: center;
            max-width: 500px;
        }
        
        .error-code {
            font-family: var(--font-eh-display);
            font-size: 120px;
            color: #006064;
            line-height: 1;
            margin-bottom: 20px;
        }
        
        @media (min-width: 640px) {
            .error-code { font-size: 150px; }
        }
        
        .title {
            font-family: var(--font-eh-display);
            font-size: 24px;
            color: #006064;
            margin-bottom: 15px;
            text-transform: uppercase;
        }
        
        @media (min-width: 640px) {
            .title { font-size: 28px; }
        }
        
        .message {
            font-size: 16px;
            color: #006064;
            margin-bottom: 30px;
            line-height: 1.6;
        }
        
        .btn {
            display: inline-block;
            background-color: #006064;
            color: white;
            padding: 15px 40px;
            text-decoration: none;
            font-weight: bold;
            font-size: 14px;
            text-transform: uppercase;
            letter-spacing: 1px;
            border: 2px solid #006064;
            box-shadow: 4px 4px 0px 0px rgba(0,96,100,0.3);
            transition: all 0.2s;
        }
        
        .btn:hover {
            background-color: transparent;
            color: #006064;
            transform: translate(2px, 2px);
            box-shadow: 2px 2px 0px 0px rgba(0,96,100,0.3);
        }
        
        .brand {
            margin-top: 60px;
            font-family: var(--font-eh-wordmark);
            font-size: 14px;
            color: #006064;
            letter-spacing: 3px;
        }
        
        .emoji {
            font-size: 60px;
            margin-bottom: 20px;
        }
    </style>
</head>
<body>
    <main class="container">
        <div class="emoji">🤷‍♂️</div>
        <div class="error-code">404</div>
        <h1 class="title">Página no encontrada</h1>
        <p class="message">
            ¡Vaya! Parece que esta página se ha perdido en la traducción. 
            No te preocupes, incluso los mejores lingüistas se pierden a veces.
        </p>
        <a href="/es" class="btn" id="home-btn">Volver al inicio</a>
        <p class="brand">ESPAÑOL HONESTO</p>
    </main>

    <script>
        // Try to detect language from URL or browser
        const path = window.location.pathname;
        const langMatch = path.match(/^\/(es|en|ru)/);
        type PageLang = 'es' | 'en' | 'ru';
        const detectedLang = langMatch?.[1];
        const lang: PageLang = detectedLang === 'es' || detectedLang === 'en' || detectedLang === 'ru'
            ? detectedLang
            :
            (navigator.language.startsWith('ru') ? 'ru' : 
             navigator.language.startsWith('en') ? 'en' : 'es');
        
        const btn = document.getElementById('home-btn');
        if (btn instanceof HTMLAnchorElement) {
            btn.href = '/' + lang;
        }
        
        // Update text based on language
        const texts = {
            es: {
                title: 'Página no encontrada',
                message: '¡Vaya! Parece que esta página se ha perdido en la traducción. No te preocupes, incluso los mejores lingüistas se pierden a veces.',
                btn: 'Volver al inicio'
            },
            en: {
                title: 'Page not found',
                message: 'Oops! It seems this page got lost in translation. Don\'t worry, even the best linguists get lost sometimes.',
                btn: 'Back to home'
            },
            ru: {
                title: 'Страница не найдена',
                message: 'Упс! Похоже, эта страница потерялась в переводе. Не волнуйтесь, даже лучшие лингвисты иногда теряются.',
                btn: 'На главную'
            }
        };
        
        const t = texts[lang];
        const title = document.querySelector<HTMLElement>('.title');
        const message = document.querySelector<HTMLElement>('.message');
        const homeButton = document.getElementById('home-btn');
        if (title) title.textContent = t.title;
        if (message) message.textContent = t.message;
        if (homeButton) homeButton.textContent = t.btn;
        document.documentElement.lang = lang;
        document.title = `${t.title} | Español Honesto`;
    </script>
</body>
</html>
