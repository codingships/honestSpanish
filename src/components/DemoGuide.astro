    const clampIndex = (value) => Math.min(Math.max(value, 0), steps.length - 1);
    let index = clampIndex(Number.parseInt(safeStorage.getItem(STORAGE_INDEX) || '0', 10) || 0);
    let isBusy = false;
    let statusMessage = '';

    function normalizePath(url) {
        return `${url.pathname}${url.hash}`;
    }

    function routeMatches(route) {
        const target = new URL(route, window.location.origin);
        return window.location.pathname === target.pathname && (!target.hash || window.location.hash === target.hash);
    }

    function currentLang() {
        const [lang] = window.location.pathname.split('/').filter(Boolean);
        return ['es', 'en', 'ru'].includes(lang) ? lang : 'es';
    }

    function loginRoleLabel(role) {
        return {
            student: 'alumno',
            teacher: 'profesor',
            admin: 'admin',
        }[role] || role;
    }

    async function loginAs(role) {
        if (isBusy) return;

        isBusy = true;
        statusMessage = `Iniciando sesion como ${loginRoleLabel(role)}...`;
        render();

        try {
            const response = await fetch('/api/demo/login', {
                method: 'POST',
                credentials: 'same-origin',
                headers: {
                    'content-type': 'application/json',
                },
                body: JSON.stringify({ role, lang: currentLang() }),
            });
            const data = await response.json().catch(() => ({}));

            if (!response.ok) {
                throw new Error(data.error || `Login de demo fallo con HTTP ${response.status}.`);
            }

            index = clampIndex(index + 1);
            safeStorage.setItem(STORAGE_INDEX, String(index));
            window.location.assign(data.redirectTo || steps[index].route);
        } catch (error) {
            isBusy = false;
            statusMessage = error instanceof Error ? error.message : 'No se pudo iniciar sesion de demo.';
            render();
        }
    }

    function goToStep(nextIndex) {
        index = clampIndex(nextIndex);
        safeStorage.setItem(STORAGE_INDEX, String(index));
        statusMessage = '';
        const step = steps[index];
        if (!routeMatches(step.route)) {
            window.location.assign(step.route);
            return;
        }
        render();
    }

    function finish() {
        safeStorage.removeItem(STORAGE_ENABLED);
        safeStorage.removeItem(STORAGE_INDEX);
        document.getElementById('eh-guide-overlay')?.remove();
    }

    function togglePosition(overlay) {
        const current = safeStorage.getItem(STORAGE_POSITION) || 'right';
        const positions = ['right', 'left', 'top'];
        const next = positions[(positions.indexOf(current) + 1) % positions.length] || 'right';
        safeStorage.setItem(STORAGE_POSITION, next);
        safeStorage.removeItem(STORAGE_COORDS);
        overlay.classList.remove('eh-guide-right', 'eh-guide-left', 'eh-guide-top');
        overlay.classList.add(`eh-guide-${next}`);
        clearDynamicPosition(overlay);
    }

    function toggleCompact(overlay, button) {
        const compact = safeStorage.getItem(STORAGE_COMPACT) === '1' ? '0' : '1';
        safeStorage.setItem(STORAGE_COMPACT, compact);
        overlay.classList.toggle('eh-guide-compact', compact === '1');
        button.textContent = compact === '1' ? 'Expandir' : 'Compacto';
    }

    function makeButton(label, onClick, className = '') {
        const button = document.createElement('button');
        button.type = 'button';
        button.textContent = label;
        button.className = className;
        button.disabled = isBusy;
        button.addEventListener('click', onClick);
        return button;
    }

    function readCoords() {
        try {
            const parsed = JSON.parse(safeStorage.getItem(STORAGE_COORDS) || 'null');
            if (Number.isFinite(parsed?.left) && Number.isFinite(parsed?.top)) return parsed;
        } catch {
            return null;
        }

        return null;
    }

    function clampCoords(left, top, overlay) {
        const rect = overlay.getBoundingClientRect();
        const margin = 8;
        return {
            left: Math.max(margin, Math.min(left, window.innerWidth - rect.width - margin)),
            top: Math.max(margin, Math.min(top, window.innerHeight - rect.height - margin)),
        };
    }

    function applyCoords(overlay) {
        const coords = readCoords();
        if (!coords) return;

        const next = clampCoords(coords.left, coords.top, overlay);
        overlay.classList.remove('eh-guide-right', 'eh-guide-left', 'eh-guide-top');
        if (!setDynamicPosition(overlay, next.left, next.top)) return;
        safeStorage.setItem(STORAGE_COORDS, JSON.stringify(next));
    }

    function enableDrag(overlay, handle) {
        if (handle.dataset.ehGuideDragReady === '1') return;
        handle.dataset.ehGuideDragReady = '1';

        let dragging = false;
        let offsetX = 0;
        let offsetY = 0;

        const move = (event) => {
            if (!dragging) return;
            const next = clampCoords(event.clientX - offsetX, event.clientY - offsetY, overlay);
            if (setDynamicPosition(overlay, next.left, next.top)) {
                safeStorage.setItem(STORAGE_COORDS, JSON.stringify(next));
            }
        };

        const stop = (event) => {
            if (!dragging) return;
            dragging = false;
            overlay.classList.remove('eh-guide-dragging');
            try {
                handle.releasePointerCapture(event.pointerId);
            } catch {
                // Pointer capture may already be released if the page changed focus.
            }
            window.removeEventListener('pointermove', move);
            window.removeEventListener('pointerup', stop);
            window.removeEventListener('pointercancel', stop);
        };

        handle.addEventListener('pointerdown', (event) => {
            if (event.target instanceof HTMLButtonElement || event.target instanceof HTMLAnchorElement) return;
            const rect = overlay.getBoundingClientRect();
            dragging = true;
            offsetX = event.clientX - rect.left;
            offsetY = event.clientY - rect.top;
            try {
                handle.setPointerCapture(event.pointerId);
            } catch {
                // Global listeners below keep dragging stable if capture is unavailable.
            }
            overlay.classList.add('eh-guide-dragging');
            window.addEventListener('pointermove', move);
            window.addEventListener('pointerup', stop);
            window.addEventListener('pointercancel', stop);
            event.preventDefault();
        });

        handle.addEventListener('mousedown', (event) => {
            if ('PointerEvent' in window) return;
            if (event.target instanceof HTMLButtonElement || event.target instanceof HTMLAnchorElement) return;
            const rect = overlay.getBoundingClientRect();
            dragging = true;
            offsetX = event.clientX - rect.left;
            offsetY = event.clientY - rect.top;
            overlay.classList.add('eh-guide-dragging');
            const mouseMove = (moveEvent) => move(moveEvent);
            const mouseStop = () => {
                dragging = false;
                overlay.classList.remove('eh-guide-dragging');
                window.removeEventListener('mousemove', mouseMove);
                window.removeEventListener('mouseup', mouseStop);
            };
            window.addEventListener('mousemove', mouseMove);
            window.addEventListener('mouseup', mouseStop);
            event.preventDefault();
        });
    }

    function render() {
        const step = steps[index];
        let overlay = document.getElementById('eh-guide-overlay');
        if (!overlay) {
            overlay = document.createElement('section');
            overlay.id = 'eh-guide-overlay';
            document.body.append(overlay);
        }

        overlay.title = 'Arrastra el panel para moverlo.';
        overlay.setAttribute('role', 'region');
        overlay.setAttribute('aria-label', 'Guia de demo');
        const position = safeStorage.getItem(STORAGE_POSITION) || 'right';
        const compact = safeStorage.getItem(STORAGE_COMPACT) === '1';
        clearDynamicPosition(overlay);
        overlay.className = `eh-guide-${position}${compact ? ' eh-guide-compact' : ''}`;
        overlay.replaceChildren();

        const top = document.createElement('div');
        top.className = 'eh-guide-topline';
        top.setAttribute('aria-label', 'Arrastrar guia de demo');
        const counter = document.createElement('span');
        counter.textContent = `Paso ${index + 1} de ${steps.length}`;
        const badge = document.createElement('span');
        badge.className = 'eh-guide-badge';
        badge.textContent = step.section;
        const tools = document.createElement('div');
        tools.className = 'eh-guide-tools';
        const moveButton = makeButton('Posicion', () => togglePosition(overlay));
        const compactButton = makeButton(compact ? 'Expandir' : 'Compacto', () => toggleCompact(overlay, compactButton));
        tools.append(moveButton, compactButton);
        top.append(counter, badge, tools);
        enableDrag(overlay, top);

        const title = document.createElement('h2');
        title.textContent = step.title;

        const status = document.createElement('p');
        status.className = 'eh-guide-status';
        status.setAttribute('role', 'status');
        status.setAttribute('aria-live', 'polite');
        status.textContent = statusMessage;
        status.hidden = !statusMessage;

        const copy = document.createElement('div');
        copy.className = 'eh-guide-copy';
        for (const [label, value] of [['Que se ensena', step.what], ['Validacion', step.validate], ['Riesgo', step.risk], ['Ruta', normalizePath(new URL(step.route, window.location.origin))]]) {
            const row = document.createElement('div');
            const rowLabel = document.createElement('span');
            rowLabel.className = 'eh-guide-label';
            rowLabel.textContent = label;
            const text = document.createElement('p');
            text.textContent = value;
            row.append(rowLabel, text);
            copy.append(row);
        }

        const actions = document.createElement('div');
        actions.className = 'eh-guide-actions';
        const nextButton = makeButton(routeMatches(step.route) ? 'Siguiente' : 'Ir al paso', () => {
            if (!routeMatches(step.route)) {
                window.location.assign(step.route);
                return;
            }
            goToStep(index + 1);
        }, step.loginRole ? '' : 'eh-guide-primary');
        actions.append(
            makeButton('Anterior', () => goToStep(index - 1)),
            makeButton('Finalizar', finish, 'eh-guide-danger'),
        );
        if (step.loginRole) {
            actions.append(
                nextButton,
                makeButton(`Entrar como ${loginRoleLabel(step.loginRole)}`, () => loginAs(step.loginRole), 'eh-guide-primary'),
            );
        } else {
            actions.append(nextButton);
        }

        overlay.append(top, title, status, copy, actions);
        applyCoords(overlay);
    }

    window.addEventListener('pageshow', render);
    window.addEventListener('resize', () => {
        const overlay = document.getElementById('eh-guide-overlay');
        if (overlay) applyCoords(overlay);
    });
    render();
})();
</script>

