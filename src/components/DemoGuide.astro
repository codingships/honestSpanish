    const STORAGE_COMPACT = 'ehDemoGuideCompact';

    const safeStorage = {
        getItem(key) {
            try {
                return window.localStorage.getItem(key);
            } catch {
                return null;
            }
        },
        setItem(key, value) {
            try {
                window.localStorage.setItem(key, value);
            } catch {
                // Demo mode must remain usable in hardened browser storage modes.
            }
        },
        removeItem(key) {
            try {
                window.localStorage.removeItem(key);
            } catch {
                // Ignore blocked storage during demo cleanup/reset.
            }
        },
    };

    let dynamicPositionRule;

    function getDynamicPositionRule() {
        if (dynamicPositionRule !== undefined) return dynamicPositionRule;

        dynamicPositionRule = null;
        for (const styleSheet of Array.from(document.styleSheets)) {
            try {
                for (const rule of Array.from(styleSheet.cssRules)) {
                    if (
                        rule instanceof CSSStyleRule &&
                        rule.selectorText === '#eh-guide-overlay.eh-guide-dragged'
                    ) {
                        dynamicPositionRule = rule;
                        return dynamicPositionRule;
                    }
                }
            } catch {
                // Cross-origin font stylesheets do not expose cssRules.
            }
        }

        return dynamicPositionRule;
    }

    function clearDynamicPosition(overlay) {
        overlay.classList.remove('eh-guide-dragged');
        const rule = getDynamicPositionRule();
        rule?.style.removeProperty('left');
        rule?.style.removeProperty('right');
        rule?.style.removeProperty('top');
        rule?.style.removeProperty('bottom');
    }

    function setDynamicPosition(overlay, left, top) {
        const rule = getDynamicPositionRule();
        if (!rule) return false;

        rule.style.setProperty('left', `${left}px`);
        rule.style.setProperty('top', `${top}px`);
        rule.style.setProperty('right', 'auto');
        rule.style.setProperty('bottom', 'auto');
        overlay.classList.add('eh-guide-dragged');
        return true;
    }

    const params = new URLSearchParams(window.location.search);
    const demoParam = params.get('demo');
    const isTryCloudflareHost = window.location.hostname.endsWith('.trycloudflare.com');
    const shouldEnable = demoParam === 'guide' || demoParam === '1' || demoParam === 'true';
    const requestedLauncher = demoParam === 'launcher' || params.get('demoLauncher') === '1';
    const shouldShowLauncher = isTryCloudflareHost || requestedLauncher;
    const shouldDisable = demoParam === 'off' || demoParam === 'false';
    const shouldReset = params.get('demoStart') === '1' || params.get('resetDemo') === '1';

    if (shouldDisable) {
        safeStorage.removeItem(STORAGE_ENABLED);
        safeStorage.removeItem(STORAGE_INDEX);
        return;
    }

    if (shouldEnable) {
        safeStorage.setItem(STORAGE_ENABLED, '1');
    }

    if (requestedLauncher && shouldReset) {
        safeStorage.removeItem(STORAGE_ENABLED);
    }

    if (shouldReset) {
        safeStorage.setItem(STORAGE_INDEX, '0');
        safeStorage.removeItem(STORAGE_COORDS);
    }

    const guideEnabled = shouldEnable || safeStorage.getItem(STORAGE_ENABLED) === '1';

    if (!guideEnabled) {
