---
interface Props {
    value: number;
    max: number;
    label: string;
    rounded?: boolean;
}

const { value, max, label, rounded = false } = Astro.props;
const safeMax = Number.isFinite(max) && max > 0 ? max : 1;
const safeValue = Number.isFinite(value) ? Math.min(Math.max(value, 0), safeMax) : 0;
---

<progress
    class:list={['session-progress', { 'session-progress--rounded': rounded }]}
    value={safeValue}
    max={safeMax}
    aria-label={label}
></progress>

<style>
    .session-progress {
        appearance: none;
        display: block;
        width: 100%;
        height: 0.75rem;
        overflow: hidden;
        border: 1px solid #006064;
        background: #e0f7fa;
    }

    .session-progress--rounded {
        border-color: rgb(0 96 100 / 20%);
        border-radius: 9999px;
    }

    .session-progress::-webkit-progress-bar {
        background: #e0f7fa;
    }

    .session-progress::-webkit-progress-value {
        background: #006064;
        transition: width 150ms ease;
    }

    .session-progress::-moz-progress-bar {
        background: #006064;
        transition: width 150ms ease;
    }
</style>
