---
interface Props {
    lang: string;
}

const { lang } = Astro.props;

const texts = {
    es: {
        notice: 'Aviso de cookies',
        message: 'Utilizamos cookies técnicas para el funcionamiento del sitio.',
        accept: 'Aceptar',
        more: 'Política de cookies'
    },
    en: {
        notice: 'Cookie notice',
        message: 'We use technical cookies for the site to function.',
        accept: 'Accept',
        more: 'Cookie policy'
    },
    ru: {
        notice: 'Уведомление о cookies',
        message: 'Мы используем технические файлы cookie для работы сайта.',
        accept: 'Принять',
        more: 'Политика использования файлов cookie'
    }
};

const t = texts[lang as keyof typeof texts] || texts.es;
---

<div 
    id="cookie-banner" 
    role="region"
    aria-label={t.notice}
    aria-hidden="true"
    class="fixed bottom-0 left-0 right-0 bg-[#006064] text-white p-4 z-50 transform translate-y-full transition-transform duration-300"
    data-visible="false"
    hidden
>
    <div class="max-w-6xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-4">
        <p class="text-sm text-center sm:text-left">
            {t.message}
            <a href={`/${lang}/legal/cookies`} class="underline hover:no-underline ml-1">{t.more}</a>
        </p>
        <button 
            id="accept-cookies"
            type="button"
            class="px-6 py-2 bg-white text-[#006064] font-bold text-sm uppercase hover:bg-[#E0F7FA] transition-colors whitespace-nowrap border-2 border-white"
        >
            {t.accept}
        </button>
    </div>
</div>

<style is:global>
    :root {
        --cookie-banner-reserved-space: 11rem;
    }

    #cookie-banner {
        min-height: var(--cookie-banner-reserved-space);
    }

    html[data-cookie-banner-visible="true"] body {
        padding-bottom: var(--cookie-banner-reserved-space);
    }

    @media (min-width: 640px) {
        :root {
            --cookie-banner-reserved-space: 6rem;
        }
    }
</style>

<script>
    const banner = document.getElementById('cookie-banner');
    const acceptBtn = document.getElementById('accept-cookies');

    const getStorageItem = (key: string) => {
        try {
            return window.localStorage.getItem(key);
        } catch {
            return null;
        }
    };

    const setStorageItem = (key: string, value: string) => {
        try {
            window.localStorage.setItem(key, value);
        } catch {
            // Storage can be blocked in private or hardened browser modes.
        }
    };

    const setFocusableState = (enabled: boolean) => {
        banner?.querySelectorAll('a, button').forEach((element) => {
            if (enabled) {
                element.removeAttribute('tabindex');
            } else {
                element.setAttribute('tabindex', '-1');
            }
        });
    };

    const reservePageOffset = () => {
        if (!banner || banner.getAttribute('data-visible') !== 'true') return;
        document.documentElement.setAttribute('data-cookie-banner-visible', 'true');
    };

    const clearPageOffset = () => {
        document.documentElement.removeAttribute('data-cookie-banner-visible');
    };

    const showBanner = () => {
        banner?.removeAttribute('hidden');
        banner?.setAttribute('aria-hidden', 'false');
        banner?.setAttribute('data-visible', 'true');
        setFocusableState(true);
        window.requestAnimationFrame(() => {
            banner?.classList.remove('translate-y-full');
            reservePageOffset();
        });
    };

    const hideBanner = () => {
        banner?.classList.add('translate-y-full');
        banner?.setAttribute('aria-hidden', 'true');
        banner?.setAttribute('data-visible', 'false');
        setFocusableState(false);
        window.setTimeout(() => {
            if (banner?.getAttribute('data-visible') === 'false') {
                banner.setAttribute('hidden', '');
                clearPageOffset();
            }
        }, 300);
    };

    setFocusableState(false);

    if (!getStorageItem('cookie_consent')) {
        setTimeout(() => {
            showBanner();
        }, 1000);
    }
    
    acceptBtn?.addEventListener('click', () => {
        setStorageItem('cookie_consent', 'accepted');
        setStorageItem('cookie_consent_date', new Date().toISOString());
        hideBanner();
    });
</script>
