---
import { Image } from 'astro:assets';
import { useTranslations, getLocalizedPath } from '../i18n/utils';
import { ui } from '../i18n/translations';
import type { LandingPackage } from '../lib/landing-data';
import PricingSection from './PricingSection';
import madridAtmosphere from '../assets/madrid_atmosphere.png';
import avatarAlejandro from '../assets/avatar_alejandro_team.png';
import avatarAlin from '../assets/avatar_alin_team.png';
import avatarIrene from '../assets/avatar_irene_team.png';
import HeroSection from './landing/HeroSection.astro';
import ProblemsSection from './landing/ProblemsSection.astro';
import MethodSection from './landing/MethodSection.astro';
import LevelsSection from './landing/LevelsSection.astro';
import LeadCaptureForm from './LeadCaptureForm.tsx';

interface Props {
  lang: 'es' | 'en' | 'ru';
  packages: LandingPackage[];
  isLoggedIn: boolean;
}

const { lang, packages, isLoggedIn } = Astro.props;
const t = useTranslations(lang);
const localizedUi = ui[lang];
// Public pricing always starts with a reviewed application. Approved checkout
// is exposed only inside the authenticated campus.
const checkoutMode = 'application' as const;

// Data structure helper for complex arrays 
const problemsStatements = localizedUi.problems.statements;
const methodColumns = localizedUi.method.columns;
const progressLevels = localizedUi.progress.levels;
const teamMembers = localizedUi.team.members;
const faqItems = localizedUi.faq.items;
const leadCaptureTranslations = localizedUi.leadCapture;

