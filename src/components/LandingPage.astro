const communityDetails = {
    es: {
        eyebrow: 'Contacto y comunidad',
        title: 'Comunidad con encaje, no grupos de relleno',
        intro: 'Queremos que el español sea una forma de entrar en España: conversación guiada, materiales compartidos y práctica con otros alumnos sólo cuando tenga sentido.',
        points: [
            'Primero conocemos nivel, intereses y ritmo; después proponemos grupo si hay compatibilidad real.',
            'El contacto con España entra en temas, worksheets y conversación: Madrid, Oviedo, Toledo, Barcelona, trabajo, ciudad y cultura.',
            'Si todavía no hay grupo compatible, seguimos con clases privadas y materiales útiles. No vendemos una comunidad artificial.',
        ],
    },
    en: {
        eyebrow: 'Contact and community',
        title: 'Community by fit, not filler groups',
        intro: 'We want Spanish to become a way into Spain: guided conversation, shared materials and practice with other students only when it makes sense.',
        points: [
            'First we learn your level, interests and rhythm; then we suggest a group if there is real compatibility.',
            'Contact with Spain appears in topics, worksheets and conversation: Madrid, Oviedo, Toledo, Barcelona, work, city life and culture.',
