const pricingTranslations = {
    ...localizedUi.pricing,
    plans: launchPricingPlans,
};

const ireneMemberByLang = {
    es: {
        name: 'IRENE',
        role: 'Profesora',
        languages: ['ES', 'EN', 'CS', 'FR', 'LSE'],
        bio: 'Profesora de español con perfil internacional y comunicación accesible en español, inglés, checo, francés y lengua de signos española.',
    },
    en: {
        name: 'IRENE',
        role: 'Teacher',
        languages: ['ES', 'EN', 'CS', 'FR', 'LSE'],
