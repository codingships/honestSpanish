    },
    en: {
        group: {
            name: 'External group',
            description: 'Guided conversation with compatible students when a group is available.',
            features: [],
        },
        standard: {
            name: 'Standard monthly',
            description: 'Weekly private classes with clear progress tracking.',
            features: [],
        },
        hybrid: {
            name: 'Hybrid monthly',
            description: 'The main plan: private classes, compatible group practice and two-teacher follow-up.',
            features: [],
        },
        bootcamp: {
            name: 'Intensive bootcamp',
