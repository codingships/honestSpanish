        heroAlt: 'Estudiante practicando español',
        atmosphereAlt: 'Vista urbana de Madrid',
    },
    en: {
        skip: 'Skip to main content',
        primaryNav: 'Primary navigation',
        openMenu: 'Open menu',
        closeMenu: 'Close menu',
        mobileMenu: 'Main menu',
        heroAlt: 'Student practising Spanish',
        atmosphereAlt: 'Urban view of Madrid',
    },
    ru: {
        skip: 'Перейти к основному содержанию',
        primaryNav: 'Основная навигация',
        openMenu: 'Открыть меню',
        closeMenu: 'Закрыть меню',
        mobileMenu: 'Главное меню',
        heroAlt: 'Ученик практикует испанский язык',
        atmosphereAlt: 'Городской вид Мадрида',
