    ru: {
        name: 'IRENE',
        role: 'Преподаватель',
        languages: ['ES', 'EN', 'CS', 'FR', 'LSE'],
        bio: 'Преподаватель испанского с международным профилем: испанский, английский, чешский, французский и испанский жестовый язык.',
    },
}[lang];

const teamMembersWithIrene = [...teamMembers, ireneMemberByLang];
const teamImages = [avatarAlejandro, avatarAlin, avatarIrene];
const accessibilityCopy = {
    es: {
        skip: 'Saltar al contenido principal',
        primaryNav: 'Navegación principal',
