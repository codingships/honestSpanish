            features: [],
        },
        standard: {
            name: 'Стандартный месяц',
            description: 'Еженедельные индивидуальные занятия с понятным отслеживанием прогресса.',
            features: [],
        },
        hybrid: {
            name: 'Гибридный месяц',
            description: 'Основной план: индивидуальные занятия, совместимая группа и сопровождение двух преподавателей.',
            features: [],
