<script>
    const faqCloseDelayMs = 300;
    const faqButtons = document.querySelectorAll<HTMLButtonElement>('[data-faq-button]');

    const setFaqOpen = (button: HTMLButtonElement, isOpen: boolean) => {
        const index = button.getAttribute('data-faq-button');
        const content = document.getElementById(`faq-content-${index}`);
        const icon = button.querySelector<HTMLElement>('.faq-icon');

        if (!content) return;

        button.setAttribute('aria-expanded', String(isOpen));
        content.setAttribute('aria-hidden', String(!isOpen));

        if (isOpen) {
            content.hidden = false;
            requestAnimationFrame(() => {
                content.classList.remove('max-h-0', 'opacity-0');
                content.classList.add('max-h-[64rem]', 'opacity-100');
            });
            icon?.classList.add('rotate-45');
            return;
        }

        content.classList.add('max-h-0', 'opacity-0');
        content.classList.remove('max-h-[64rem]', 'opacity-100');
        icon?.classList.remove('rotate-45');

        window.setTimeout(() => {
            if (button.getAttribute('aria-expanded') !== 'true') {
                content.hidden = true;
            }
        }, faqCloseDelayMs);
    };

    faqButtons.forEach(button => {
        button.addEventListener('click', () => {
            const isExpanded = button.getAttribute('aria-expanded') === 'true';

            faqButtons.forEach(otherButton => {
                if (otherButton !== button) setFaqOpen(otherButton, false);
            });

            setFaqOpen(button, !isExpanded);
        });
    });

    // Mobile Menu Logic
    const menuBtn = document.getElementById('mobile-menu-btn');
    const overlay = document.getElementById('mobile-overlay');
    const mobileLinks = document.querySelectorAll('.mobile-link');
    const menuCloseDelayMs = 300;
    let menuCloseTimer = 0;
    let isMenuOpen = false;

    const setMenuOpen = (nextOpen: boolean) => {
        isMenuOpen = nextOpen;
        menuBtn?.setAttribute('aria-expanded', String(isMenuOpen));
        if (menuBtn) {
            const nextLabel = isMenuOpen ? menuBtn.dataset.closeLabel : menuBtn.dataset.openLabel;
            if (nextLabel) menuBtn.setAttribute('aria-label', nextLabel);
        }

        if (isMenuOpen) {
            window.clearTimeout(menuCloseTimer);
            if (overlay) {
                overlay.hidden = false;
                overlay.removeAttribute('inert');
                overlay.setAttribute('aria-hidden', 'false');
                requestAnimationFrame(() => {
                    overlay.classList.remove('translate-x-full');
                    overlay.classList.add('translate-x-0');
                });
            }
            menuBtn?.classList.add('is-open', 'bg-transparent', 'text-white', 'border-transparent');
            menuBtn?.classList.remove('bg-[#E0F7FA]', 'text-[#006064]', 'border-[#006064]');
            document.body.classList.add('overflow-hidden');
        } else {
            if (overlay) {
                overlay.classList.add('translate-x-full');
                overlay.classList.remove('translate-x-0');
                overlay.setAttribute('aria-hidden', 'true');
                overlay.setAttribute('inert', '');
                menuCloseTimer = window.setTimeout(() => {
                    if (!isMenuOpen) overlay.hidden = true;
                }, menuCloseDelayMs);
            }
            menuBtn?.classList.remove('is-open', 'bg-transparent', 'text-white', 'border-transparent');
            menuBtn?.classList.add('bg-[#E0F7FA]', 'text-[#006064]', 'border-[#006064]');
            document.body.classList.remove('overflow-hidden');
        }
    };

    const toggleMenu = () => setMenuOpen(!isMenuOpen);

    menuBtn?.addEventListener('click', toggleMenu);

    document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && isMenuOpen) {
            setMenuOpen(false);
            menuBtn?.focus();
        }
    });

    mobileLinks.forEach(link => {
        link.addEventListener('click', () => {
            if (isMenuOpen) setMenuOpen(false);
        });
    });
</script>
