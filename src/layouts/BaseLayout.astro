---
import '../styles/fonts.css';
import '../styles/global.css';
import CookieBanner from '../components/CookieBanner.astro';
import DemoGuide from '../components/DemoGuide.astro';
import EnvironmentBanner from '../components/EnvironmentBanner.astro';
import FontPreloads from '../components/FontPreloads.astro';
import {
  PUBLIC_LANGS,
  absolutePublicUrl,
  isPublicLang,
  publicUrl,
  unlocalizePublicPath,
  type LocalizedPublicPaths,
  type PublicLang,
} from '../lib/public-seo';

interface Props {
  title: string;
  description: string;
  lang: string;
  canonicalPath?: string;
  alternateLangs?: PublicLang[];
  alternatePaths?: LocalizedPublicPaths;
  noindex?: boolean;
  ogImage?: string;
  ogImageAlt?: string;
  ogImageWidth?: number;
  ogImageHeight?: number;
  contentType?: 'website' | 'article';
  rssPath?: string;
}

const {
  title,
  description,
  lang,
  canonicalPath,
  alternateLangs = ['es', 'en', 'ru'],
  alternatePaths,
  noindex = false,
  ogImage = '/og/home.png',
  ogImageAlt,
  ogImageWidth = 1200,
  ogImageHeight = 630,
  contentType = 'website',
  rssPath,
} = Astro.props;

if (!isPublicLang(lang)) throw new Error('Unsupported public page language: ' + lang);
const pageLang: PublicLang = lang;
const appEnvironment = (import.meta.env.PUBLIC_APP_ENV || '').trim().toLowerCase();
const publicSiteUrl = (import.meta.env.PUBLIC_SITE_URL || '').toLowerCase();
const requestHost = Astro.url.hostname.toLowerCase();
const environmentMarker = `${appEnvironment} ${publicSiteUrl} ${requestHost}`;
const showEnvironmentBanner = appEnvironment === 'staging'
  || appEnvironment === 'test'
  || environmentMarker.includes('staging')
  || requestHost.endsWith('.pages.dev');
const shouldNoindex = noindex || appEnvironment === 'staging';
const brandName = 'Espa' + String.fromCodePoint(0x00F1) + 'ol Honesto';
const resolvedOgImageAlt = ogImageAlt || brandName + ' | ' + title;
const demoGuideEnabled = import.meta.env.DEMO_GUIDE_ENABLED === 'true';
const canonicalRoute = canonicalPath ?? unlocalizePublicPath(Astro.url.pathname);
const canonicalUrl = publicUrl(pageLang, canonicalRoute);
const ogImageUrl = absolutePublicUrl(ogImage);
const resolvedAlternateLangs = alternatePaths
  ? PUBLIC_LANGS.filter((alternateLang) => Boolean(alternatePaths[alternateLang]))
  : alternateLangs;
const enabledAlternateLangs = new Set<PublicLang>(resolvedAlternateLangs);
const xDefaultLang = enabledAlternateLangs.has('en') ? 'en' : undefined;
const isIndexableSurface = !noindex;

Astro.response.headers.set('Content-Type', 'text/html; charset=utf-8');

const getAlternateUrl = (targetLang: PublicLang): string => {
  const alternatePath = alternatePaths?.[targetLang] ?? canonicalRoute;
  return publicUrl(targetLang, alternatePath);
};
---

<!doctype html>
<html
  lang={pageLang}
  data-app-environment={appEnvironment || undefined}
  data-environment-banner={showEnvironmentBanner ? 'true' : undefined}
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#006064" />

    <link rel="icon" type="image/png" sizes="64x64" href="/favicon-64.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <FontPreloads lang={pageLang} />

    <title>{title}</title>
    <meta name="description" content={description} />

    {shouldNoindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content={contentType} />
    <meta property="og:site_name" content={brandName} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content={String(ogImageWidth)} />
    <meta property="og:image:height" content={String(ogImageHeight)} />
    <meta property="og:image:alt" content={resolvedOgImageAlt} />
    <meta property="og:locale" content={pageLang === 'es' ? 'es_ES' : pageLang === 'en' ? 'en_US' : 'ru_RU'} />
    {resolvedAlternateLangs.filter((alternateLang) => alternateLang !== pageLang).map((alternateLang) => (
      <meta property="og:locale:alternate" content={alternateLang === 'es' ? 'es_ES' : alternateLang === 'en' ? 'en_US' : 'ru_RU'} />
    ))}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={resolvedOgImageAlt} />

    {isIndexableSurface && <link rel="canonical" href={canonicalUrl} />}
    {isIndexableSurface && enabledAlternateLangs.has('es') && <link rel="alternate" hreflang="es" href={getAlternateUrl('es')} />}
    {isIndexableSurface && enabledAlternateLangs.has('en') && <link rel="alternate" hreflang="en" href={getAlternateUrl('en')} />}
    {isIndexableSurface && enabledAlternateLangs.has('ru') && <link rel="alternate" hreflang="ru" href={getAlternateUrl('ru')} />}
    {isIndexableSurface && xDefaultLang && <link rel="alternate" hreflang="x-default" href={getAlternateUrl(xDefaultLang)} />}

    {isIndexableSurface && rssPath && (
      <link rel="alternate" type="application/rss+xml" title={brandName + ' Blog'} href={absolutePublicUrl(rssPath)} />
    )}
    <slot name="head" />

  </head>
  <body>
    <EnvironmentBanner lang={pageLang} visible={showEnvironmentBanner} />
    <slot />
    {demoGuideEnabled && <DemoGuide />}
    <CookieBanner lang={pageLang} />
  </body>
</html>
