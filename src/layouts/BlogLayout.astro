---
import type { CollectionEntry } from 'astro:content';
import TableOfContents from '../components/blog/TableOfContents.astro';
import { getLocalizedPath, useTranslations } from '../i18n/utils';
import { getBlogAuthor, getBlogAuthorSchema } from '../lib/blog-authors';
import { getBlogEntrySlug, getBlogOgKey } from '../lib/blog-routes';
import { serializeJsonForHtml, sha256CspHash } from '../lib/csp';
import { absolutePublicUrl, publicUrl, type LocalizedPublicPaths, type PublicLang } from '../lib/public-seo';
import BaseLayout from './BaseLayout.astro';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  post: CollectionEntry<'blog'>;
  lang: PublicLang;
  alternatePaths: LocalizedPublicPaths;
  headings?: Heading[];
}

const { post, lang, alternatePaths, headings } = Astro.props;
const t = useTranslations(lang);
const { title, description, publishedAt, image, category, author } = post.data;
const authorDetails = getBlogAuthor(author);
const postSlug = getBlogEntrySlug(post);
const canonicalPath = '/blog/' + postSlug;
const canonicalUrl = publicUrl(lang, canonicalPath);
const ogImage = image?.src ?? '/og/' + getBlogOgKey(post) + '.png';
const imageUrl = absolutePublicUrl(ogImage);
const imageWidth = image?.width ?? 1200;
const imageHeight = image?.height ?? 630;

const formattedDate = publishedAt.toLocaleDateString(lang, {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  image: {
    '@type': 'ImageObject',
    url: imageUrl,
    width: imageWidth,
    height: imageHeight,
  },
  datePublished: publishedAt.toISOString(),
  dateModified: (post.data.updatedAt ?? publishedAt).toISOString(),
  inLanguage: lang,
  author: getBlogAuthorSchema(author),
  publisher: {
    '@type': 'Organization',
    name: 'Español Honesto',
    url: 'https://espanolhonesto.com',
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': canonicalUrl,
  },
  isPartOf: {
    '@type': 'Blog',
    '@id': publicUrl(lang, '/blog'),
    name: 'Español Honesto Blog',
  },
};
const articleSchemaJson = serializeJsonForHtml(articleSchema);
Astro.csp?.insertScriptHash(await sha256CspHash(articleSchemaJson));

function ctaHref(customLink: string | undefined): string {
  if (!customLink) return '/' + lang + '/#planes';
  if (!customLink.startsWith('/')) return customLink;
  const internalPath = customLink.split(/[?#]/u, 1)[0];
  return `/${lang}${internalPath}#planes`;
}

const blogCta = {
  es: {
    heading: post.data.ctaText || '¿Quieres llevar esto a una conversación real?',
    button: 'Ver plazas',
    contact: 'Hacer una consulta',
    href: ctaHref(post.data.ctaLink),
  },
  en: {
    heading: post.data.ctaText || 'Want to turn this into real conversation?',
    button: 'View places',
    contact: 'Ask a question',
    href: ctaHref(post.data.ctaLink),
  },
  ru: {
    heading: post.data.ctaText || 'Хотите перейти к живой разговорной практике?',
    button: 'Посмотреть места',
    contact: 'Задать вопрос',
    href: ctaHref(post.data.ctaLink),
  },
}[lang];

const accessibilityCopy = {
  es: { skip: 'Saltar al contenido principal', breadcrumb: 'Ruta de navegación' },
  en: { skip: 'Skip to main content', breadcrumb: 'Breadcrumb' },
  ru: { skip: 'Перейти к основному содержанию', breadcrumb: 'Навигационная цепочка' },
}[lang];
---

<BaseLayout
  title={title + ' | Español Honesto Blog'}
  description={description}
  lang={lang}
  ogImage={ogImage}
  ogImageWidth={imageWidth}
  ogImageHeight={imageHeight}
  contentType="article"
  canonicalPath={canonicalPath}
  alternatePaths={alternatePaths}
  rssPath={'/' + lang + '/blog/rss.xml'}
>
    <Fragment slot="head">
      <meta property="article:published_time" content={publishedAt.toISOString()} />
      <meta property="article:modified_time" content={(post.data.updatedAt ?? publishedAt).toISOString()} />
      <meta property="article:section" content={category} />
      {post.data.tags.map((tag) => <meta property="article:tag" content={tag} />)}
    </Fragment>
    <script is:inline type="application/ld+json" set:html={articleSchemaJson} />

    <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:bg-white focus:px-4 focus:py-3 focus:font-bold focus:text-[#006064] focus:outline focus:outline-4 focus:outline-[#006064]">
        {accessibilityCopy.skip}
    </a>
    <div class="bg-white min-h-screen text-[#006064] font-sans">
        <nav aria-label={accessibilityCopy.breadcrumb} class="bg-[#E0F7FA] py-4 px-6 border-b-2 border-[#006064]">
            <div class="max-w-4xl mx-auto flex items-center text-sm font-mono uppercase tracking-wide text-[#006064]">
                <a href={getLocalizedPath('/', lang)} class="hover:underline">{t('common.home')}</a>
                <span aria-hidden="true" class="mx-2">/</span>
                <a href={getLocalizedPath('/blog', lang)} class="hover:underline">{t('common.blog')}</a>
                <span aria-hidden="true" class="mx-2">/</span>
                <span aria-current="page" class="truncate">{title}</span>
            </div>
        </nav>

        <main id="main-content" tabindex="-1">
          <article class="max-w-4xl mx-auto px-6 py-12">
            <header class="mb-12 text-center">
                <div class="inline-block bg-[#006064]/10 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider mb-6">
                    {category}
                </div>
                <h1 class="font-display text-4xl md:text-5xl lg:text-6xl mb-6 leading-tight">
                    {title}
                </h1>
                <div class="flex items-center justify-center gap-4 text-sm font-mono text-[#006064] uppercase">
                    <span>{formattedDate}</span>
                    <span>•</span>
                    <span>{authorDetails.name}</span>
                </div>
            </header>

            {image && (
                <div class="mb-12 border-2 border-[#006064] overflow-hidden rounded-lg aspect-video">
                    <img
                        src={image.src}
                        alt={post.data.imageAlt || title}
                        class="w-full h-full object-cover"
                        width={image.width}
                        height={image.height}
                        loading="eager"
                        decoding="async"
                    />
                </div>
            )}

            <div class="prose prose-lg mx-auto prose-headings:font-display prose-headings:text-[#006064] prose-p:text-[#006064]/80 prose-a:text-[#006064] prose-strong:text-[#006064] prose-blockquote:border-l-[#006064]">
                {headings && headings.length > 0 && <TableOfContents headings={headings} lang={lang} />}
                <slot />
            </div>

            <div class="mt-12 pt-6 border-t font-mono text-xs uppercase flex gap-2">
                {post.data.tags.map((tag) => (
                   <span class="bg-gray-100 px-2 py-1">#{tag}</span>
                ))}
            </div>
          </article>

          <section class="bg-[#006064] text-white py-24 text-center px-6">
            <h2 class="font-display text-4xl mb-6">{blogCta.heading}</h2>
            <a
                href={blogCta.href}
                class="inline-block bg-white text-[#006064] px-8 py-4 text-lg font-bold border-2 border-transparent hover:bg-[#E0F7FA] transition-all uppercase tracking-wider"
            >
                {blogCta.button}
            </a>
            <a
                href={`/${lang}/#contacto`}
                class="ml-0 mt-4 inline-block px-6 py-3 text-sm font-bold uppercase tracking-widest underline underline-offset-4 hover:text-[#E0F7FA] sm:ml-4 sm:mt-0"
            >
                {blogCta.contact}
            </a>
          </section>
        </main>
    </div>
</BaseLayout>
