{
    "extends": "../../tsconfig.json",
    "compilerOptions": {
        "types": [
            "@cloudflare/workers-types",
            "node"
        ],
        "lib": [
            "ES2022",
            "WebWorker"
        ],
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "noEmit": true
    },
    "include": [
        "worker-configuration.d.ts",
        "src/**/*.ts",
        "../../src/env.d.ts",
        "../../src/lib/**/*.ts",
        "../../src/types/**/*.ts"
    ]
}
